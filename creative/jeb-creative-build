class Abort(Exception):
    """A condition that stops the run outright (tools tampered, the swap failed)."""


def now() -> str:
    return dt.datetime.now().strftime('%Y-%m-%d %H:%M:%S')


def printable(text: str) -> str:
    """Builder-controlled text for logs and the terminal: no control characters."""
    return ''.join(ch if 32 <= ord(ch) < 127 or ord(ch) >= 160 else '?' for ch in text)


def private(path: Path) -> None:
    os.chmod(path, 0o600)


def log(line: str) -> None:
    ROOT.mkdir(parents=True, exist_ok=True)
    line = printable(line)
    with LOG.open('a') as f:
        f.write(f'{now()} {line}\n')
    private(LOG)
    print(line)


def tool_env() -> dict[str, str]:
    # No CLAUDE_* from a calling session: under launchd there are none, and they
    # would load the user's mods into the builder or point it at the session.
    env = {k: v for k, v in os.environ.items() if not k.startswith('CLAUDE')}
    env['PATH'] = f"{HOME / '.local/bin'}:/opt/homebrew/bin:/usr/local/bin:{os.environ.get('PATH', '')}"
    return env


def run_split(args: list[str], cwd: Path, timeout: int) -> tuple[int, str, str]:
    try:
        p = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout, env=tool_env(), stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout or '', p.stderr or ''
    except subprocess.TimeoutExpired:
        return 124, '', 'timed out'
    except OSError as e:
        return 127, '', str(e)


def run(args: list[str], cwd: Path, timeout: int) -> tuple[int, str]:
    code, out, err = run_split(args, cwd, timeout)
    return code, out + err


def kill_group(pgid: int) -> None:
    try:
        os.killpg(pgid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except PermissionError as e:
        log(f'warning: could not kill the builder process group: {e!r}')


def run_builder(args: list[str], cwd: Path, timeout: int, out_path: Path) -> tuple[int, str]:
    """Run the builder in its own process group, then kill whatever it left behind.

    Output goes to `out_path` (0600) rather than a pipe, so a leftover child that
    holds the pipe open cannot keep the runner waiting.
    """
    fd = os.open(out_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as out:
        try:
            p = subprocess.Popen(args, cwd=cwd, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                 text=True, env=tool_env(), start_new_session=True)
        except OSError as e:
            return 127, str(e)
        try:
            code = p.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            code = 124
        finally:
            kill_group(p.pid)
            p.wait()
    private(out_path)
    return code, out_path.read_text(errors='ignore')


def walk(root: Path) -> Iterator[tuple[str, Path, os.stat_result]]:
    """Every entry under `root` (parents first), by lstat; never follows a link."""
    def visit(folder: Path, prefix: str) -> Iterator[tuple[str, Path, os.stat_result]]:
        for name in sorted(os.listdir(folder)):
            path = folder / name
            st = os.lstat(path)
            rel = f'{prefix}{name}'
            yield rel, path, st
            if stat.S_ISDIR(st.st_mode):
                yield from visit(path, rel + '/')
    yield from visit(root, '')


def is_types(rel: str) -> bool:
    return tuple(rel.split('/')[:2]) == TYPES_DIR


def shown(rel: str) -> str:
    return printable(rel)[:120]


def read_nofollow(path: Path, limit: int = 200_000) -> Optional[str]:
    """A regular, singly linked file's text, or None (links, FIFOs and the rest)."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    with os.fdopen(fd, 'rb') as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            return None
        return f.read(limit).decode('utf-8', errors='ignore')


def copy_file_nofollow(src: Path, dst: Path) -> None:
    fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            raise Abort(f'not a plain file: {shown(str(src))}')
        data = f.read()
    out = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with os.fdopen(out, 'wb') as f:
        f.write(data)


def copy_nofollow(src: Path, dst: Path) -> None:
    """Copy plain files and folders only, with normal modes; anything else aborts."""
    dst.mkdir(parents=True, mode=0o755)
    for rel, path, st in walk(src):
        target = dst / rel
        if stat.S_ISDIR(st.st_mode):
            target.mkdir(mode=0o755)
        elif stat.S_ISREG(st.st_mode):
            copy_file_nofollow(path, target)
        else:
            raise Abort(f'not a plain file: {shown(rel)}')


def file_digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open('rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def manifest(root: Path) -> dict[str, str]:
    """sha256 of every file under `root`; anything that is not a file or folder is marked."""
    out = {}
    for rel, path, st in walk(root):
        if stat.S_ISREG(st.st_mode):
            out[rel] = file_digest(path)
        elif not stat.S_ISDIR(st.st_mode):
            out[rel] = f'special:{st.st_mode:o}'
    return out


def tree_digest(root: Path) -> str:
    h = hashlib.sha256()
    for rel, path, st in walk(root):
        if stat.S_ISLNK(st.st_mode):
            h.update(f'L {rel} {os.readlink(path)}\n'.encode())
        elif stat.S_ISDIR(st.st_mode):
            h.update(f'D {rel}\n'.encode())
        else:
            h.update(f'F {rel} {file_digest(path)}\n'.encode())
    return h.hexdigest()


def ensure_tools() -> None:
    """Install the pinned TypeScript once, record its hash, and verify it."""
    if not TSC_JS.is_file():
        if TOOLS.exists():
            shutil.rmtree(TOOLS)
        TOOLS.mkdir(parents=True)
        code, out = run([str(NODE), str(NPM), 'install', '--prefix', str(TOOLS), '--ignore-scripts', '--no-audit',
                         '--no-fund', '--save-exact', f'typescript@{TS_VERSION}'], TOOLS, 600)
        if code != 0 or not TSC_JS.is_file():
            raise Abort(f'could not install typescript@{TS_VERSION}: {out.strip()[-300:]}')
        log(f'tools: installed typescript@{TS_VERSION} in {TOOLS}')
    if not TOOLS_SHA.exists():
        TOOLS_SHA.write_text(tree_digest(TOOLS) + '\n')
        log(f'tools: recorded {TOOLS_SHA}')
    verify_tools()


def verify_tools() -> None:
    recorded = TOOLS_SHA.read_text().strip() if TOOLS_SHA.exists() else ''
    if not recorded or tree_digest(TOOLS) != recorded:
        raise Abort(f'pinned TypeScript in {TOOLS} does not match {TOOLS_SHA}; delete both to re-pin')


def sandbox_settings(stage: Path) -> dict:
    """The builder's settings: no auto-memory (nothing may carry between builds
    outside the gate), and its sandbox: reads only staging and its tools, writes only staging
    (and $TMPDIR), no network, no unsandboxed retry. The sandbox wraps Bash and its
    children, which includes the art build: Python the builder may have edited."""
    allow_read = [stage, VENV, NODE_DIR, HOME / '.local/share/claude', HOME / '.local/bin', TOOLS]
    return {'autoMemoryEnabled': False, 'sandbox': {
        'enabled': True, 'failIfUnavailable': True, 'autoAllowBashIfSandboxed': False, 'allowUnsandboxedCommands': False,
        'filesystem': {'denyRead': ['~'], 'allowRead': [str(p) for p in allow_read]},
        'network': {'allowedDomains': [], 'strictAllowlist': True},
    }}


def builder_allowed() -> list[str]:
    # No path-wide file rules: reading and (under acceptEdits) editing are allowed
    # inside the staging folder only; anything outside asks, which -p refuses.
    # Bash rules are exact matches.
    return ['Bash(ls:*)', *(f"Bash({' '.join(c)})" for c in BUILDER_COMMANDS)]


def task_problem(text: str) -> Optional[str]:
    """Why `--task` text is not acceptable (empty, too long, or not plain printable text), else None."""
    if not text.strip():
        return 'the task is empty'
    if len(text) > TASK_MAX:
        return f'the task is {len(text)} characters; the limit is {TASK_MAX}'
    if not text.isprintable():
        return 'the task has control or unprintable characters'
    return None


def builder_prompt(task: str = '') -> str:
    """The builder's prompt: the standing one, plus the owner's one-off request after the brief when given."""
    if not task:
        return BUILDER_PROMPT
    return (f"{BUILDER_PROMPT}\n\n"
            "--- This run's request from the owner (after the brief) ---\n"
            f"{task}\n"
            "--- End of the owner's request ---")


def builder_args(stage: Path, prompt: str = BUILDER_PROMPT, model: str = BUILDER_MODEL, budget: str = BUDGET_USD) -> list[str]:
    return [
        CLAUDE, '-p', prompt,
        '--model', model, '--permission-mode', 'acceptEdits',
        '--setting-sources', 'project', '--strict-mcp-config', '--mcp-config', json.dumps({'mcpServers': {}}),
        '--settings', json.dumps(sandbox_settings(stage)),
        '--max-budget-usd', budget, '--no-session-persistence', '--output-format', 'stream-json', '--verbose',
        '--tools', BUILDER_TOOLS,
        '--disallowedTools', *DISALLOWED_TOOLS,
        '--allowedTools', *builder_allowed(),
    ]


def brief_text() -> str:
    """The brief with its `__HOME__` placeholder replaced by this user's home folder."""
    return BRIEF.read_text().replace('__HOME__', str(HOME))


def brief_mismatch() -> list[str]:
    """Builder commands the brief does not spell out exactly (they would be refused)."""
    text = brief_text()
    return [' '.join(c) for c in BUILDER_COMMANDS if f"`{' '.join(c)}`" not in text]


def source_text(root: Path) -> str:
    files = sorted([*(root / 'hooks').rglob('*.ts*'), *(root / 'types').rglob('*.ts*')])
    return '\n'.join(p.read_text(errors='ignore') for p in files)


def test_blocks(text: str) -> list[str]:
    """Top-level tests: from `test(` at column 0 to the next line that is exactly `})`."""
    return re.findall(r'^test\(.*?^\}\)$', text, re.M | re.S)


def test_name(block: str) -> Optional[str]:
    m = re.match(r"""test\((['"])((?:\\.|(?!\1).)*)\1""", block)
    return re.sub(r'\\(.)', r'\1', m.group(2)) if m else None


def test_count(root: Path) -> int:
    return sum(len(re.findall(r'^test\(', p.read_text(errors='ignore'), re.M)) for p in (root / 'tests').glob('*.test.ts*'))


def tree_size(root: Path) -> int:
    return sum(st.st_size for _, _, st in walk(root) if stat.S_ISREG(st.st_mode))


def copy_mod(dest: Path) -> None:
    if dest.exists():
        shutil.rmtree(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(MOD, dest, symlinks=False)


def take_creative(stage: Path) -> tuple[str, str]:
    """Read and remove the builder's summary and hint; returns (summary, hint).

    Only plain files are read or removed; anything else stays for the staging
    walk to reject.
    """
    texts = {}
    for name in CREATIVE_FILES:
        path = stage / name
        texts[name] = read_nofollow(path) or ''
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            continue
        if stat.S_ISREG(st.st_mode) and st.st_nlink == 1:
            path.unlink()
    return clean_summary(texts['.creative-summary.md']), clean_hint(texts['.creative-hint.txt'])


def unexpected_dot(parts: list[str]) -> bool:
    """Dot names allowed: `.claude-plugin/` itself, and anything under its
    `types/` (replaced from the live mod in the gate copy)."""
    for i, part in enumerate(parts):
        if not part.startswith('.'):
            continue
        if i == 0 and part == '.claude-plugin':
            continue
        if i >= 2 and tuple(parts[:2]) == TYPES_DIR:
            continue
        return True
    return False


def stage_problems(stage: Path) -> list[str]:
    """The lstat walk of staging: links, special files and unexpected dot names."""
    problems = []
    # The sandbox leaves an empty .claude/.cc-writes in its working folder.
    dot_claude = stage / '.claude'
    if os.path.lexists(dot_claude):
        writes = dot_claude / '.cc-writes'
        try:
            ok = (stat.S_ISDIR(os.lstat(dot_claude).st_mode) and os.listdir(dot_claude) == ['.cc-writes']
                  and stat.S_ISDIR(os.lstat(writes).st_mode) and os.listdir(writes) == [])
        except OSError:
            ok = False
        if not ok:
            return ['unexpected .claude/ in staging']
        writes.rmdir()
        dot_claude.rmdir()
    for rel, _, st in walk(stage):
        mode = st.st_mode
        if stat.S_ISLNK(mode):
            problems.append(f'symlink: {shown(rel)}')
        elif stat.S_ISREG(mode) and st.st_nlink > 1:
            problems.append(f'hardlink: {shown(rel)}')
        elif not stat.S_ISREG(mode) and not stat.S_ISDIR(mode):
            problems.append(f'special file: {shown(rel)}')
        if unexpected_dot(rel.split('/')):
            problems.append(f'unexpected dot name: {shown(rel)}')
        if len(problems) >= 10:
            break
    # Staging's `.claude-plugin/types/` is not compared: Claude Code rewrites the
    # live copy on its own (a session reload, an update), so a difference is not
    # an edit. Nothing of the builder's there is used: the gate copy always gets
    # the live mod's, and the sync never writes that folder.
    return problems


def make_gate_copy(stage: Path, dest: Path) -> None:
    """A fresh runner-owned copy of staging, with the live mod's engine types."""
    if dest.exists():
        shutil.rmtree(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    copy_nofollow(stage, dest)
    (dest / 'tsconfig.gate.json').unlink(missing_ok=True)
    types = dest.joinpath(*TYPES_DIR)
    if types.exists():
        shutil.rmtree(types)
    copy_nofollow(MOD.joinpath(*TYPES_DIR), types)


def allowlist_problems(root: Path) -> list[str]:
    bad = []
    for rel, _, st in walk(root):
        if stat.S_ISDIR(st.st_mode):
            continue
        if not stat.S_ISREG(st.st_mode) or not any(re.fullmatch(p, rel) for p in ALLOWED_FILES):
            bad.append(shown(rel))
    return [f"files not allowed: {', '.join(bad[:5])}{' ...' if len(bad) > 5 else ''}"] if bad else []


def pinned_changes(root: Path, news: Optional[bytes]) -> list[str]:
    changed = []
    for rel in PINNED_FILES:
        a, b = MOD / rel, root / rel
        want = news if rel == 'hooks/news.ts' and news is not None else (a.read_bytes() if a.exists() else None)
        if want != (b.read_bytes() if b.is_file() else None):
            changed.append(rel)
    for rel, pattern in PINNED_LINES:
        a, b = MOD / rel, root / rel
        old = [l for l in a.read_text(errors='ignore').splitlines() if re.search(pattern, l)] if a.exists() else []
        new = [l for l in b.read_text(errors='ignore').splitlines() if re.search(pattern, l)] if b.is_file() else []
        if not old or old != new:
            changed.append(f'{rel} ({pattern})')
    return changed


def test_problems(root: Path, require_change: bool) -> list[str]:
    """The safety tests stay as they are: every top-level test in a locked file
    must still be there, word for word. The story's own tests are the builder's
    to change or retire along with the parts of the world they cover."""
    problems = []
    for name in LOCKED_TESTS:
        live, mine = MOD / 'tests' / name, root / 'tests' / name
        if not live.is_file():
            continue
        if not mine.is_file():
            problems.append(f'safety test file removed: {name}')
            continue
        text = mine.read_text(errors='ignore')
        changed = [b for b in test_blocks(live.read_text(errors='ignore')) if b not in text]
        if changed:
            problems.append(f'{len(changed)} safety test(s) changed in {name}: {shown(test_name(changed[0]) or "?")[:80]}')
    return problems


def split_items(text: str) -> list[str]:
    """`a, b (via x, y), c{k=v}` -> items, splitting only on top-level commas."""
    items, depth, cur = [], 0, ''
    for ch in text:
        depth += (ch in '({[') - (ch in ')}]')
        if ch == ',' and depth == 0:
            items.append(cur)
            cur = ''
        else:
            cur += ch
    items.append(cur)
    return [i.strip() for i in items if i.strip()]


def structure(root: Path) -> tuple[dict[str, set[str]], list[str]]:
    """`claude plugin validate --json`: (category -> items, errors)."""
    code, out, err = run_split([CLAUDE, 'plugin', 'validate', '--json', '.'], root, 300)
    try:
        report = json.loads(out)
    except ValueError:
        return {}, [f'validate gave no report (exit {code}): {shown(err.strip()[-200:])}']
    errors = [] if report.get('success') is True else ['validate failed']
    parts = [report.get('manifest') or {}, *(report.get('contents') or [])]
    cats: dict[str, set[str]] = {}
    for part in parts:
        for e in part.get('errors') or []:
            message = e.get('message', str(e)) if isinstance(e, dict) else str(e)
            errors.append(f"validate error: {shown(message.replace(str(root), '.'))[:200]}")
        for note in part.get('notes') or []:
            text = note.get('message', '') if isinstance(note, dict) else str(note)
            m = re.match(r'^(\S+) (.+?): (.*)$', text)
            if not m:
                continue
            body = re.sub(r'\s*\(via [^)]*\)', '', m.group(3)).strip()
            items = set() if re.match(r'^nothing\b', body) else set(split_items(body))
            cats.setdefault(m.group(2), set()).update(items)
    return cats, errors


def structure_problems(root: Path) -> list[str]:
    new, errors = structure(root)
    if errors:
        return errors
    old, old_errors = structure(MOD)
    if old_errors:
        return [f'live mod does not validate: {old_errors[0]}']
    problems = []
    for cat, items in sorted(new.items()):
        added = items - old.get(cat, set())
        if not added:
            continue
        guarded = cat in GUARDED or cat.endswith('declares on $') or (cat not in old and cat not in OPEN_CATEGORIES)
        if guarded:
            problems.append(f"new {shown(cat)}: {shown(', '.join(sorted(added)))[:200]}")
    return problems


def tsc_problems(root: Path) -> list[str]:
    verify_tools()
    (root / 'tsconfig.gate.json').write_text(json.dumps(GATE_TSCONFIG))
    code, out = run(TSC_CMD, root, 300)
    (root / 'tsconfig.gate.json').unlink(missing_ok=True)
    return [] if code == 0 else [f'tsc failed: {shown(out.strip()[:300])}']


# Claude Code 2.1.309/2.1.310's test kit sometimes kills a whole test file as
# "passed 600000 ms" when its tests advance the mocked clock by hours, though the
# run took seconds of real time (a race in the kit's watchdog). Only a pass whose
# every failure is that kill is run again; any real test failure still rejects.
KIT_FLAKE_RETRIES = 4
KIT_FLAKE = 'it did not finish: its run passed 600000 ms and was killed'


def is_kit_flake(out: str) -> bool:
    fails = re.findall(r'^\(fail\) (.*)$', out, re.M)
    return bool(fails) and all(f.startswith('the file did not load') for f in fails) and out.count(KIT_FLAKE) == len(fails)


def suite_problems(root: Path) -> list[str]:
    """The suite twice with 0 failures, and every locked safety test reported passing."""
    names = {n for p in (MOD / 'tests' / f for f in LOCKED_TESTS) if p.is_file() for b in test_blocks(p.read_text(errors='ignore'))
             for n in [test_name(b)] if n and '${' not in n}
    for i in (1, 2):
        for attempt in range(KIT_FLAKE_RETRIES + 1):
            code, out = run(TEST_CMD, root, TEST_TIMEOUT)
            if not is_kit_flake(out) or attempt == KIT_FLAKE_RETRIES:
                break
            log(f'tests run {i}: the test kit killed a file on mocked time; running it again')
        failed = re.search(r'(\d+) fail', out)
        if code != 0 or not re.search(r'(\d+) pass', out) or not failed or int(failed.group(1)) != 0:
            fails = '; '.join(re.findall(r'^\(fail\) (.{1,80})', out, re.M)[:5])
            return [f'tests run {i} failed ({failed.group(1) if failed else "?"} fail){": " + shown(fails) if fails else ""}']
        passed = set(re.findall(r'^\(pass\) (.*?)(?: \[[\d.]+m?s\])?$', out, re.M))
        missing = sorted(n for n in names if n not in passed)
        if missing:
            return [f'tests run {i}: {len(missing)} existing test(s) did not pass: {shown(missing[0])[:80]}']
    return []


def gate(root: Path, require_change: bool, news: Optional[bytes] = None) -> list[str]:
    """Every reason the gate copy may not go in; empty means it passes.

    The cheap checks run first; tsc and the suite run only when they are clean.
    `news` pins hooks/news.ts to what the runner just wrote instead of the live file.
    """
    problems = allowlist_problems(root)
    problems += [f'pinned code changed: {name}' for name in pinned_changes(root, news)]
    problems += test_problems(root, require_change)
    problems += structure_problems(root)
    staged, current = source_text(root), source_text(MOD)
    for pattern in FORBIDDEN:
        if re.search(pattern, staged):
            problems.append(f'forbidden pattern: {pattern}')
    for name, pattern in COUNTED.items():
        if len(re.findall(pattern, staged)) > len(re.findall(pattern, current)):
            problems.append(f'new {name}')
    hooks_now = sum(p.stat().st_size for p in (MOD / 'hooks').glob('*'))
    hooks_new = sum(p.stat().st_size for p in (root / 'hooks').glob('*'))
    if hooks_new > hooks_now + 400_000:
        problems.append('hooks grew by more than 400 KB')
    if tree_size(root) > 50_000_000:
        problems.append('mod larger than 50 MB')
    if require_change and news is None and staged == current and test_count(root) == test_count(MOD):
        problems.append('nothing changed')
    if problems:
        return problems
    return tsc_problems(root) or suite_problems(root)


def gate_staging(stage: Path, dest: Path, require_change: bool) -> list[str]:
    """First pass: walk staging, copy it to `dest`, gate the copy."""
    problems = stage_problems(stage)
    if problems:
        return problems
    try:
        make_gate_copy(stage, dest)
    except (Abort, OSError) as e:
        return [f'could not copy staging: {shown(str(e))[:200]}']
    before = manifest(dest)
    problems = gate(dest, require_change)
    if not problems and manifest(dest) != before:
        problems.append('the gate copy changed while it was gated')
    return problems


def gate_with_news(dest: Path, build_id: str, hint: str, require_change: bool = True) -> tuple[list[str], dict[str, str]]:
    """Second pass: write the news into the gate copy and gate it all again.

    Returns the problems and the manifest the swap must still match.
    """
    news = write_news(dest, build_id, hint)
    before = manifest(dest)
    problems = gate(dest, require_change, news=news)
    if not problems and manifest(dest) != before:
        problems.append('the gate copy changed while it was gated')
    return problems, before


def check_build(stage: Path, dest: Path, require_change: bool, build_id: str, hint: str) -> tuple[list[str], dict[str, str]]:
    """Both gate passes, as the build runs them (no swap)."""
    problems = gate_staging(stage, dest, require_change)
    if problems:
        return problems, {}
    return gate_with_news(dest, build_id, hint, require_change)


def clean_hint(text: str) -> str:
    first = text.strip().splitlines()[0] if text.strip() else ''
    hint = ''.join(ch for ch in first if 32 <= ord(ch) < 127)
    return hint[:80] or 'Been tinkering around the place. Keep your eyes peeled.'


def clean_summary(text: str) -> str:
    kept = ''.join(ch for ch in text if ch == '\n' or 32 <= ord(ch) < 127)
    return kept.strip()[:SUMMARY_MAX].strip()


def write_news(root: Path, build_id: str, hint: str) -> bytes:
    line = hint.replace('\\', '\\\\').replace("'", "\\'")
    data = (
        '// Written by creative/jeb-creative-build after a creative build.\n'
        f"export const JEB_NEWS: {{ id: string; line: string }} | null = {{ id: '{build_id}', line: '{line}' }}\n"
    ).encode()
    (root / 'hooks/news.ts').write_bytes(data)
    return data


def backup_current(build_id: str) -> Path:
    dest = BACKUPS / build_id / 'jeb'
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(MOD, dest, symlinks=True)
    olds = sorted(p for p in BACKUPS.iterdir() if p.is_dir())
    for old in olds[:-KEEP_BACKUPS]:
        shutil.rmtree(old, ignore_errors=True)
    return dest


def sync_into_mod(src: Path) -> None:
    """Make the mod folder match `src`, in place, never touching `.claude-plugin/types/`.

    The folder itself is never renamed: sessions watch it (CLAUDE_CODE_PLUGIN_DIRS)
    and reload once a quick run of saves stops. Each changed file is written to a
    temporary name and renamed over the old one, so no reader sees half a file.
    """
    for rel, path, st in walk(src):
        if is_types(rel):
            continue
        dst = MOD / rel
        if stat.S_ISDIR(st.st_mode):
            if os.path.lexists(dst) and not stat.S_ISDIR(os.lstat(dst).st_mode):
                dst.unlink()
            dst.mkdir(exist_ok=True)
        elif stat.S_ISREG(st.st_mode):
            if os.path.lexists(dst) and stat.S_ISREG(os.lstat(dst).st_mode) and dst.read_bytes() == path.read_bytes():
                continue
            if os.path.lexists(dst) and stat.S_ISDIR(os.lstat(dst).st_mode):
                shutil.rmtree(dst)
            tmp = dst.with_name(dst.name + '.swap-tmp')
            shutil.copy2(path, tmp, follow_symlinks=False)
            os.replace(tmp, dst)
        else:
            raise Abort(f'not a plain file: {shown(rel)}')
    for rel, dst, st in reversed(list(walk(MOD))):
        if is_types(rel) or os.path.lexists(src / rel):
            continue
        shutil.rmtree(dst) if stat.S_ISDIR(st.st_mode) else dst.unlink()


def build(task: str = '') -> int:
    if not BRIEF.exists() or not MOD.exists():
        log('skip: brief or mod missing')
        return 1
    missing = brief_mismatch()
    if missing:
        log('skip: the brief does not list these builder commands exactly: ' + '; '.join(missing))
        return 1
    ensure_tools()
    build_id = dt.datetime.now().strftime('%Y%m%d-%H%M%S')
    log(f'build {build_id}: staging' + (f' (owner task given: {len(task)} chars, sha256 {hashlib.sha256(task.encode()).hexdigest()[:8]})' if task else ''))
    copy_mod(STAGE)
    (STAGE / '.creative-brief.md').write_text(brief_text())
    (STAGE / '.creative-changelog.md').write_text(CHANGELOG.read_text() if CHANGELOG.exists() else '(no builds yet)\n')
    (STAGE / 'tsconfig.gate.json').write_text(json.dumps(GATE_TSCONFIG))  # the gate writes its own
    # The builder's own output, for diagnosing a run (kept private, last 20).
    runs = ROOT / 'runs'
    runs.mkdir(exist_ok=True)
    out_path = runs / f'{build_id}.log'
    code, out = run_builder(builder_args(STAGE, builder_prompt(task)), STAGE, BUILD_TIMEOUT, out_path)
    log(f'build {build_id}: builder exited {code}')
    if len(out) > 200_000:
        out_path.write_text(out[-200_000:])
        private(out_path)
    for old in sorted(runs.glob('*.log'))[:-20]:
        old.unlink(missing_ok=True)
    for kept in [*runs.glob('*.log'), *([CHANGELOG] if CHANGELOG.exists() else [])]:
        private(kept)  # files from before the 0600 rule too
    summary, hint = take_creative(STAGE)
    problems, gated = check_build(STAGE, GATE_COPY, True, build_id, hint)
    shutil.rmtree(STAGE, ignore_errors=True)
    if problems:
        log(f'build {build_id}: rejected: ' + '; '.join(problems))
        shutil.rmtree(GATE_COPY, ignore_errors=True)
        return 2
    if manifest(GATE_COPY) != gated:
        log(f'build {build_id}: rejected: the gate copy changed after the gate')
        shutil.rmtree(GATE_COPY, ignore_errors=True)
        return 2
    backup = backup_current(build_id)
    try:
        sync_into_mod(GATE_COPY)
    except Exception as e:
        log(f'build {build_id}: swap failed ({e!r}); restoring {backup}')
        sync_into_mod(backup)
        log(f'build {build_id}: restored the mod from {backup}')
        return 1
    shutil.rmtree(GATE_COPY, ignore_errors=True)
    with CHANGELOG.open('a') as f:
        f.write(f'\n## {build_id}\n{summary or "(no summary)"}\n')
    private(CHANGELOG)
    log(f'build {build_id}: swapped in (backup {backup})')
    return 0


def dry_run() -> int:
    missing = brief_mismatch()
    if missing:
        log('dry run: the brief does not list these builder commands exactly: ' + '; '.join(missing))
        return 2
    ensure_tools()
    stage = STAGING / 'dry'
    copy_mod(stage)
    problems = gate_staging(stage, GATE_COPY, require_change=False)
    shutil.rmtree(stage, ignore_errors=True)
    shutil.rmtree(GATE_COPY, ignore_errors=True)
    log('dry run: ' + ('passes every gate' if not problems else 'would reject: ' + '; '.join(problems)))
    return 0 if not problems else 2


def rollback() -> int:
    olds = sorted(p for p in BACKUPS.iterdir() if p.is_dir()) if BACKUPS.exists() else []
    if not olds:
        log('rollback: no backups')
        return 1
    latest = olds[-1]
    sync_into_mod(latest / 'jeb')
    shutil.rmtree(latest, ignore_errors=True)
    log(f'rollback: restored {latest.name}')
    return 0


def status() -> int:
    print(LOG.read_text()[-3000:] if LOG.exists() else 'no runs yet')
    print('backups:', ', '.join(p.name for p in sorted(BACKUPS.iterdir())) if BACKUPS.exists() else 'none')
    return 0


def main() -> int:
    ROOT.mkdir(parents=True, exist_ok=True)
    with LOCK.open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print('another run is in progress')
            return 3
        args = sys.argv[1:]
        task = ''
        if args[:1] == ['--task']:
            problem = task_problem(args[1]) if len(args) == 2 else 'usage: --task TEXT'
            if problem:
                print(f'--task: {problem}')
                return 2
            task = args[1]
            args = []
        arg = args[0] if args else ''
        try:
            if task:
                return build(task)
            return {'--dry-run': dry_run, '--rollback': rollback, '--status': status}.get(arg, build)()
        except Abort as e:
            log(f'aborted: {e}')
            return 1
        except Exception as e:
            log(f'error: {e!r}')
            return 1


if __name__ == '__main__':
    sys.exit(main())
