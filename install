#!/usr/bin/python3
"""./install [--dev] [--repin] [--add-path] [--build-from-source] [--no-agents] [--dry-run] [--verbose]: set Jeb up from this clone or bundle.

  release bundle:         the README's way. The signed Jeb-<tag>-macos-<arch>.zip is unpacked into ~/.jeb/versions/<tag>, and its own
                          Python runs `python/bin/python3 -I install` there. No git, Xcode or Command Line Tools: the app is prebuilt.
                          ~/.jeb/current is pointed at the bundle; the LaunchAgents, the plugin entry and the jebctl link use only that
                          path. --dev and --build-from-source are refused. Updates download the next bundle and switch `current`.

  release mode (default): the clone follows release tags signed by a pinned signer (the clone is moved to the newest
                          verified tag; a 6-hourly agent fetches new ones, verifies, gates them and switches). No local
                          edits expected.
                          Updates only follow tags signed by a pinned signer: desktop/release-signers is copied to
                          ~/Library/Application Support/Jeb/release-signers on the first install and never replaced by a later tag.
  --repin                 replace the pinned signers with this clone's desktop/release-signers (key rotation).
  --add-path              add ~/.local/bin (where `jebctl` is linked) to the shell profile (zsh ~/.zprofile, bash
                          ~/.bash_profile, else ~/.profile; backup first). The PATH is optional: without it one line says
                          to run ~/.local/bin/jebctl.
  --build-from-source     release mode only: compile the app when no verified prebuilt one can be downloaded (or JEB_ALLOW_BUILD=1).
                          By default release mode never compiles: it downloads the release's app over HTTPS and stops with a plain reason when the prebuilt app cannot be had.
  --dev                   owner mode: runs from the working tree; local src edits ship through the update gates (compiles; needs
                          swiftc from the Command Line Tools).
  --verbose               every command and detail; by default one short line per step.

  --no-agents             sandbox only (./release smoke): no LaunchAgents, launchctl or jebctl link; needs a HOME other than the real one.
A git clone (developers) still installs the old way and converts to a bundle on its first release-mode follow.
Preflight (git clone, release mode): macOS, /usr/bin/python3 and git (DEVELOPER_DIR points at the Command Line Tools only when the
selected Xcode fails, e.g. its license was never accepted); claude missing is only a note.
Steps: preflight, `desktop/jebctl install` (first build through the gates, LaunchAgents, start), then the mod registered through Claude
Code's plugin system (`claude plugin marketplace add` + `claude plugin install jeb@jeb`; options and the farm carry over from the old
jeb@inline id, and Jeb's own CLAUDE_CODE_PLUGIN_DIRS entry is removed from ~/.claude/settings.json, backup first). --dev keeps the
CLAUDE_CODE_PLUGIN_DIRS entry (hot reload). --dry-run changes nothing.
Env overrides (tests): JEB_HOME, JEB_APP_DIR, JEB_LAUNCHAGENTS, JEB_SETTINGS, JEB_BACKUPS, JEB_STORE_DIR, JEB_BIN_DIR, JEB_PROFILE, JEB_TOOLS_DIR, JEB_NO_LAUNCHCTL.
"""
import json, os, shutil, subprocess, sys

CLONE = os.path.dirname(os.path.realpath(__file__))
MOD = os.path.join(CLONE, "mod")
BUNDLED = os.path.isfile(os.path.join(CLONE, "bundle.json"))        # unpacked release bundle, not a git clone
sys.path.insert(0, os.path.join(CLONE, "desktop"))
import jebhome, plugdirs

jebhome.pin_python()

jebhome.use_dev_dir()       # before anything runs git or xcrun: fall back to the Command Line Tools if Xcode's license blocks
VERBOSE = False


def say(*a):
    print(*a, flush=True)


def fail(msg):
    raise SystemExit("install: " + msg)


def git(*a):
    return subprocess.run(["git", "-C", CLONE] + list(a), capture_output=True, text=True)


def preflight(compile_ok):
    """Fails with a plain reason; returns notes (not failures). compile_ok: dev or --build-from-source, which need swiftc."""
    if sys.platform != "darwin":
        fail("macOS only")
    if BUNDLED:
        if not os.path.isdir(MOD):
            fail(f"{MOD} not found; the bundle is incomplete")
        return [] if jebhome.find_claude() else ["Claude Code was not found on this Mac; Jeb installs anyway, but it needs Claude Code to show up in sessions"]
    if not os.access("/usr/bin/python3", os.X_OK):
        fail("Python is missing from this Mac; the Command Line Tools are missing; ask Claude to repair Jeb")
    if subprocess.run(["git", "--version"], capture_output=True).returncode != 0:
        fail("git does not work here; the Command Line Tools are missing; ask Claude to repair Jeb")
    if compile_ok and subprocess.run(["xcrun", "--find", "swiftc"], capture_output=True).returncode != 0:
        fail("swiftc was not found (needed to build from source); the Command Line Tools are missing; ask Claude to repair Jeb")
    if not os.path.isdir(MOD):
        fail(f"{MOD} not found; run ./install from a full clone")
    notes = [] if jebhome.find_claude() else ["Claude Code was not found on this Mac; Jeb installs anyway, but it needs Claude Code to show up in sessions"]
    if VERBOSE:
        say("preflight ok: macOS, /usr/bin/python3, git" + (", swiftc" if compile_ok else ""))
    return notes


def load_rstate():
    try:
        return json.load(open(os.path.join(jebhome.resolve(), "release-state.json")))
    except (OSError, ValueError):
        return {}


def clone_check():
    """Release mode: a clean git clone. Moving to a verified release tag is `jebctl install`'s job, after the signers are pinned."""
    if git("rev-parse", "--git-dir").returncode != 0:
        fail("release mode needs a git clone (git clone <repo> && ./install); use --dev for a plain folder")
    if git("status", "--porcelain", "-uno").stdout.strip():
        fail("the clone has local changes, so it could not follow releases; commit or stash them, or use --dev")


def main(argv):
    global VERBOSE
    dry = "--dry-run" in argv
    VERBOSE = "--verbose" in argv
    dev = "--dev" in argv
    repin = "--repin" in argv
    addp = "--add-path" in argv
    build = "--build-from-source" in argv
    noag = "--no-agents" in argv
    bad = [a for a in argv if a not in ("--dry-run", "--dev", "--repin", "--add-path", "--build-from-source", "--no-agents", "--verbose")]
    if bad:
        say(__doc__); return 2
    if BUNDLED and (dev or build):
        fail("a release bundle has no source to build: --dev and --build-from-source are for a git clone")
    if VERBOSE:
        say(f"Jeb install ({'dev' if dev else 'release'} mode{', dry run' if dry else ''}) from {CLONE}")
    else:
        say(f"Installing Jeb ({'dev' if dev else 'release'} mode{', dry run' if dry else ''})")
        print("  checks ...", end=" ", flush=True)
    try:
        notes = preflight(dev or build or os.environ.get("JEB_ALLOW_BUILD") == "1")
        if not dev and not BUNDLED:
            clone_check()
    except SystemExit:
        if not VERBOSE:
            say("failed")
        raise
    if not VERBOSE:
        say("ok")
    for n in notes:
        say("note: " + n)
    cmd = [sys.executable if BUNDLED else "/usr/bin/python3", "-I", os.path.join(CLONE, "desktop", "jebctl"), "install", "--mode", "dev" if dev else "release"] + (["--no-agents"] if noag else []) + (["--repin"] if repin and not dev else []) + (["--add-path"] if addp else []) + (["--build-from-source"] if build and not dev else []) + (["--dry-run"] if dry else []) + (["--verbose"] if VERBOSE else [])
    if VERBOSE:
        say("$ " + " ".join(cmd))
    rc = subprocess.run(cmd).returncode     # inherits DEVELOPER_DIR (set above)
    if rc != 0:
        return rc       # settings untouched when a gate fails
    if not VERBOSE:
        print("  Claude Code plugin ...", end=" ", flush=True)
    quiet = say if VERBOSE else (lambda *a: None)
    msgs = []
    if dev:
        act = plugdirs.edit(MOD, False, dry, quiet)         # a dev clone keeps loading through CLAUDE_CODE_PLUGIN_DIRS (hot reload)
        res = "would add" if dry and act in ("set", "append") else "ok"
    else:
        old = (load_rstate().get("legacy_mod") or "") if BUNDLED else MOD       # a git clone's entry from before this bundle
        res = plugdirs.register(jebhome.current_dir() if BUNDLED else CLONE, dry, say if VERBOSE else msgs.append, [old])
        if res != "ok":
            if not VERBOSE:
                say("not registered")
                for m in msgs:
                    say("  " + m)
            say({"no-claude": "note: Claude Code is not installed, so Jeb is not registered yet; run ./install again after installing it",
                 "conflict": 'note: a Claude Code marketplace named "jeb" already points elsewhere; Jeb was left as it was (run jebctl doctor)',
                 "failed": "note: Claude Code refused the plugin install; Jeb was left as it was (run ./install again, or jebctl doctor)"}[res])
            res = None
    if not VERBOSE and res:
        say(res)
    for m in msgs:
        if m.startswith("moved"):
            say("  " + m)
    if dry and not VERBOSE:
        say("Dry run only; nothing was changed.")
    if dry:
        return 0
    if not noag:        # a sandbox has no agents loaded; ./release smoke runs the doctor itself
        say("Health check (jebctl doctor):")
        subprocess.run(cmd[:3] + ["doctor"])        # same interpreter and jebctl as the install; its result does not fail the install
    say("Done. Start a new Claude Code session to load Jeb; the desktop fills in once a session has run.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
