#!/usr/bin/python3
"""./install [--dev] [--repin] [--add-path] [--dry-run] [--verbose]: set Jeb up from this clone.

  release mode (default): the clone follows release tags signed by a pinned signer (the clone is moved to the newest
                          verified tag; a 6-hourly agent fetches new ones, verifies, gates them and switches). No local
                          edits expected.
                          Updates only follow tags signed by a pinned signer: desktop/release-signers is copied to
                          ~/.claude/jeb-desktop/release-signers on the first install and never replaced by a later tag.
  --repin                 replace the pinned signers with this clone's desktop/release-signers (key rotation).
  --add-path              if ~/.local/bin (where `jebctl` is linked) is not on PATH, add it to the shell profile without
                          asking (zsh ~/.zprofile, bash ~/.bash_profile, else ~/.profile; backup first). Without it a
                          terminal asks; otherwise the line to add is printed.
  --dev                   owner mode: runs from the working tree; local src edits ship through the update gates.
  --verbose               every command and detail; by default one short line per step.

Steps: preflight, `desktop/jebctl install` (first build through the gates, LaunchAgents, start), then the mod folder
added to CLAUDE_CODE_PLUGIN_DIRS in ~/.claude/settings.json (backup first). --dry-run changes nothing.
Env overrides (tests): JEB_HOME, JEB_APP_DIR, JEB_LAUNCHAGENTS, JEB_SETTINGS, JEB_BACKUPS, JEB_BIN_DIR, JEB_PROFILE.
"""
import os, shutil, subprocess, sys

CLONE = os.path.dirname(os.path.abspath(__file__))
MOD = os.path.join(CLONE, "mod")
sys.path.insert(0, os.path.join(CLONE, "desktop"))
import plugdirs



VERBOSE = False


def say(*a):
    print(*a, flush=True)


def fail(msg):
    raise SystemExit("install: " + msg)


def git(*a):
    return subprocess.run(["git", "-C", CLONE] + list(a), capture_output=True, text=True)


def preflight():
    if sys.platform != "darwin":
        fail("macOS only")
    if subprocess.run(["xcode-select", "-p"], capture_output=True).returncode != 0:
        fail("the Xcode Command Line Tools are missing; run `xcode-select --install`, then run ./install again")
    if subprocess.run(["xcrun", "--find", "swiftc"], capture_output=True).returncode != 0:
        fail("swiftc was not found; run `xcode-select --install` (or install Xcode), then run ./install again")
    if not os.access("/usr/bin/python3", os.X_OK):
        fail("/usr/bin/python3 is missing (it comes with the Command Line Tools)")
    if not shutil.which("claude"):
        fail("`claude` is not on PATH; install Claude Code first")
    if not os.path.isdir(MOD):
        fail(f"{MOD} not found; run ./install from a full clone")
    if VERBOSE:
        say("preflight ok: macOS, Command Line Tools, swiftc, /usr/bin/python3, claude")


def clone_check():
    """Release mode: a clean git clone. Moving to a verified release tag is `jebctl install`'s job, after the signers are pinned."""
    if git("rev-parse", "--git-dir").returncode != 0:
        fail("release mode needs a git clone (git clone <repo> && ./install); use --dev for a plain folder")
    if git("status", "--porcelain", "-uno").stdout.strip():
        fail("the clone has local changes, so it could not follow releases; commit or stash them, or use --dev")


def main(argv):
    global VERBOSE
    dry = "--dry-run" in argv
    VERBOSE = "--verbose" in argv
    dev = "--dev" in argv
    repin = "--repin" in argv
    addp = "--add-path" in argv
    bad = [a for a in argv if a not in ("--dry-run", "--dev", "--repin", "--add-path", "--verbose")]
    if bad:
        say(__doc__); return 2
    if VERBOSE:
        say(f"Jeb install ({'dev' if dev else 'release'} mode{', dry run' if dry else ''}) from {CLONE}")
    else:
        say(f"Installing Jeb ({'dev' if dev else 'release'} mode{', dry run' if dry else ''})")
        print("  checks ...", end=" ", flush=True)
    try:
        preflight()
        if not dev:
            clone_check()
    except SystemExit:
        if not VERBOSE:
            say("failed")
        raise
    if not VERBOSE:
        say("ok")
    cmd = ["/usr/bin/python3", "-I", os.path.join(CLONE, "desktop", "jebctl"), "install", "--mode", "dev" if dev else "release"] + (["--repin"] if repin and not dev else []) + (["--add-path"] if addp else []) + (["--dry-run"] if dry else []) + (["--verbose"] if VERBOSE else [])
    if VERBOSE:
        say("$ " + " ".join(cmd))
    rc = subprocess.run(cmd).returncode
    if rc != 0:
        return rc       # settings untouched when a gate fails
    if not VERBOSE:
        print("  Claude Code plugin ...", end=" ", flush=True)
    act = plugdirs.edit(MOD, False, dry, say if VERBOSE else lambda *a: None)
    if not VERBOSE:
        say("would add" if dry and act in ("set", "append") else "ok")
        say("Dry run only; nothing was changed." if dry else "Done. Start a new Claude Code session to load Jeb.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
