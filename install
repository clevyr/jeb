#!/bin/sh
# The repo-root install (v1.7.0 onwards). In a release bundle it runs the bundle's own jebctl; in a source checkout there is
# no jebctl to run.
here=$(dirname "$0")
if [ -x "$here/desktop/bin/jebctl" ]; then
  exec "$here/desktop/bin/jebctl" install "$@"
fi
echo "install: this is a source checkout, not a release bundle; install a release instead (see README.md); CONTRIBUTING.md covers building from source" >&2
exit 1
