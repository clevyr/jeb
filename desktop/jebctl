def same_dir(a, b):
    try:
        return os.path.samefile(a, b)
    except OSError:
        return False


def scrubbed_env():
    """The environment for a child that outlives follow: no pointer at follow's staging copy."""
    return {k: v for k, v in os.environ.items() if k not in ("JEB_MOD", "JEB_SRC", "JEB_BUNDLE_MOD")}


