    """Release install: fetch tags, then move the clone to the newest tag that verify_tag accepts (rejects are recorded
    as failed, like follow). Returns the cloned commit's SHA when it moved (to go back to if the first build fails),
    else None: no pinned signer or no verified tag leaves the clone on the cloned commit (cmd_install then detaches it
    from its branch, so follow can move it once a verified tag appears)."""
    if DRY and not os.path.isfile(SIGNERS) and os.path.isfile(REPO_SIGNERS):
        detail("release: would fetch tags, verify them against the signers just pinned (newest first), then `git checkout --detach <sha>` of the newest verified one; with none it stays on the cloned commit")
        return None
    if not os.path.isfile(SIGNERS):
        say("release: no pinned signers, so no tag is trusted; staying on the cloned commit (updates stay off until a signer is pinned)")
        return None
    if git("rev-parse", "--git-dir").returncode != 0:
        raise SystemExit("release mode needs a git clone; use --mode dev for a plain folder")
    if git("status", "--porcelain", "-uno").stdout.strip():
        raise SystemExit("the clone has local changes, so it could not move to a release; commit or stash them, or use --mode dev")
    if DRY:
        detail("$ git fetch --tags origin")
    else:
        r = git("fetch", "--tags", "origin", timeout=180)
        if r.returncode != 0:
            say(f"warning: could not fetch tags from origin ({r.stderr.strip()[:200]}); using the tags already here")
    base, rs = base_branch(), load_rstate()
    here = git("rev-parse", "HEAD").stdout.strip()
    for t in reversed(release_tags()):
        if t in rs.get("failed", []):
            continue
        sha, why = verify_tag(t, base)
        if why:
            rlog(f"install: {t} rejected: {why}; it will not be retried")
            rs.setdefault("failed", []).append(t)
            save_rstate(rs)
            continue
        if sha == here:
            detail(f"clone is on {t} ({sha[:12]}), verified")
            return None
        detail(f"$ git checkout --detach {sha}   ({t}, signed by a pinned signer, on origin/{base})")
        if DRY:
            return None
        r = git("checkout", "--detach", sha)
        if r.returncode != 0:
            raise SystemExit("git checkout failed: " + r.stderr.strip())
        return here
    say("release: no verified release tag; staying on the cloned commit, detached (updates start once a verified tag appears)")
    return None


# ---- jebctl on PATH ----

ME = os.path.join(LIVE, "desktop", "bin", "jebctl") if BUNDLE else os.path.join(CODE, "jebctl")      # a bundle links the stable ~/.jeb/current path; CODE is already a realpath
PATH_MARK = "# added by Jeb's ./install"


def bin_dir():
    return os.environ.get("JEB_BIN_DIR") or os.path.expanduser("~/.local/bin")


def link_path():
    return os.path.join(bin_dir(), "jebctl")


def is_me(path):
    """Same file as this jebctl (samefile: the clone may be reached as ~/Projects or ~/projects)."""
    try:
        return os.path.samefile(path, ME)
    except OSError:
        return False


def link_state(target=None):
    """none | ours | older (a link to another Jeb clone's or bundle's desktop/jebctl) | foreign (anything else: leave it)."""
    p, target = link_path(), target or ME
    if not os.path.lexists(p):
        return "none"
    if not os.path.islink(p):
        return "foreign"
    r = os.path.realpath(p)
    if os.path.realpath(target) == r or (target is ME and is_me(p)):
        return "ours"
    d = os.path.basename(os.path.dirname(r))
    up = os.path.basename(os.path.dirname(os.path.dirname(r)))
    return "older" if os.path.basename(r) == "jebctl" and (d == "desktop" or (d == "bin" and up == "desktop")) else "foreign"


def link_jebctl(target=None):
    """Link ~/.local/bin/jebctl to this jebctl (or target). True when it is (or, in a dry run, would be) ours."""
    p, st = link_path(), link_state(target)
    target = target or ME
    if st == "ours":
        detail(f"{p} already points here")
        return True
    if st == "foreign":
        say(f"warning: {p} exists and is not a link to a Jeb jebctl; left alone, so `jebctl` is not set up (run {ME})")
        return False
    detail(f"link {p} -> {target}" + (f" (replaces the link to {os.path.realpath(p)})" if st == "older" else ""))
    if not DRY:
        os.makedirs(bin_dir(), mode=0o755, exist_ok=True)
        tmp = p + ".tmp"
        if os.path.lexists(tmp):
            os.unlink(tmp)
        os.symlink(target, tmp)
        os.replace(tmp, p)
    return True


def on_path(d):
    want = os.path.realpath(d)
    return any(e and os.path.realpath(os.path.expanduser(e)) == want for e in os.environ.get("PATH", "").split(os.pathsep))


def profile_path():
    if os.environ.get("JEB_PROFILE"):
        return os.environ["JEB_PROFILE"]
    sh_ = os.path.basename(os.environ.get("SHELL", ""))
    return os.path.expanduser({"zsh": "~/.zprofile", "bash": "~/.bash_profile"}.get(sh_, "~/.profile"))


def export_line():
    d = bin_dir()
    return 'export PATH="$HOME/.local/bin:$PATH"' if d == os.path.expanduser("~/.local/bin") else f'export PATH="{d}:$PATH"'


def read_profile(prof):
    try:
        return open(prof).read()
    except FileNotFoundError:
        return ""


def backup_profile(prof):
    bk = os.environ.get("JEB_BACKUPS") or os.path.expanduser("~/.claude/backups/jeb")
    os.makedirs(bk, mode=0o700, exist_ok=True)
    base = os.path.join(bk, os.path.basename(prof) + "." + time.strftime("%Y%m%d-%H%M%S"))
    dest, n = base + ".bak", 1
    while os.path.exists(dest):      # never overwrite an earlier backup from the same second
        n += 1
        dest = f"{base}-{n}.bak"
    shutil.copy2(prof, dest)
    detail("  backup: " + dest)


def add_to_profile():
    prof, text = profile_path(), read_profile(profile_path())
    if PATH_MARK in text.splitlines():
        say(f"{prof} already has the PATH line; open a new terminal")
        return
    detail(f"add to {prof}: {PATH_MARK} / {export_line()}")
    if DRY:
        return
    if text:
        backup_profile(prof)
    with open(prof, "a") as f:
        f.write(("" if not text or text.endswith("\n") else "\n") + PATH_MARK + "\n" + export_line() + "\n")
    say("open a new terminal for `jebctl` to work")


def remove_from_profile():
    prof, lines = profile_path(), read_profile(profile_path()).splitlines(keepends=True)
    if not any(l.rstrip("\n") == PATH_MARK for l in lines):
        return
    out, i = [], 0
    while i < len(lines):
        if lines[i].rstrip("\n") == PATH_MARK:
            i += 2 if i + 1 < len(lines) and lines[i + 1].startswith("export PATH=") else 1
        else:
            out.append(lines[i]); i += 1
    detail(f"remove the PATH lines from {prof}")
    if not DRY:
        backup_profile(prof)
        with open(prof, "w") as f:
            f.write("".join(out))


def path_step(add):
    d = bin_dir()
    if on_path(d):
        detail(f"{d} is on PATH")
        return
    if add:
        add_to_profile()
    else:
        say("Run Jeb's tool as " + d.replace(os.path.expanduser("~"), "~", 1) + "/jebctl")


def unlink_jebctl():
    p = link_path()
    if os.path.islink(p) and is_me(p):
        detail(f"remove {p}")
        if not DRY:
            os.unlink(p)
        line("jebctl command", "would remove" if DRY else "removed")
    elif os.path.lexists(p):
        say(f"{p} is not a link to this jebctl; left alone")
    else:
        line("jebctl command", "not installed")
    remove_from_profile()


def migrate_home():
    """Move the old state folder to ~/Library/Application Support/Jeb (once), then follow it. Returns the status."""
    r = jebhome.migrate(say, DRY)
    if r in ("moved", "failed"):
        set_home(jebhome.resolve())
    return r


def cmd_migrate():
    r = migrate_home()
    say({"n/a": "nothing to move: " + HOME + " is the state folder", "busy": "an update is running; try again shortly"}.get(r, r))


def cmd_install(args):
    try:
        install_steps(args)
    except SystemExit:
        if OPEN:
            fin("failed")       # the message follows
        raise


def refresh_standalone():
    """An existing standalone jebctl (JEB_TOOLS_DIR, default ~/.jeb/bin: what the README's curl line fetched) becomes this bundle's
    desktop/bin/jebctl, copied beside it and renamed over, so an older one that needed gh retires. Only a Mach-O replaces it (the git
    tree has an sh launcher there) and nothing is created; gh in that folder is never touched."""
    src, dst = os.path.join(CODE, "bin", "jebctl"), os.path.join(jebhome.tools_dir(), "jebctl")
    if not os.path.isfile(dst) or os.path.islink(dst) or not jebhome.macho_archs(src) or os.path.realpath(src) == os.path.realpath(dst):
        return
    (say if DRY else detail)(f"{'would refresh' if DRY else 'refresh'} {dst} from {src}")
    if not DRY:
        try:
            shutil.copyfile(src, dst + ".new")
            os.chmod(dst + ".new", 0o755)
            os.replace(dst + ".new", dst)
        except OSError as e:
            say(f"warning: could not refresh {dst}: {e}")


def install_bundle(args):
    """Install from an unpacked release bundle (~/.jeb/versions/<tag>): no git, no compile; the prebuilt app is gated and swapped in,
    then ~/.jeb/current points at the bundle and the plists, the plugin entry and the jebctl link use only that path."""
    if "--mode" in args and args[args.index("--mode") + 1:][:1] != ["release"]:
        raise SystemExit("a release bundle only installs in release mode")
    if allow_build(args):
        raise SystemExit("a release bundle never compiles: --build-from-source is for the git clone")
    vd = jebhome.versions_dir()
    if os.path.realpath(os.path.dirname(CLONE)) != os.path.realpath(vd):
        raise SystemExit(f"run install from the unpacked bundle in {vd}/<tag>, as the README says")
    tag = BUNDLE.get("tag")
    lead("signers")
    migrate_home()
    os.makedirs(HOME, mode=0o700, exist_ok=True)
    pin_signers("--repin" in args)
    widen_signers(os.path.join(CODE, "release-signers"))
    fin("ok")
    lead("app")
    why = check_app(os.path.join(CLONE, "app")) if not DRY else None
    if why:
        raise SystemExit(f"the bundle's app is unusable: {why}\nNothing was installed or changed.")
    detail("1. gates and first start through the updater (prebuilt app, never compiled)")
    t0 = time.time()
    old_mod = None
    try:
        old_mod = plistlib.load(open(os.path.join(AGENTS, "com.jeb.desktop.plist"), "rb"))["EnvironmentVariables"].get("JEB_MOD")
    except (OSError, KeyError, ValueError, plistlib.InvalidFileException):
        pass
    if DRY:
        detail(f"$ {RUN[0]} -I {CODE}/updater.py --force --no-watch --quick --prebuilt {CLONE}/app/JebDesktop --no-compile")
        detail(f"{LIVE} -> versions/{tag}")
    else:
        lock = open(os.path.join(HOME, "release.lock"), "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise SystemExit("an update is running; try again in a few minutes")
        prev = flip_current(CLONE)
        env = dict(os.environ, JEB_HOME=HOME, JEB_MOD=os.path.join(LIVE, "mod"), JEB_BUNDLE_MOD=os.path.join(LIVE, "mod"), JEB_APP_DIR=APP_DIR)
        r = subprocess.run(RUN + [os.path.join(CODE, "updater.py"), "--force", "--no-watch", "--quick", "--prebuilt", os.path.join(CLONE, "app", "JebDesktop"), "--no-compile"], env=env, **({} if VERBOSE else {"capture_output": True, "text": True}))
        if r.returncode != 0 or not os.path.isdir(APP):
            tail = open(os.path.join(HOME, "update.log")).read().splitlines()[-6:] if os.path.exists(os.path.join(HOME, "update.log")) else []
            if not tail and not VERBOSE:
                tail = (r.stdout + r.stderr).strip().splitlines()[-6:]
            try:
                if prev:
                    flip_current(prev)
                else:
                    os.unlink(LIVE)
            except OSError:
                pass
            raise SystemExit("a gate failed; nothing installed.\n" + "\n".join(tail))
    fin("skipped (dry run)" if DRY else f"ok (prebuilt {tag}, {time.time() - t0:.0f}s)")
    if not DRY:
        with open(MODE_FILE, "w") as f:
            f.write("release\n")
        rs = load_rstate()
        rs.update({"layout": "bundle", "last": {"at": int(time.time()), "tag": tag, "result": "ok", "app": "prebuilt"}})
        if not any(e.get("tag") == tag for e in rs.get("installed", [])):
            u = load_updater()
            u.set_home(HOME)
            record_installed(rs, tag, u)
        if old_mod and os.path.realpath(old_mod) != os.path.realpath(os.path.join(LIVE, "mod")):
            rs["legacy_mod"] = old_mod
        save_rstate(rs)
    finish_install("release", args)
    refresh_standalone()
    if not DRY:
        prune_versions()


def install_steps(args):
    if BUNDLE:
        return install_bundle(args)
    migrate_home()      # first: everything below reads and writes the state folder
    m = mode()
    if "--mode" in args:
        try:
            m = args[args.index("--mode") + 1]
        except IndexError:
            m = ""
        if m not in ("dev", "release"):
            raise SystemExit("usage: jebctl install [--mode dev|release] [--repin] [--add-path] [--build-from-source] [--no-agents] [--dry-run] [--verbose]")
    detail(f"mode: {m}")
    back = None
    if m == "release":
        pin_signers("--repin" in args)        # from the cloned checkout, before any tag is looked at
        back = select_release()
    lead("app")
    app, pre, tag = None, [], None
    build = m == "dev" or allow_build(args)         # release mode compiles only on request
    why = []
    if m == "release" and os.path.isfile(SIGNERS):
        on = head_tags()
        if on and verify_tag(on[-1], base_branch())[1] is None:
            tag = on[-1]
            if DRY:
                detail(f"app: would use {app_name(on[-1])} (JebDesktop, detect, png2raw) from the release when its hash matches the app-sha256 line in the tag" + ("; else the compile" if build else "; else stop (release mode never compiles)"))
            else:
                app = fetch_app(tag, lambda m: (why.append(m), detail(m)), build)
                pre = ["--prebuilt", app] if app else []
        else:
            why.append("no verified Jeb release was found to install (the clone is not on a release tag signed by a pinned signer); try again later")
    elif m == "release":
        why.append("no signing keys are pinned, so no release can be trusted (the clone has no desktop/release-signers with a jeb-release key); ask Claude to repair Jeb")
    if m == "release" and not build and not app and not DRY:
        if back:
            git("checkout", "--detach", back)
        raise SystemExit("could not get the Jeb app to install: " + (why[-1].removeprefix("app: ") if why else "no reason logged") + "\nNothing was installed or changed.")
    detail("1. first build through the updater (" + ("compile" if build else "prebuilt app, never compiled") + ", smoke, headless start)")
    t0 = time.time()
    if DRY:
        detail(f"$ python3 -I {CODE}/updater.py --force --no-watch --quick" + ("" if build else " --no-compile"))
    else:
        r = subprocess.run(RUN + [os.path.join(CODE, "updater.py"), "--force", "--no-watch", "--quick"] + pre + ([] if build else ["--no-compile"]), env=dict(os.environ, JEB_HOME=HOME, JEB_MOD=MOD, JEB_APP_DIR=APP_DIR), **({} if VERBOSE else {"capture_output": True, "text": True}))
        if app:
            shutil.rmtree(os.path.dirname(os.path.dirname(app)), ignore_errors=True)
        if r.returncode != 0 or not os.path.isdir(APP):
            tail = open(os.path.join(HOME, "update.log")).read().splitlines()[-6:] if os.path.exists(os.path.join(HOME, "update.log")) else []
            if not tail and not VERBOSE:
                tail = (r.stdout + r.stderr).strip().splitlines()[-6:]
            if back:
                g = git("checkout", "--detach", back)
                tail.append(f"back on the cloned commit {back[:12]}" if g.returncode == 0 else f"COULD NOT go back to {back[:12]}: {g.stderr.strip()[:200]}")
            raise SystemExit("a gate failed; nothing installed.\n" + "\n".join(tail))
    fin("skipped (dry run)" if DRY else f"ok (prebuilt {tag})" if app else f"ok (built, {time.time() - t0:.0f}s)")
    if not DRY:
        os.makedirs(HOME, mode=0o700, exist_ok=True)
        with open(MODE_FILE, "w") as f:
            f.write(m + "\n")
    if m == "release" and git("symbolic-ref", "-q", "HEAD").returncode == 0:
        detail("release: leaving the clone's branch so follow can move it: git checkout --detach HEAD")
        if not DRY:
            r = git("checkout", "--detach", "HEAD")
            if r.returncode != 0:
                say(f"warning: could not detach the clone from its branch ({r.stderr.strip()[:200]}); follow will skip until it is")
    finish_install(m, args)


def finish_install(m, args):
    """Plists, the LaunchAgents, the desktop wait and the jebctl link: the part of an install both layouts share."""
    global TOUCHED
    TOUCHED = not DRY       # from here the agents and plists change (nothing is rolled back from here)
    lead("LaunchAgents")
    detail("2. plists")
    write_plists(os.path.join(HOME, "launchd"), m)
    if os.path.exists(os.path.join(HOME, "quit")) and not DRY:
        os.unlink(os.path.join(HOME, "quit"))
    if NO_AGENTS:
        detail("3-5. hand-over, LaunchAgents (copy, bootout, bootstrap), waiting for the desktop and the jebctl link: skipped (--no-agents)")
        fin("skipped (--no-agents)")
        lead("desktop")
        fin("skipped (--no-agents)")
        line("jebctl command", "skipped (--no-agents)")
        return
    detail("3. hand the desktop over from any running instance")
    hand_over_from_legacy()
    detail("4. LaunchAgents")
    mine = labels_for(m)
    for l in mine:
        sh(["cp", os.path.join(HOME, "launchd", l + ".plist"), os.path.join(AGENTS, l + ".plist")]) if DRY else (os.makedirs(AGENTS, exist_ok=True), shutil.copy2(os.path.join(HOME, "launchd", l + ".plist"), os.path.join(AGENTS, l + ".plist")))
    for l in ALL_LABELS:
        sh(["launchctl", "bootout", f"gui/{UID}/{l}"])      # a re-install: ignore "not loaded"
        if l not in mine:                                    # a mode switch: the other mode's agent goes
            detail(f"remove {os.path.join(AGENTS, l + '.plist')} (not part of {m} mode)")
            if not DRY and os.path.exists(os.path.join(AGENTS, l + ".plist")):
                os.unlink(os.path.join(AGENTS, l + ".plist"))
    for l in ("com.jeb.desktop.update", "com.jeb.desktop.watchdog", "com.jeb.desktop", "com.jeb.desktop.release"):
        if l in mine:
            sh(["launchctl", "bootstrap", f"gui/{UID}", os.path.join(AGENTS, l + ".plist")], check=True)
    fin("skipped (dry run)" if DRY else "ok")
    lead("desktop")
    up = False
    if not DRY:
        for _ in range(60):
            time.sleep(1)
            procs = running()
            if len(procs) == 1 and procs[0][2].startswith(APP):
                up = True
                break
        if VERBOSE:
            cmd_status()
    fin("skipped (dry run)" if DRY else "running" if up else "not running yet; see `jebctl status`")
    detail("5. jebctl on PATH")
    st = link_state()
    ok = link_jebctl()
    line("jebctl command", "not set up" if not ok else "would link" if DRY and st != "ours" else "ok")
    if ok:
        path_step("--add-path" in args)


def cmd_uninstall(purge):
    if purge and os.path.realpath(HOME) in ("/", os.path.realpath(os.path.expanduser("~")), os.path.realpath(os.path.expanduser("~/.claude")), os.path.realpath(os.path.expanduser("~/Library/Application Support"))):
        raise SystemExit(f"refusing to purge {HOME}: JEB_HOME must be the desktop's own folder")      # purge empties it whole
    lead("LaunchAgents and app")
    for l in ("com.jeb.desktop.release", "com.jeb.desktop.update", "com.jeb.desktop.watchdog", "com.jeb.desktop"):
        sh(["launchctl", "bootout", f"gui/{UID}/{l}"])
    for l in ALL_LABELS:
        p = os.path.join(AGENTS, l + ".plist")
        detail(f"remove {p}")
        if not DRY and os.path.exists(p):
            os.unlink(p)
    if not DRY:
        write_quit_marker()
        terminate_all()
    detail(f"remove {APP}")
    if not DRY:
        shutil.rmtree(APP, ignore_errors=True)
        if os.path.exists(os.path.join(HOME, "quit")):
            os.unlink(os.path.join(HOME, "quit"))
    fin("would remove" if DRY else "removed")
    if purge:
        lead("desktop folder")
        # everything in HOME (the desktop's own 0700 folder), then the folder if it is empty; a symlink is unlinked, never followed
        for n in sorted(os.listdir(HOME)) if os.path.isdir(HOME) else []:
            p = os.path.join(HOME, n)
            detail(f"purge {p}")
            if not DRY:
                shutil.rmtree(p, ignore_errors=True) if os.path.isdir(p) and not os.path.islink(p) else os.unlink(p)
        detail(f"purge {HOME}")
        if not DRY:
            try:
                os.rmdir(HOME)
            except OSError:
                pass
        fin("would purge" if DRY else "purged")
    else:
        detail("kept versions and logs")
    old = jebhome.old_path()
    if os.path.islink(old) and os.path.realpath(old) == os.path.realpath(HOME):
        detail(f"remove the link {old}")
        if not DRY:
            os.unlink(old)
    unlink_jebctl()


