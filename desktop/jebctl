def load_rstate():
    try:
        return json.load(open(RELEASE_STATE))
    except (OSError, ValueError):
        return {"failed": [], "checked": None, "last": None}


def save_rstate(rs):
    if DRY:
        return
    tmp = RELEASE_STATE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(rs, f, indent=1)
    os.replace(tmp, RELEASE_STATE)


def rlog(msg):
    say(msg)
    if DRY:
        return
    os.makedirs(HOME, mode=0o700, exist_ok=True)
    try:
        if os.path.getsize(RELEASE_LOG) > 256 * 1024:
            os.replace(RELEASE_LOG, RELEASE_LOG + ".1")
    except OSError:
        pass
    fd = os.open(RELEASE_LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg.replace("\n", " | ") + "\n")


class UnsafeArchive(Exception):
    pass


def extract_safe(t, dest):
    """Extracts a tar stream member by member: only regular files and directories, relative names without '..',
    nothing that resolves outside dest. Anything else raises UnsafeArchive before it is written."""
    root = os.path.realpath(dest)
    for m in t:
        n = m.name
        if not (m.isreg() or m.isdir()):
            raise UnsafeArchive(f"member {n!r} is not a regular file or directory")
        if n.startswith("/") or ".." in n.split("/"):
            raise UnsafeArchive(f"member {n!r} has an absolute or '..' name")
        target = os.path.realpath(os.path.join(root, n))
        if target != root and not target.startswith(root + os.sep):
            raise UnsafeArchive(f"member {n!r} resolves outside the staging folder")
        if m.isdir():
            os.makedirs(target, mode=0o755, exist_ok=True)
            continue
        os.makedirs(os.path.dirname(target), mode=0o755, exist_ok=True)
        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o755 if m.mode & 0o100 else 0o644)
        with os.fdopen(fd, "wb") as out:
            shutil.copyfileobj(t.extractfile(m), out)


def stage_tag(sha, dest):
    """git archive of the commit's desktop/ and mod/ into dest, extracted safely."""
    shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(dest, mode=0o700)
    p = subprocess.Popen(["git", "-C", CLONE, "archive", "--format=tar", sha, "desktop", "mod"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        with tarfile.open(fileobj=p.stdout, mode="r|") as t:
            extract_safe(t, dest)
    except UnsafeArchive:
        p.kill(); p.communicate()
        shutil.rmtree(dest, ignore_errors=True)
        raise
    err = p.stderr.read().decode()
    if p.wait() != 0:
        raise SystemExit(f"git archive {sha} failed: {err.strip()}")


def base_branch():
    """The default branch: origin/HEAD, else main."""
    head = git("symbolic-ref", "--short", "-q", "refs/remotes/origin/HEAD").stdout.strip()
    return head.split("/", 1)[1] if "/" in head else "main"


def verify_tag(tag, base):
    """(sha, None) when the tag is signed by a pinned signer, names itself, and its commit is on origin/<base>; else (None, reason)."""
    ref = "refs/tags/" + tag
    r = git("rev-parse", "--verify", "-q", ref + "^{commit}")
    sha = r.stdout.strip()
    if r.returncode != 0 or not sha:
        return None, "cannot resolve the tag to a commit"
    r = git("-c", "gpg.format=ssh", "-c", "gpg.ssh.allowedSignersFile=" + SIGNERS, "verify-tag", tag)
    if r.returncode != 0:
        return None, "not signed by a pinned signer: " + (r.stderr.strip().splitlines() or ["verify-tag failed"])[-1][:150]
    body = git("cat-file", "tag", ref).stdout.split("\n\n", 1)[0].splitlines()
    if "tag " + tag not in body:
        return None, "the signed tag object names a different tag (replayed signature)"
    if git("merge-base", "--is-ancestor", sha, "origin/" + base).returncode != 0:
        return None, f"commit {sha[:12]} is not on origin/{base}"
    return sha, None


def app_name(tag):
    return f"JebDesktop-{tag}-macos.zip"


APP_ZIP_MAX = 64 << 20                 # the most an app zip may be (v1.4.0's is 1.4 MB)
HELPERS = ("detect", "png2raw")        # the gate helpers the release zip carries beside JebDesktop (updater.GATE_TOOLS)


def allow_build(args):
    """Release mode never compiles unless asked: --build-from-source or JEB_ALLOW_BUILD=1."""
    return "--build-from-source" in args or os.environ.get("JEB_ALLOW_BUILD") == "1"


def fetch_app(tag, log=say, build=True):
    """The release's prebuilt JebDesktop, or None (and why, through log). Its helpers (detect, png2raw) sit beside it, where
    updater.py --prebuilt picks them up; an older release's zip has the binary only. Call only for a tag verify_tag
    accepted: the download is trusted only when its SHA-256 equals the app-sha256 line in that signed tag's message.
    build: the caller compiles instead when this returns None (changes only the wording)."""
    name = app_name(tag)
    then = "; building from source" if build else ""
    def no(why):
        log(f"app: {why}{then}")
    msg = git("cat-file", "tag", "refs/tags/" + tag).stdout.split("\n\n", 1)[-1]
    m = re.search(r"^app-sha256: ([0-9a-f]{64}) (\S+)$", msg, re.M)
    if not m or m.group(2) != name:
        no(f"{tag} has no app-sha256 line"); return None
    want = m.group(1)
    dest = os.path.join(HOME, "staging", tag + "-app")
    shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(dest, mode=0o700)
    zp = os.path.join(dest, name)
    try:
        jebhome.fetch(f"{release_base()}/download/{tag}/{name}", zp, limit=APP_ZIP_MAX)
    except jebhome.FetchError as e:
        no(f"download failed ({e})"); return None
    h = hashlib.sha256()
    with open(zp, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    if h.hexdigest() != want:
        os.unlink(zp)
        no(f"{name} does not match the signed hash; discarded"); return None
    out = os.path.join(dest, "out")
    binary = os.path.join(out, "JebDesktop")
    if subprocess.run(["ditto", "-x", "-k", zp, out], capture_output=True).returncode != 0 or not os.path.isfile(binary):
        no(f"could not unpack {name}"); return None
    have = [n for n in HELPERS if os.path.isfile(os.path.join(out, n))]
    if have and len(have) != len(HELPERS):
        no(f"{name} holds only part of the helper tools ({', '.join(have)})"); return None
    arch = jebhome.host_arch()
    for n in ("JebDesktop",) + tuple(have):
        f = os.path.join(out, n)
        subprocess.run(["xattr", "-c", f], capture_output=True)
        os.chmod(f, 0o755)
        got = jebhome.macho_archs(f)
        if arch not in got:
            no(f"{n} is not built for {arch} ({' '.join(sorted(got)) or 'unreadable'})"); return None
    log(f"app: {name} matches the signed hash; using it in place of a build" + ("" if have else " (this release's zip has no helper tools)"))
    return binary


def live_valid():
    """True when ~/.jeb/current resolves to a bundle with its Python and jebctl (schema 2: the native jebctl and the app, no Python)."""
    need = (("bundle.json",), ("desktop", "bin", "jebctl"), ("app", "JebDesktop")) if (jebhome.read_bundle(LIVE) or {}).get("schema") == 2 else (("bundle.json",), ("python", "bin", "python3"), ("desktop", "jebctl"))
    return all(os.path.isfile(os.path.join(LIVE, *p)) for p in need)


def cmd_follow(args):
    gates_only = "--gates-only" in args
    if not BUNDLE and load_rstate().get("layout") == "bundle" and live_valid() and not DRY:
        py = os.path.join(LIVE, "python", "bin", "python3")      # converted: the bundle follows from now on, this clone is only a leftover
        if os.path.isfile(py):
            os.execv(py, [py, "-I", os.path.join(LIVE, "desktop", "jebctl")] + sys.argv[1:])
        native = os.path.join(LIVE, "desktop", "bin", "jebctl")  # a Python-free bundle
        os.execv(native, [native] + sys.argv[1:])
    if not os.path.exists(os.path.join(HOME, "updates-paused")):
        migrate_home()      # before the lock below: migrate takes release.lock itself
    os.makedirs(HOME, mode=0o700, exist_ok=True)
    lock = open(os.path.join(HOME, "release.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        say("another follow is running"); return 0
    u = load_updater()      # its status helper writes update-status.json for the menu; follow owns the final result
    u.set_home(HOME)
    u.STATUS_SOURCE, u.STATUS_FINAL = "release", False
    try:
        os.unlink(os.path.join(HOME, "check-now"))      # the menu's click; nothing to skip here
        u._ST["clicked"] = True
    except OSError:
        pass
    final = []
    def S(phase, detail="", result=None):
        if phase == "done":
            final.append(result)
        if not DRY:
            u.status(phase, detail[:160] if phase == "done" else detail, result=result)
    try:
        S("checking")
        rc = follow_bundle(gates_only, u, S, "--quick" in args) if BUNDLE else follow(gates_only, u, S, allow_build(args), "--quick" in args)
    except BaseException as e:
        if not u._ST["finished"]:
            S("done", f"{type(e).__name__}: {e}", "error")
        raise
    return rc


def follow(gates_only, u, S, build=False, quick=False):
    """cmd_follow after the lock; every return writes the final status."""
    def stop(why, result="error"):
        S("done", why, result)
    if mode() != "release":
        rlog("follow: not in release mode; nothing to do"); stop("not in release mode"); return 0
    if os.path.exists(os.path.join(HOME, "updates-paused")):
        rlog("follow: updates are paused; skipping"); stop("updates are paused"); return 0
    if not os.path.isfile(SIGNERS):
        rlog(f"follow: no pinned release signers ({SIGNERS}); not updating (install from a clone that ships desktop/release-signers)"); stop("no pinned release signers"); return 0
    if not gates_only and not DRY and convert_clone(u, S, quick):
        return 0        # now a release bundle; the clone below is only used when that did not work
    if git("status", "--porcelain", "-uno").stdout.strip():
        rlog("follow: the clone has local changes; skipping"); stop("the clone has local changes"); return 0
    if git("symbolic-ref", "-q", "HEAD").returncode == 0:
        rlog("follow: the clone is on a branch, not detached; skipping (re-run ./install to detach it)"); stop("the clone is on a branch; re-run ./install"); return 0
    on = release_tags("--points-at", "HEAD")
    cur = on[-1] if on else None        # None: detached on no release tag; every verified tag is a candidate
    cur_sha = git("rev-parse", "HEAD").stdout.strip()
    rs = load_rstate()
    if DRY:
        detail("$ git fetch --tags origin")
    else:
        S("fetching tags")
        r = git("fetch", "--tags", "origin", timeout=180)
        if r.returncode != 0:
            rlog(f"follow: fetch failed ({r.stderr.strip()[:200]}); will try again later"); stop("fetch failed; will retry"); return 0
    rs["checked"] = int(time.time())
    save_rstate(rs)
    base = base_branch()
    new = [t for t in release_tags() if (cur is None or tag_key(t) > tag_key(cur)) and t not in rs.get("failed", [])]
    if not new:
        rlog(f"follow: {cur} is current" if cur else "follow: no release tag to move to")
        stop(f"{cur} is current" if cur else "no release tag to move to", "up-to-date")
        return 0
    here = cur or f"{cur_sha[:12]} (no release tag)"
    tag = sha = staged = None
    for t in reversed(new):         # newest first: a bogus far-future tag cannot block the real releases
        S(f"verifying {t}")
        sha, why = verify_tag(t, base)
        if not why:
            staged = os.path.join(HOME, "staging", t)
            if DRY:
                tag = t
                break
            rlog(f"follow: {t} ({sha[:12]}) is signed and on origin/{base}; staging into {staged}")
            try:
                stage_tag(sha, staged)
            except UnsafeArchive as e:
                why = "unsafe archive: " + str(e)
            else:
                tag = t
                break
        rlog(f"follow: {t} rejected: {why}; it will not be retried")
        rs.setdefault("failed", []).append(t)
        save_rstate(rs)
    if not tag:
        rlog(f"follow: no verified release newer than {here}")
        stop(f"no verified release newer than {here}", "up-to-date")
        return 0
    src, mod = os.path.join(staged, "desktop", "src"), os.path.join(staged, "mod")
    args = ["--force", "--src", src] + (["--gates-only"] if gates_only else []) + (["--quick"] if quick else [])
    if DRY:
        say(f"{tag} ({sha[:12]}) is signed by a pinned signer and on origin/{base}")
        say(f"$ git -C {CLONE} archive --format=tar {sha} desktop mod   (members checked, extracted into {staged})")
        say(f"$ JEB_MOD={mod} JEB_SRC={src} updater.py {' '.join(args)}   (compile, smoke, parity, day, start gates)")
        say(f"app: would use {app_name(tag)} (JebDesktop, detect, png2raw) from the release when its hash matches the app-sha256 line in the tag; " + ("else the compile" if build else "else stop with `app download failed; will retry` (release mode never compiles)"))
        if not gates_only:
            say(f"on a pass: git -C {CLONE} checkout --detach {sha}; install the build; watch; on failure git checkout --detach {cur_sha} ({here}) and restore the previous bundle")
        return 0
    # the updater's clean_env passes these to the gates; the bundle's JebMod is the clone's mod (the staging copy is deleted
    # after the update, and the clone is checked out to the same SHA before the bundle is installed)
    os.environ["JEB_MOD"], os.environ["JEB_SRC"], os.environ["JEB_BUNDLE_MOD"] = mod, src, MOD
    S("downloading app")
    app = fetch_app(tag, rlog, build)
    if app:
        args += ["--prebuilt", app]
    elif not build:         # not the tag's fault: it is not marked failed, and the next run tries again
        for d in (staged, os.path.join(HOME, "staging", tag + "-app")):
            shutil.rmtree(d, ignore_errors=True)
        rlog(f"follow: could not get the app for {tag}; will try again later")
        stop("app download failed; will retry"); return 0
    if not build:
        args += ["--no-compile"]
    moved = []
    def checkout():
        r = git("checkout", "--detach", sha)
        if r.returncode != 0:
            return "git checkout failed: " + r.stderr.strip()[:200]
        moved.append(tag)
        rlog(f"follow: {tag} passed the gates; the clone is on {sha[:12]} now")
        return None
    try:
        rc = u.main(args, None if gates_only else checkout)
    except Exception as e:
        rlog(f"follow: updater error: {type(e).__name__}: {e}"); rc = 1
    if moved and rc != 0:
        r = git("checkout", "--detach", cur_sha)
        rlog(f"follow: {tag} failed after the checkout (updater exit {rc}); " + (f"back on {here}" if r.returncode == 0 else f"COULD NOT go back to {here} ({cur_sha[:12]}): {r.stderr.strip()[:200]}"))
    result = {0: "ok", 2: "rejected", 3: "rolled-back"}.get(rc, "error")
    if gates_only:
        result = "gates-" + result
    elif rc in (2, 3):
        rs.setdefault("failed", []).append(tag)
        rlog(f"follow: {tag} {result}; it will not be retried")
    elif rc == 0:
        rlog(f"follow: now on {tag}")
    else:
        rlog(f"follow: {tag} not installed (updater exit {rc}); will try again later")
    rs["last"] = {"at": int(time.time()), "tag": tag, "result": result, "app": "prebuilt" if app else "source"}
    save_rstate(rs)
    last = u.load_state().get("last") or {}
    why = last.get("why") if (last.get("at") or 0) >= u._ST["started"] else None      # the updater's reason, if this run recorded one
    if gates_only:
        stop(f"{tag}: gates {'passed' if rc == 0 else 'failed'}; nothing installed", "up-to-date" if rc == 0 else "failed")
    elif rc == 0:
        stop(f"updated to {tag}", "updated")
    else:
        stop(f"{tag}: {why or 'see update.log'}", {2: "failed", 3: "rolled-back"}.get(rc, "error"))
    for d in os.listdir(os.path.join(HOME, "staging")):
        if d != tag or rc == 0:         # a failed one stays for a look; older ones go
            shutil.rmtree(os.path.join(HOME, "staging", d), ignore_errors=True)
    return 0 if rc in (0, 2, 3) else 1


# ---- release bundles: versions/<tag> unpacked beside the live one, `current` flipped after the gates ----

def check_app(d):
    """None when every binary of the unpacked app folder (JebDesktop, detect, png2raw) holds this Mac's architecture; they are
    made executable and stripped of extended attributes. Else the reason."""
    arch = jebhome.host_arch()
    for n in ("JebDesktop",) + HELPERS:
        f = os.path.join(d, n)
        if not os.path.isfile(f):
            return f"{n} is missing"
        got = jebhome.macho_archs(f)
        if arch not in got:
            return f"{n} is not built for {arch} ({' '.join(sorted(got)) or 'unreadable'})"
        os.chmod(f, 0o755)
        subprocess.run(["xattr", "-c", f], capture_output=True)
    return None


def key_line(line):
    """(blob, namespaces list or None, token index of the option field or None) of an allowed_signers line; None for a comment."""
    t = line.split()
    if not t or t[0].startswith("#"):
        return None
    i = next((k for k, x in enumerate(t) if k and x.startswith(("ssh-", "ecdsa-", "sk-"))), None)
    if i is None or i + 1 >= len(t):
        return None
    ns = None
    for k in range(1, i):
        m = re.fullmatch(r'namespaces="([^"]*)"', t[k])
        if m:
            ns = (k, [x for x in m.group(1).split(",") if x])
    return t[i + 1], ns


def widen_signers(src):
    """A key that is already pinned (JEB_HOME/release-signers) gets the namespaces src (a shipped desktop/release-signers) lists for
    it, added to its own, so an old pin signed for `git` also covers `jeb-release`. Never adds a key. True when the file changed."""
    try:
        want = {}
        for l in open(src).read().splitlines():
            k = key_line(l)
            if k and k[1]:
                want[k[0]] = k[1][1]
        lines = open(SIGNERS).read().splitlines()
    except OSError:
        return False
    out, changed = [], False
    for l in lines:
        k = key_line(l)
        if k and k[1] and k[0] in want:
            ns = k[1][1] + [x for x in want[k[0]] if x not in k[1][1]]
            if ns != k[1][1]:
                t = l.split()
                t[k[1][0]] = 'namespaces="' + ",".join(ns) + '"'
                l, changed = " ".join(t), True
        out.append(l)
    if changed:
        detail(f"signers: widened the namespaces in {SIGNERS}")
        if not DRY:
            tmp = SIGNERS + ".tmp"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write("\n".join(out) + "\n")
            os.replace(tmp, SIGNERS)
    return changed


def pin_hash():
    """SHA-256 of the pinned signers file ('' when none)."""
    try:
        return hashlib.sha256(open(SIGNERS, "rb").read()).hexdigest()
    except OSError:
        return ""


def parse_signers(text):
    """The allowed_signers lines of text as (principal, keytype, key) when it is a usable release-signers file: at least one line, and every
    line `principal [namespaces="..."] keytype base64` with jeb-release among its namespaces and no other option. Else None."""
    out = []
    for l in text.splitlines():
        t = l.split()
        if not t or t[0].startswith("#"):
            continue
        k = key_line(l)
        i = next((n for n, x in enumerate(t) if n and x.startswith(("ssh-", "ecdsa-", "sk-"))), None)
        if not k or not k[1] or "jeb-release" not in k[1][1] or i != 2 or len(t) != 4 or not re.fullmatch(r"[A-Za-z0-9+/=]+", t[3]):
            return None
        out.append((t[0], t[i], t[i + 1]))
    return out or None


def adopt_signers(rs, tag, src):
    """The pin follows the signed releases: when tag is newer than the release the pin was last adopted from (rs.signers_from; none yet
    counts as older), the signers file `src` of that release replaces JEB_HOME/release-signers (atomic, 0600). Only called for a release this
    process has verified (the installed one, a verified update, a converted clone); never at a fresh install, never with --from-tree.
    A src that does not parse into valid jeb-release lines is ignored. True when adopted."""
    cur = rs.get("signers_from")
    if not tag_key(tag) or (isinstance(cur, str) and tag_key(cur) and tag_key(tag) <= tag_key(cur)):
        return False
    try:
        text = open(src).read()
    except OSError:
        return False
    if not parse_signers(text):
        rlog(f"signers: {tag}'s release-signers is not usable; the pin stays")
        return False
    rs["signers_from"] = tag
    if pin_hash() == hashlib.sha256(text.encode()).hexdigest():
        rlog(f"signers: the pin already matches {tag}'s")
        return True
    rlog(f"signers: adopting the release-signers of {tag}")
    if not DRY:
        os.makedirs(os.path.dirname(SIGNERS), mode=0o700, exist_ok=True)
        tmp = SIGNERS + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, 0o600)
        os.replace(tmp, SIGNERS)
    return True


def failed_skip(rs):
    """rs.failed minus the tags rejected only for their signature while a different pin was in place: those get another look."""
    pin, why = pin_hash(), rs.get("failed_why") or {}
    return [t for t in rs.get("failed", []) if not (isinstance(why.get(t), dict) and why[t].get("why") == "signature" and why[t].get("pin") != pin)]


def mark_failed(rs, tag, kind):
    if tag not in rs.setdefault("failed", []):
        rs["failed"].append(tag)
    rs.setdefault("failed_why", {})[tag] = {"why": kind, "pin": pin_hash()}


def clear_failed(rs, tag):
    if tag in rs.get("failed", []):
        rs["failed"].remove(tag)
    (rs.get("failed_why") or {}).pop(tag, None)


def flip_current(target):
    """Point ~/.jeb/current at target (a relative link when it sits in versions/); atomic. Returns the previous target as an
    absolute path, or None when there was none."""
    cur, vd = jebhome.current_dir(), jebhome.versions_dir()
    if os.path.lexists(cur) and not os.path.islink(cur):
        raise OSError(f"{cur} is not a link; left alone")
    prev = None
    if os.path.islink(cur):
        prev = os.readlink(cur)
        prev = prev if os.path.isabs(prev) else os.path.join(os.path.dirname(cur), prev)
    link = os.path.join("versions", os.path.basename(target)) if os.path.realpath(os.path.dirname(target)) == os.path.realpath(vd) else target
    tmp = cur + ".new"
    if os.path.lexists(tmp):
        os.unlink(tmp)
    os.makedirs(os.path.dirname(cur), mode=0o755, exist_ok=True)
    os.symlink(link, tmp)
    os.replace(tmp, cur)
    return prev


def prune_versions():
    """The one-version rule: only the folder `current` points to stays in ~/.jeb/versions, and no .*.partial leftover. The folder
    this process runs from stays until the next run (follow starts with this); nothing goes while current does not resolve."""
    vd = jebhome.versions_dir()
    live = os.path.realpath(LIVE) if os.path.isdir(LIVE) else None
    me = os.path.realpath(CLONE) if BUNDLE else None
    for n in sorted(os.listdir(vd)) if os.path.isdir(vd) else []:
        p = os.path.join(vd, n)
        if n.startswith(".") and n.endswith(".partial"):
            pass
        elif live is None or os.path.realpath(p) == live:
            continue
        elif os.path.realpath(p) == me:
            detail(f"versions: {n} is this process's own folder; it goes once this run exits")
            continue
        detail(f"versions: removing {n}")
        if not DRY:
            shutil.rmtree(p, ignore_errors=True) if os.path.isdir(p) and not os.path.islink(p) else os.unlink(p)


def prune_now():
    """prune_versions, then a detached run from the live version that removes this process's own (old) folder once this
    process has exited (deleting it under a running interpreter would break its later imports), so a finished update leaves
    exactly one folder."""
    prune_versions()
    me, live = os.path.realpath(CLONE) if BUNDLE else None, os.path.realpath(LIVE)
    if me and me != live and os.path.isdir(live) and live_valid():
        subprocess.Popen([os.path.join(LIVE, "desktop", "bin", "jebctl"), "prune-versions", "--wait-pid", str(os.getpid())], env=scrubbed_env(), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def release_repo():
    """owner/name of the GitHub repo releases come from: the bundle's, else origin's, else clevyr/jeb."""
    if BUNDLE and BUNDLE.get("repo"):
        return BUNDLE["repo"]
    r = re.search(r"github\.com[:/]([^/\s]+/[^/\s]+?)(?:\.git)?/?$", git("remote", "get-url", "origin").stdout.strip())
    return r.group(1) if r else "clevyr/jeb"


def release_base():
    return jebhome.release_base(release_repo())


MANIFEST_MAX = 64 << 10                # the most a manifest or its signature may be (a manifest is under 1 KB)


def verify_manifest(manifest, sig, tag):
    """None when the manifest is signed for `jeb-release` by a pinned signer and names this tag; else (reason, kind): signature or content."""
    if not os.path.isfile(SIGNERS):
        return "no signers are pinned", "signature"
    r = subprocess.run(["ssh-keygen", "-Y", "find-principals", "-s", sig, "-f", SIGNERS], capture_output=True, text=True)
    who = r.stdout.split()
    if r.returncode != 0 or not who:
        return "the manifest is not signed by a pinned signer", "signature"
    for p in who:
        with open(manifest, "rb") as f:
            v = subprocess.run(["ssh-keygen", "-Y", "verify", "-f", SIGNERS, "-I", p, "-n", "jeb-release", "-s", sig], stdin=f, capture_output=True, text=True)
        if v.returncode == 0:
            break
    else:
        return "the manifest signature does not verify for jeb-release: " + (v.stderr.strip().splitlines() or ["?"])[-1][:150], "signature"
    try:
        doc = json.load(open(manifest))
    except (OSError, ValueError):
        return "the manifest is not valid JSON", "content"
    if not isinstance(doc, dict) or doc.get("tag") != tag:
        return f"the signed manifest names {doc.get('tag') if isinstance(doc, dict) else '?'}, not {tag} (replayed)", "content"
    return None


def fetch_bundle(tag, log=say):
    """Download, verify and unpack release `tag` into ~/.jeb/versions/<tag>. Returns (path, None), or (None, (why, permanent, kind)):
    permanent (a bad signature, tag, hash, size or content) means the tag is not retried (a signature rejection is, once the pin changes);
    network or a missing asset retries later. kind (None when not permanent): signature, size, sha, content or arch.
    Nothing is left half-done: the unpack goes to versions/.<tag>.partial and is renamed last.
    A bundle.json "schema" 2 bundle is Python-free: see run_update for how it is applied."""
    arch, base = jebhome.host_arch(), release_base()
    vd = jebhome.versions_dir()
    dl, part, final = os.path.join(HOME, "staging", tag + "-dl"), os.path.join(vd, f".{tag}.partial"), os.path.join(vd, tag)
    man, zname = f"Jeb-{tag}-manifest.json", f"Jeb-{tag}-macos-{arch}.zip"
    def done(res):
        for d in (dl, part):
            shutil.rmtree(d, ignore_errors=True)
        return res
    def bad(why, kind="content"):
        return done((None, (why, True, kind)))
    shutil.rmtree(dl, ignore_errors=True)
    os.makedirs(dl, mode=0o700)
    paths = [os.path.join(dl, n) for n in (man, man + ".sig", zname)]
    try:
        for n, x in zip((man, man + ".sig"), paths):
            jebhome.fetch(f"{base}/download/{tag}/{n}", x, limit=MANIFEST_MAX)
    except jebhome.TooBig as e:
        return bad(str(e), "size")
    except jebhome.FetchError as e:
        return done((None, (f"{tag}: {e}", False, None)))
    err = verify_manifest(paths[0], paths[1], tag)
    if err:
        return bad(*err)
    want = (json.load(open(paths[0])).get("bundles") or {}).get(arch)
    if not isinstance(want, dict) or want.get("name") != zname or not isinstance(want.get("size"), int) or isinstance(want.get("size"), bool):
        return bad(f"{zname} does not match the signed manifest (hash or size)", "sha")
    try:
        jebhome.fetch(f"{base}/download/{tag}/{zname}", paths[2], limit=want["size"])
    except jebhome.TooBig:
        return bad(f"{zname} is larger than the signed manifest says", "size")
    except jebhome.FetchError as e:
        return done((None, (f"{tag}: {e}", False, None)))
    h = hashlib.sha256()
    with open(paths[2], "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    if want.get("sha256") != h.hexdigest() or want["size"] != os.path.getsize(paths[2]):
        return bad(f"{zname} does not match the signed manifest (hash or size)", "sha")
    shutil.rmtree(part, ignore_errors=True)
    os.makedirs(vd, mode=0o755, exist_ok=True)
    if subprocess.run(["ditto", "-x", "-k", paths[2], part], capture_output=True).returncode != 0:
        return done((None, (f"could not unpack {zname}", False, None)))
    root = os.path.realpath(part)
    for dirpath, dirs, names in os.walk(part):
        for n in dirs + names:
            q = os.path.join(dirpath, n)
            if os.path.islink(q) and not (os.path.realpath(q) + os.sep).startswith(root + os.sep):
                return bad(f"the bundle has a link that leaves its folder ({os.path.relpath(q, part)})")
    b = jebhome.read_bundle(part)
    if not b or b.get("tag") != tag or b.get("arch") != arch:
        return bad(f"bundle.json does not say {tag} for {arch}")
    if b.get("schema", 1) not in (1, 2):
        return bad(f"the bundle's schema ({b.get('schema')}) is not one this jebctl knows")
    if b.get("schema", 1) == 2:     # Python-free: the native jebctl applies it (see run_update)
        need = ("install", "desktop/bin/jebctl", "mod", ".claude-plugin/marketplace.json", "app/JebDesktop", "app/detect", "app/png2raw")
    else:
        need = ("install", "desktop/jebctl", "desktop/updater.py", "mod", "python/bin/python3", "app/JebDesktop")
    for rel in need:
        if not os.path.exists(os.path.join(part, rel)):
            return bad(f"the bundle lacks {rel}")
    if b.get("schema", 1) == 2:
        got = jebhome.macho_archs(os.path.join(part, "desktop", "bin", "jebctl"))
        if arch not in got:
            return bad(f"desktop/bin/jebctl is not built for {arch} ({' '.join(sorted(got)) or 'not a Mach-O'})", "arch")
    subprocess.run(["xattr", "-dr", "com.apple.quarantine", part], capture_output=True)
    why = check_app(os.path.join(part, "app"))
    if why:
        return bad(why, "arch" if "is not built for" in why else "content")
    if os.path.lexists(final):
        if os.path.realpath(final) == os.path.realpath(LIVE):
            return done((None, (f"{tag} is the installed version", False, None)))
        shutil.rmtree(final, ignore_errors=True)
    os.rename(part, final)
    log(f"bundle: {zname} matches the signed manifest; unpacked into {final}")
    return done((final, None))


def run_update(u, ver, flip, extra=()):
    """The updater's gates on the unpacked bundle `ver` (never compiles; always the quick set, because parity and day run at release time) and, unless --gates-only, the swap; flip() runs just before
    the swap. Returns (updater exit code, previous current target or None, whether current was flipped)."""
    if (jebhome.read_bundle(ver) or {}).get("schema") == 2:
        return run_apply(ver, extra)
    src = os.path.join(ver, "desktop", "src")
    os.environ["JEB_MOD"], os.environ["JEB_SRC"], os.environ["JEB_BUNDLE_MOD"] = os.path.join(ver, "mod"), src, os.path.join(LIVE, "mod")
    args = ["--force", "--src", src, "--prebuilt", os.path.join(ver, "app", "JebDesktop"), "--no-compile", "--quick"] + (["--no-watch"] if NO_AGENTS else []) + [x for x in extra if x != "--quick"]
    prev = []
    def before():
        try:
            prev.append(flip(ver))
        except OSError as e:
            return f"could not switch {LIVE}: {e}"
        rlog(f"bundle: {LIVE} now points at {os.path.basename(ver)}")
        return None
    try:
        rc = u.main(args, None if "--gates-only" in extra else before)
    except Exception as e:
        rlog(f"updater error: {type(e).__name__}: {e}"); rc = 1
    return rc, (prev[0] if prev else None), bool(prev)


def run_apply(ver, extra=()):
    """run_update for a schema 2 (Python-free) bundle: its own native jebctl does the gates and the swap; its updater is never loaded.

    CONTRACT between this Python follow (a release up to v1.5.x) and `desktop/bin/jebctl apply` of a schema 2 bundle:
      argv    <ver>/desktop/bin/jebctl apply <ver> --not-final --lock-held [--no-watch] [--gates-only] [--quick]
              <ver> is the unpacked, already verified bundle folder (versions/<tag>). --no-watch: no post-swap watch (sandbox / --no-agents).
              --gates-only: run the gates and stop before touching `current` or the app. --quick is always implied.
      env     inherited, plus JEB_HOME (the state folder); HOME, JEB_APP_DIR, JEB_LAUNCHAGENTS, JEB_RELEASE_BASE as set for the parent.
      lock    the parent holds JEB_HOME/release.lock (--lock-held): apply must not take it, nor wait for it.
      status  --not-final: apply writes the phase lines of JEB_HOME/update-status.json (source "release") but never the final one
              (phase "done"); the parent writes it from the exit code. apply logs to JEB_HOME/update.log as the updater does.
      swap    apply gates the bundle's app (smoke, headless start), points `current` at <ver> just before installing the app, installs it,
              watches it unless --no-watch. On ANY failure it restores everything itself: `current` back at the previous target, the
              previous app back; it never leaves `current` at <ver> when it exits non-zero. It does not delete <ver> (the parent does).
              It never touches release-state.json (the parent owns it) and never reloads LaunchAgents (the parent does).
      exit    0 installed and healthy; 2 rejected by a gate (never retried); 3 rolled back after the swap (never retried);
              anything else: error, retried later. Output goes to stdout/stderr, which the parent passes through.
    The parent returns (exit code, None, False): there is nothing for it to undo. As a safety net, when the child exits non-zero
    with `current` still at <ver>, the parent points it back at where it was."""
    before = os.path.realpath(LIVE) if os.path.lexists(LIVE) else None
    cmd = [os.path.join(ver, "desktop", "bin", "jebctl"), "apply", ver, "--not-final", "--lock-held"] + (["--no-watch"] if NO_AGENTS else []) + [x for x in extra if x in ("--gates-only", "--quick")]
    try:
        rc = subprocess.run(cmd, env=dict(os.environ, JEB_HOME=HOME)).returncode
    except OSError as e:
        rlog(f"apply error: {e}"); rc = 1
    if rc != 0 and before and os.path.lexists(LIVE) and os.path.realpath(LIVE) == os.path.realpath(ver) != before:
        rlog(f"apply left {LIVE} at {os.path.basename(ver)} (exit {rc}); putting it back")
        try:
            flip_current(before)
        except OSError as e:
            rlog(f"COULD NOT point {LIVE} back at {before}: {e}")
    return rc, None, False


def undo_flip(prev, new):
    """After a failed update: current goes back to prev, the new folder goes."""
    if prev:
        try:
            flip_current(prev)
        except OSError as e:
            rlog(f"COULD NOT point {LIVE} back at {prev}: {e}")
    shutil.rmtree(new, ignore_errors=True)


def new_tags(cur, skip):
    """Tags newer than cur (None: any) and not in skip, newest first, without the API: the latest release; only when that one is
    in skip, the older ones from the releases feed (a bad release cannot block the real ones). Raises jebhome.FetchError."""
    base = release_base()
    ok = lambda t: tag_key(t) and (cur is None or tag_key(t) > tag_key(cur)) and t not in skip
    latest = jebhome.latest_tag(base)
    return ([latest] if ok(latest) else []) if latest not in skip else [t for t in jebhome.feed_tags(base) if ok(t)]


def installed_tag():
    b = jebhome.read_bundle(LIVE) or BUNDLE or {}
    return b.get("tag")


def record_installed(rs, tag, u):
    rs.setdefault("installed", []).append({"tag": tag, "stamp": (u.load_state() or {}).get("stamp"), "at": int(time.time())})
    rs["installed"] = rs["installed"][-20:]


def ensure_plugin():
    """Release bundle, after an update (or when it is current): moves Jeb onto Claude Code's plugin system when it is not there yet (an
    install from before v1.5.0 that updated itself: its legacy CLAUDE_CODE_PLUGIN_DIRS entry goes once jeb@jeb is installed), else
    refreshes jeb@jeb only when its version differs from the mod's. Logged; never fails the follow."""
    try:
        _, plug, _ = plugdirs.info()
        if plugdirs.legacy_entries() or not plug:
            res = plugdirs.register(LIVE, DRY, rlog)
            rlog(f"plugin: registering {plugdirs.PLUGIN_ID}: {res}")
            return
        try:
            want = json.load(open(os.path.join(LIVE, "mod", ".claude-plugin", "plugin.json"))).get("version")
        except (OSError, ValueError):
            want = None
        if want and plug.get("version") != want and not plugdirs.sync(DRY, rlog):
            rlog("plugin: claude plugin update jeb@jeb did not run clean; run jebctl doctor")
    except (SystemExit, OSError, ValueError, subprocess.SubprocessError) as e:
        rlog(f"plugin: could not update Claude Code's plugin registration ({e})")


def follow_bundle(gates_only, u, S, quick=False):
    """follow for a release bundle: the newest published tag newer than the installed one, downloaded, signature-checked, gated, then
    `current` flipped before the swap. Every return writes the final status."""
    def stop(why, result="error"):
        S("done", why, result)
    prune_versions()        # the folder a previous run went on from
    if mode() != "release":
        rlog("follow: not in release mode; nothing to do"); stop("not in release mode"); return 0
    if os.path.exists(os.path.join(HOME, "updates-paused")):
        rlog("follow: updates are paused; skipping"); stop("updates are paused"); return 0
    if not os.path.isfile(SIGNERS):
        rlog(f"follow: no pinned release signers ({SIGNERS}); not updating"); stop("no pinned release signers"); return 0
    cur, rs = installed_tag(), load_rstate()
    if not cur or not tag_key(cur):
        rlog("follow: cannot tell which release is installed; skipping"); stop("cannot tell the installed release"); return 0
    if not rs.get("bridge_reset"):
        # v1.4.0 marked a newer tag failed for good when it only passed through (it could not read the new signers); a tag with no
        # recorded reason that is newer than the installed one gets another look, once
        lost = [t for t in rs.get("failed", []) if t not in (rs.get("failed_why") or {}) and tag_key(t) and tag_key(t) > tag_key(cur)]
        for t in lost:
            rs["failed"].remove(t)
        if lost:
            rlog(f"follow: giving {', '.join(lost)} another look (rejected without a recorded reason)")
        rs["bridge_reset"] = 1
        save_rstate(rs)
    if adopt_signers(rs, cur, os.path.join(LIVE, "desktop", "release-signers")):
        save_rstate(rs)
    heal_plists()
    S("checking GitHub")
    try:
        new = new_tags(cur, failed_skip(rs))
    except jebhome.FetchError as e:
        rlog(f"follow: {e}; will try again later"); stop("could not reach GitHub; will retry"); return 0
    rs["checked"] = int(time.time())
    save_rstate(rs)
    if not new:
        rlog(f"follow: {cur} is current"); ensure_plugin(); stop(f"{cur} is current", "up-to-date"); return 0
    if DRY:
        say(f"would download {new[0]} ({release_base()}), verify its signed manifest, run the gates, point {LIVE} at it, then remove {cur}")
        return 0
    tag = ver = None
    for t in new:       # newest first: a bogus far-future tag cannot block the real releases
        S(f"downloading {t}")
        path, err = fetch_bundle(t, rlog)
        if not err:
            tag, ver = t, path
            break
        why, permanent, kind = err
        if not permanent:
            rlog(f"follow: could not get {t}: {why}; will try again later")
            stop("app download failed; will retry"); return 0
        rlog(f"follow: {t} rejected ({kind}): {why}; " + ("it is retried when the pinned signers change" if kind == "signature" else "it will not be retried"))
        mark_failed(rs, t, kind)
        save_rstate(rs)
    if not tag:
        rlog(f"follow: no verified release newer than {cur}"); stop(f"no verified release newer than {cur}", "up-to-date"); return 0
    rc, prev, flipped = run_update(u, ver, flip_current, (["--gates-only"] if gates_only else []) + (["--quick"] if quick else []))
    if gates_only or rc != 0:
        if flipped:
            rlog(f"follow: {tag} failed after the switch (updater exit {rc}); back on {cur}")
        undo_flip(prev if flipped else None, ver)
    result = {0: "ok", 2: "rejected", 3: "rolled-back"}.get(rc, "error")
    if gates_only:
        result = "gates-" + result
    elif rc in (2, 3):
        mark_failed(rs, tag, "gates" if rc == 2 else "rolled-back")
        rlog(f"follow: {tag} {result}; it will not be retried")
    elif rc == 0:
        rlog(f"follow: now on {tag}")
        clear_failed(rs, tag)
        record_installed(rs, tag, u)
        rs["layout"] = "bundle"
        adopt_signers(rs, tag, os.path.join(ver, "desktop", "release-signers"))      # verified against the old pin and installed: its signers take over
        ensure_plugin()
    else:
        rlog(f"follow: {tag} not installed (updater exit {rc}); will try again later")
    rs["last"] = {"at": int(time.time()), "tag": tag, "result": result, "app": "prebuilt"}
    save_rstate(rs)
    last = u.load_state().get("last") or {}
    why = last.get("why") if (last.get("at") or 0) >= u._ST["started"] else None
    if gates_only:
        stop(f"{tag}: gates {'passed' if rc == 0 else 'failed'}; nothing installed", "up-to-date" if rc == 0 else "failed")
    elif rc == 0:
        stop(f"updated to {tag}", "updated")
    else:
        stop(f"{tag}: {why or 'see update.log'}", {2: "failed", 3: "rolled-back"}.get(rc, "error"))
    if rc == 0 and not gates_only:
        prune_now()
    for d in os.listdir(os.path.join(HOME, "staging")) if os.path.isdir(os.path.join(HOME, "staging")) else []:
        shutil.rmtree(os.path.join(HOME, "staging", d), ignore_errors=True)
    return 0 if rc in (0, 2, 3) else 1


def heal_plists():
    """Bundle release mode: LaunchAgent plists that differ from plists() (a v1.4.0 install names the bundle's Python) are rewritten
    in place and the agents reloaded once this run has exited. Needs the native launcher in place; skipped in dry runs and under --no-agents."""
    if not BUNDLE or DRY or NO_AGENTS or mode() != "release":
        return
    native = os.path.join(LIVE, "desktop", "bin", "jebctl")
    if not jebhome.macho_archs(native):
        return
    stale = []
    for label, want in plists("release").items():
        p = os.path.join(AGENTS, label + ".plist")
        try:
            have = plistlib.load(open(p, "rb"))
        except (OSError, ValueError, plistlib.InvalidFileException):
            continue        # not installed (or unreadable): not for this to create
        if have != want:
            stale.append(label)
    if not stale:
        return
    rlog(f"agents: {', '.join(stale)} name an older command; rewriting them to use {native}")
    write_plists(AGENTS, "release")
    spawn_reload()


def spawn_reload():
    """Reload the release-mode agents once this process has exited (a detached jebctl in a new session, so launchd does not take it
    down with follow). Under --no-agents or JEB_NO_LAUNCHCTL it only logs."""
    if NO_AGENTS or NO_LAUNCHCTL:
        rlog("convert: would reload the LaunchAgents once this run has exited (sandbox: skipped)")
        return
    err = open(os.path.join(HOME, "release.err"), "ab")
    subprocess.Popen([os.path.join(LIVE, "desktop", "bin", "jebctl"), "reload-agents", "--wait-pid", str(os.getpid())], env=scrubbed_env(), stdin=subprocess.DEVNULL, stdout=err, stderr=err, start_new_session=True)


def wait_pid(args):
    """Wait for --wait-pid to exit, at most 120 s. True once it is gone (or none was given)."""
    pid = int(args[args.index("--wait-pid") + 1]) if "--wait-pid" in args and args.index("--wait-pid") + 1 < len(args) else 0
    for _ in range(240 if pid else 0):
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return True
        except PermissionError:
            pass
        time.sleep(0.5)
    return not pid


def cmd_prune_versions(args):
    """Hidden: prune_versions once --wait-pid has exited; a process still running from an old folder keeps it for the next run."""
    if wait_pid(args):
        prune_versions()


def cmd_reload_agents(args):
    """Hidden: wait for --wait-pid to exit (at most 120 s), then bootout and bootstrap each release-mode LaunchAgent."""
    wait_pid(args)
    for l in labels_for("release"):
        if NO_AGENTS or NO_LAUNCHCTL:
            rlog(f"reload-agents: would reload {l} (sandbox: skipped)"); continue
        sh(["launchctl", "bootout", f"gui/{UID}/{l}"])
        r = subprocess.run(["launchctl", "bootstrap", f"gui/{UID}", os.path.join(AGENTS, l + ".plist")], capture_output=True, text=True)
        rlog(f"reload-agents: {l} " + ("reloaded" if r.returncode == 0 else f"bootstrap failed: {(r.stdout + r.stderr).strip()[:150]}"))
    return 0


def convert_clone(u, S, quick=False):
    """A git-clone install becomes a release bundle on its first release-mode follow: the newest published bundle is fetched and gated
    like an update, then the plists, the settings entry, the jebctl link and the agents move to ~/.jeb/current. The clone stays on
    disk (rs.legacy_clone). True when converted; False (logged) leaves everything as it was and the git follow runs."""
    rs = load_rstate()
    def no(why):
        rlog(f"convert: not converted ({why}); staying on the git clone")
        return False
    widen_signers(os.path.join(CODE, "release-signers"))
    try:
        tags = new_tags(None, rs.get("bundle_failed", []))
    except jebhome.FetchError as e:
        return no(str(e))
    if not tags:
        return no("no release to convert to")
    tag = tags[0]
    S(f"downloading {tag} (bundle)")
    ver, err = fetch_bundle(tag, rlog)
    if err:
        if err[1]:
            rs.setdefault("bundle_failed", []).append(tag)
            save_rstate(rs)
        return no(f"{tag}: {err[0]}")
    rc, prev, flipped = run_update(u, ver, flip_current, ["--quick"] if quick else [])
    if rc != 0:
        undo_flip(prev if flipped else None, ver)
        if rc in (2, 3):
            rs.setdefault("bundle_failed", []).append(tag)
            save_rstate(rs)
        return no(f"{tag} did not pass the gates (updater exit {rc})")
    adopt_signers(rs, tag, os.path.join(ver, "desktop", "release-signers"))
    py = os.path.join(LIVE, "python", "bin", "python3")
    live_ctl = os.path.join(LIVE, "desktop", "jebctl")
    subprocess.run([py, "-I", live_ctl, "plists"], env=scrubbed_env(), capture_output=True)       # the bundle's plists, written by the bundle's own code
    for l in labels_for("release"):
        try:
            shutil.copy2(os.path.join(HOME, "launchd", l + ".plist"), os.path.join(AGENTS, l + ".plist"))
        except OSError as e:
            rlog(f"convert: could not copy the {l} plist: {e}")
    rs.update({"layout": "bundle", "legacy_clone": CLONE, "legacy_mod": MOD})
    record_installed(rs, tag, u)
    rs["last"] = {"at": int(time.time()), "tag": tag, "result": "ok", "app": "prebuilt"}
    save_rstate(rs)
    try:
        res = plugdirs.register(LIVE, False, rlog, [MOD])      # the clone's CLAUDE_CODE_PLUGIN_DIRS entry goes once jeb@jeb is installed
        rlog(f"convert: plugin {plugdirs.PLUGIN_ID}: {res}")
    except (SystemExit, OSError, ValueError) as e:
        rlog(f"convert: could not update the plugin registration ({e}); open Claude Code sessions keep the old path")
    if link_state(os.path.join(LIVE, "desktop", "bin", "jebctl")) in ("ours", "older"):
        link_jebctl(os.path.join(LIVE, "desktop", "bin", "jebctl"))
    spawn_reload()
    rlog(f"convert: now a release bundle at {tag}; the old clone {CLONE} is no longer used and can be deleted")
    S("done", f"updated to {tag}", "updated")
    return True


ROLLBACK_FLOOR = (1, 5, 0)


def rollback_bundle():
    """Put the previous good release back: it is downloaded again (only one version is kept on disk), gated, and flipped to; the bad
    one is deleted. When the download fails nothing changes."""
    rs, cur = load_rstate(), installed_tag()
    prev = next((e["tag"] for e in reversed(rs.get("installed", [])) if e.get("tag") != cur and e.get("tag") not in rs.get("failed", [])), None)
    if not prev:
        raise SystemExit("no earlier release is recorded to roll back to")
    if tag_key(prev) < ROLLBACK_FLOOR:
        raise SystemExit(f"{prev} is older than v{'.'.join(map(str, ROLLBACK_FLOOR))}, the oldest release this one can roll back to (older ones predate the key rotation and the Python-free update path); {cur} stays installed.")
    if DRY:
        say(f"would roll back {cur} -> {prev}: download {prev} again, gate it and point {LIVE} at it (dry run: nothing changed)")
        return
    lock = open(os.path.join(HOME, "release.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit("an update is running; try again in a few minutes")
    say(f"rolling back {cur} -> {prev}: downloading {prev} again")
    ver, err = fetch_bundle(prev, say)
    if err:
        raise SystemExit(f"could not download {prev}: {err[0]}\nNothing was changed; {cur} is still installed.")
    u = load_updater()
    u.set_home(HOME)
    u.STATUS_SOURCE = "release"
    old = os.path.realpath(LIVE)
    rc, back, flipped = run_update(u, ver, flip_current, [])
    if rc != 0:
        undo_flip(back if flipped else None, ver)
        raise SystemExit(f"{prev} failed (updater exit {rc}); {cur} is still installed. See {u.LOG}")
    if cur:
        mark_failed(rs, cur, "rolled-back")
    record_installed(rs, prev, u)
    rs["last"] = {"at": int(time.time()), "tag": prev, "result": "rolled-back-manually", "app": "prebuilt"}
    save_rstate(rs)
    prune_now()
    say(f"rolled back {cur} -> {prev}; the running app hands over within a few seconds")


CC_RE = re.compile(r"(\w+)(?:\([^)]*\))?(!)?:\s*(.+)")    # Conventional Commits subject: type(scope)!: text
NOTE_GROUPS = [("breaking", "Breaking changes"), ("feat", "Features"), ("fix", "Fixes"), ("perf", "Performance"), ("revert", "Reverts")]


def release_plan(last):
    """(level or None, notes markdown) from the Conventional Commits since tag `last` (release-please rules):
    a `!` or a BREAKING CHANGE footer is major, feat is minor, fix/perf/revert are patch, anything else none."""
    out = git("log", "--no-merges", "--format=%h%x00%s%x00%b%x1e", f"{last}..HEAD").stdout
    groups, level = {k: [] for k, _ in NOTE_GROUPS}, None
    rank = {"patch": 1, "minor": 2, "major": 3}
    for entry in filter(None, (e.strip("\n") for e in out.split("\x1e"))):
        sha, subject, body = (entry.split("\x00") + ["", ""])[:3]
        m = CC_RE.fullmatch(subject.strip())
        if not m:
            continue
        kind, bang, text = m.group(1).lower(), m.group(2), m.group(3)
        footer = re.search(r"^BREAKING[ -]CHANGE:\s*(.+)", body, re.M)
        breaking = bool(bang or footer)
        this = "major" if breaking else {"feat": "minor", "fix": "patch", "perf": "patch", "revert": "patch"}.get(kind)
        if this and (not level or rank[this] > rank[level]):
            level = this
        if breaking:
            groups["breaking"].append(f"- {footer.group(1).strip() if footer else text} ({sha})")
        if kind in groups:
            groups[kind].append(f"- {text} ({sha})")
    notes = "\n\n".join(f"### {title}\n\n" + "\n".join(groups[k]) for k, title in NOTE_GROUPS if groups[k])
    return level, notes


def cmd_release(args):
    """Ctrl-C stops it cleanly; what it says depends on how far it got."""
    if BUNDLE or not os.path.exists(os.path.join(CLONE, ".git")):
        raise SystemExit("releases are cut from a development clone with ./release")
    done = []
    try:
        release_steps(args, done)
    except KeyboardInterrupt:
        print(flush=True)
        if "commit" in done:
            raise SystemExit("release: stopped after the release commit, before the tag; run it again to tag it")
        raise SystemExit("release: stopped; nothing was written")


def check_signer_const():
    """The signers the native jebctl pins (signerLines in desktop/cli/main.swift) must be exactly the (principal, key type, key) of the
    desktop/release-signers lines that cover jeb-release, and each must carry namespaces="jeb-release" and nothing else."""
    bad = SystemExit("the signers in desktop/cli/main.swift (signerLines) are not the jeb-release lines of desktop/release-signers; fix one of them, no tag")
    m = re.search(r"^let signerLines = \[\n(.*?)^\]", open(os.path.join(CODE, "cli", "main.swift")).read(), re.M | re.S)
    const = set()
    for l in (m.group(1).splitlines() if m else []):
        if not l.strip() or l.strip().startswith("//"):
            continue
        q = re.fullmatch(r'\s*"((?:[^"\\]|\\.)*)",?\s*', l)
        t = re.sub(r"\\(.)", r"\1", q.group(1)).split() if q else []
        if len(t) != 4 or t[1] != 'namespaces="jeb-release"':
            raise bad
        const.add((t[0], t[2], t[3]))
    want = set()
    for l in open(os.path.join(CODE, "release-signers")).read().splitlines():
        k, t = key_line(l), l.split()
        if k and k[1] and "jeb-release" in k[1][1]:
            i = next(n for n, x in enumerate(t) if n and x.startswith(("ssh-", "ecdsa-", "sk-")))
            want.add((t[0], t[i], t[i + 1]))
    if not const or const != want:
        raise bad


def release_steps(args, done):
    if git("rev-parse", "--git-dir").returncode != 0:
        raise SystemExit("not a git clone: " + CLONE)
    if git("status", "--porcelain").stdout.strip():
        raise SystemExit("the tree is not clean (commit or stash first)")
    base = base_branch()
    if not git("config", "--get", "user.signingkey").stdout.strip():
        raise SystemExit("no signing key configured: releases are signed tags. Set user.signingkey (and `git config gpg.format ssh` for an SSH key), then run again")
    cur = git("branch", "--show-current").stdout.strip()
    if cur != base:
        raise SystemExit(f"releases are cut from {base}; this clone is on {cur or 'a detached HEAD'}")
    bump = "auto"
    if "--bump" in args:
        i = args.index("--bump") + 1
        bump = args[i] if i < len(args) else ""
    if bump not in ("auto", "patch", "minor", "major"):
        raise SystemExit("--bump takes auto, patch, minor or major")
    if release_tags("--points-at", "HEAD"):
        raise SystemExit("HEAD already carries a release tag: " + ", ".join(release_tags("--points-at", "HEAD")))
    try:
        file_version = json.load(open(PLUGIN_JSON)).get("version")
    except (OSError, ValueError, AttributeError) as e:
        raise SystemExit(f"cannot read {PLUGIN_JSON}: {e}")
    tags = release_tags()
    last = tags[-1] if tags else None
    if not last:
        version, notes = INITIAL_VERSION, "First release."
        say(f"no release tag yet: starting at {version}" + ("" if bump == "auto" else f" (--bump {bump} applies from the next release)"))
    else:
        level, notes = release_plan(last)
        if bump == "auto":
            if not level:
                raise SystemExit(f"no feat, fix, perf, revert or breaking commits since {last}, so nothing to release "
                                 "(commit subjects follow Conventional Commits; pass patch, minor or major to release anyway)")
            say(f"bump: {level} (from the commits since {last})")
            bump = level
        else:
            say(f"bump: {bump} (forced)")
        major, minor, patch = tag_key(last)
        major, minor, patch = {"major": (major + 1, 0, 0), "minor": (major, minor + 1, 0), "patch": (major, minor, patch + 1)}[bump]
        version = f"{major}.{minor}.{patch}"
    tag = f"v{version}"
    say(f"releasing {tag}" + (f" (last release {last})" if last else " (first release)"))
    check_signer_const()
    step("validate plugin", ["claude", "plugin", "validate", "mod"], cwd=CLONE)
    step("validate marketplace", ["claude", "plugin", "validate", "."], cwd=CLONE)
    step("test plugin", ["claude", "plugin", "test", "mod"], cwd=CLONE)
    step("release build", ["./build.sh"], cwd=SRC, env=dict(os.environ, JEB_OUT="JebDesktop.dev", JEB_UNIVERSAL="1"))
    if "--parity" in args:
        if DRY:
            say("  parity: skipped (dry run)")
        else:
            # on a snapshot, so the tracked fixtures stay untouched
            print("  parity ...", end=" ", flush=True)
            u = load_updater()
            snap = os.path.join(HOME, "build", "release-check")
            shutil.rmtree(snap, ignore_errors=True)
            os.makedirs(os.path.dirname(snap), exist_ok=True)
            try:
                u.snapshot(SRC, snap)
                shutil.copy2(os.path.join(SRC, "JebDesktop.dev"), snap)
                why = u.build_tools(snap)
                if why:
                    say("failed")
                    raise SystemExit("could not build the parity helpers: " + why)
                ok, why = u.gate_parity(snap)
            finally:
                shutil.rmtree(snap, ignore_errors=True)
            say(f"{'ok' if ok else 'failed'} ({why})")
            if not ok:
                raise SystemExit("parity gate failed; no tag")
    if version != file_version:
        if not DRY:
            text = open(PLUGIN_JSON).read()
            new = re.sub(r'("version"\s*:\s*")[^"]*(")', lambda m: m.group(1) + version + m.group(2), text, count=1)
            if json.loads(new).get("version") != version:
                raise SystemExit(f"could not write the version into {PLUGIN_JSON}; no commit, no tag")
            with open(PLUGIN_JSON, "w") as f:
                f.write(new)
        step(f"commit chore(release): {tag}", ["git", "-C", CLONE, "commit", "-q", "-m", f"chore(release): {tag}", "--", PLUGIN_JSON])
        done.append("commit")
    name = app_name(tag)
    if DRY:
        say(f"  app zip: skipped (dry run); would attach {name}")
        message = f"Jeb {tag}"
    else:
        adir = os.path.join(CLONE, git("rev-parse", "--git-path", f"jeb-release-{tag}").stdout.strip())
        shutil.rmtree(adir, ignore_errors=True)
        os.makedirs(adir)
        stage = os.path.join(adir, "stage")        # the zip holds JebDesktop and the gate helpers, no parent folder
        os.makedirs(stage)
        shutil.copy2(os.path.join(SRC, "JebDesktop.dev"), os.path.join(stage, "JebDesktop"))
        print("  gate helpers (universal) ...", end=" ", flush=True)
        t = time.time()
        why = load_updater().build_universal_tools(SRC, stage)
        if why:
            say("failed")
            raise SystemExit("could not build the gate helpers: " + why)
        say(f"ok ({time.time() - t:.0f}s)")
        zp = os.path.join(adir, name)
        step("app zip", ["ditto", "-c", "-k", stage, zp])
        h = hashlib.sha256()
        with open(zp, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        message = f"Jeb {tag}\n\napp-sha256: {h.hexdigest()} {name}"
        # after the zip, so the older app zip stays as it was; the stage folder is what ./release builds the bundles from
        step("jebctl (universal)", ["./build.sh"], cwd=os.path.join(CODE, "cli"), env=dict(os.environ, JEB_UNIVERSAL="1", JEB_OUT=os.path.join(stage, "jebctl"), JEB_VERSION=tag))
        step("jebctl signature", ["codesign", "--verify", os.path.join(stage, "jebctl")])
    step(f"sign tag {tag}" + ("" if os.environ.get("JEB_RELEASE_WRAPPED") else " (asks for the key's passphrase)"),["git", "-C", CLONE, "tag", "-s", tag, "-m", message], tty=True)
    notes = notes or "Maintenance release."
    if DRY:
        say("release notes:\n" + notes)
    else:
        path = os.path.join(CLONE, git("rev-parse", "--git-path", f"jeb-release-notes-{tag}.md").stdout.strip())
        with open(path, "w") as f:
            f.write(notes + "\n")
    if not os.environ.get("JEB_RELEASE_WRAPPED"):
        say(f"{'would tag' if DRY else 'tagged'} {tag} (local only; never pushed by jebctl). To publish it, run:\n  git push origin {base} {tag}")


def cmd_rollback():
    if BUNDLE:
        return rollback_bundle()
    u = load_updater()
    vs = sorted((d for d in os.listdir(VERSIONS) if d.endswith(".app")), reverse=True) if os.path.isdir(VERSIONS) else []
    if not vs:
        raise SystemExit("no saved version")
    bad = u.bundle_stamp(APP)
    old = vs[0][:-4]
    u.restore_bundle(old, APP_DIR, VERSIONS)
    st = u.load_state()
    if st.get("built"):
        st.setdefault("rejected", []).append(st["built"])
    st["built"], st["stamp"] = None, old
    u.record(st, "manual-rollback", f"from {bad} to {old}", old)
    say(f"rolled back {bad} -> {old}; the running app hands over within a few seconds")


UPDATE_WAIT, UPDATE_POLL = 30 * 60, 2       # seconds: how long `update` waits for the final result, and how often it looks


def read_update_status():
    try:
        d = json.load(open(os.path.join(HOME, "update-status.json")))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def cmd_update():
    """Check for a release now and wait for the result; the release agent does the work in its own environment."""
    if mode() != "release":
        say("a development install ships from the working tree; running the updater now" if not DRY else "a development install ships from the working tree; would run the updater now")
        if DRY:
            return 0
        return subprocess.run(RUN + [os.path.join(CODE, "updater.py"), "--now"], env=dict(os.environ, JEB_HOME=HOME, JEB_MOD=MOD, JEB_APP_DIR=APP_DIR)).returncode
    if os.path.exists(os.path.join(HOME, "updates-paused")):
        say("updates are paused; run: jebctl resume-updates")
        return 1
    if DRY:
        say("would start the release agent (launchctl kickstart com.jeb.desktop.release) and wait up to 30 minutes for its result")
        return 0
    t0 = int(time.time())
    os.makedirs(HOME, mode=0o700, exist_ok=True)
    click = os.path.join(HOME, "check-now")
    open(click, "w").close()        # the menu's click: the agent skips the quiet wait for it
    r = subprocess.run(["launchctl", "kickstart", f"gui/{UID}/com.jeb.desktop.release"], capture_output=True)
    if r.returncode != 0:
        try:
            os.unlink(click)
        except OSError:
            pass
        say("the release agent is not loaded; run the install again (or ask Claude to repair Jeb)")
        return 1
    say("checking for a new release")
    seen, deadline = None, time.time() + UPDATE_WAIT
    while time.time() < deadline:
        d = read_update_status()
        if (d.get("at") or 0) >= t0:
            if d.get("phase") == "done":
                res, why = d.get("result"), d.get("detail") or ""
                say(why or str(res))
                return 0 if res in ("updated", "up-to-date") else 1
            key = (d.get("phase"), d.get("detail"), d.get("step"))
            if key != seen and d.get("phase"):
                seen = key
                n = f" ({d['step']}/{d['steps']})" if d.get("step") and d.get("steps") else ""
                say(str(d["phase"]) + n + (f": {d['detail']}" if d.get("detail") else ""))
        time.sleep(UPDATE_POLL)
    say("still running; see jebctl status")
    return 1


def cmd_start():
    q = os.path.join(HOME, "quit")
    if os.path.exists(q):
        os.unlink(q)
    if running():
        say("already running"); return
    sh(["launchctl", "kickstart", f"gui/{UID}/com.jeb.desktop"])


def cmd_quit():
    write_quit_marker()
    terminate_all()
    say("quit; `jebctl start` (or the next login) brings it back")


def check_sandbox(cmd):
    """--no-agents skips every LaunchAgent and launchctl step, so it only runs where HOME is not the real home and
    the app, agents and state folder all sit under it. Returns the reason to refuse, or None."""
    me, real = os.path.realpath(os.path.expanduser("~")), os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir)
    if cmd not in ("install", "follow", "reload-agents", "rollback"):
        return "--no-agents is for `install`, `follow`, `reload-agents` and `rollback` only"
    if me == real:
        return f"--no-agents needs a HOME other than the real one ({real}); it exists for sandboxes (./release smoke)"
    for what, p in (("JEB_APP_DIR", APP_DIR), ("JEB_LAUNCHAGENTS", AGENTS), ("the state folder", HOME)):
        if os.path.commonpath([os.path.realpath(p), me]) != me:
            return f"--no-agents: {what} ({p}) is outside the sandbox HOME {me}"
    return None


def main(argv):
    global DRY, VERBOSE
    args = [a for a in argv if a not in ("--dry-run", "--verbose")]
    DRY = "--dry-run" in argv
    cmd = args[0] if args else "status"
    if NO_AGENTS:
        why = check_sandbox(cmd)
        if why:
            raise SystemExit("jebctl: " + why)
    VERBOSE = "--verbose" in argv or cmd not in ("install", "uninstall")
    if cmd == "status": cmd_status()
    elif cmd == "doctor": return cmd_doctor()
    elif cmd == "migrate": cmd_migrate()
    elif cmd == "plists": cmd_plists()
    elif cmd == "perf": cmd_perf(args[1:])
    elif cmd == "install": cmd_install(args[1:])
    elif cmd == "follow": return cmd_follow(args[1:])
    elif cmd == "reload-agents": return cmd_reload_agents(args[1:])
    elif cmd == "prune-versions": cmd_prune_versions(args[1:])
    elif cmd == "watchdog":     # what the watchdog agent runs through the native launcher; becomes the bundle's Python on watchdog.py
        os.execv(RUN[0], RUN + [os.path.join(CODE, "watchdog.py")] + args[1:])
    elif cmd == "release": cmd_release(args[1:])
    elif cmd == "uninstall" and any(a in args for a in ("--remove-files", "--remove-clone", "--purge-farm")):
        return subprocess.run(RUN + [os.path.join(CLONE, "uninstall")] + argv[1:]).returncode      # the script does the whole removal
    elif cmd == "uninstall": cmd_uninstall("--purge" in args)
    elif cmd == "rollback": cmd_rollback()
    elif cmd == "screenshot": return cmd_screenshot(args[1:])
    elif cmd == "emoji": return cmd_emoji(args[1:])
    elif cmd == "pause-updates":
        open(os.path.join(HOME, "updates-paused"), "w").close(); say("updates paused")
    elif cmd == "resume-updates":
        p = os.path.join(HOME, "updates-paused")
        os.path.exists(p) and os.unlink(p); say("updates on")
    elif cmd == "start": cmd_start()
    elif cmd == "quit": cmd_quit()
    elif cmd in ("update", "update-now"): return cmd_update()
    elif cmd == "retry-update" and BUNDLE:
        rs = load_rstate()
        if rs.get("failed"):
            clear_failed(rs, max(rs["failed"], key=lambda t: tag_key(t) or (0, 0, 0)))
            save_rstate(rs)
        sys.exit(subprocess.run(["launchctl", "kickstart", "-k", f"gui/{UID}/com.jeb.desktop.release"]).returncode)
    elif cmd == "retry-update":
        sys.exit(subprocess.run(RUN + [os.path.join(CODE, "updater.py"), "--force"], env=dict(os.environ, JEB_HOME=HOME, JEB_MOD=MOD, JEB_APP_DIR=APP_DIR)).returncode)
    else:
        say(__doc__); return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
