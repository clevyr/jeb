def cmd_install(args):
    try:
        install_steps(args)
    except SystemExit:
        if OPEN:
            fin("failed")       # the message follows
        raise


def install_steps(args):
    migrate_home()      # first: everything below reads and writes the state folder
    m = mode()
    if "--mode" in args:
        try:
            m = args[args.index("--mode") + 1]
        except IndexError:
            m = ""
        if m not in ("dev", "release"):
            raise SystemExit("usage: jebctl install [--mode dev|release] [--repin] [--add-path] [--no-agents] [--dry-run] [--verbose]")
    detail(f"mode: {m}")
    back = None
    if m == "release":
        pin_signers("--repin" in args)        # from the cloned checkout, before any tag is looked at
        back = select_release()
    lead("app")
    app, pre, tag = None, [], None
    if m == "release" and os.path.isfile(SIGNERS):
        on = head_tags()
        if on and verify_tag(on[-1], base_branch())[1] is None:
            tag = on[-1]
            why = []
            if DRY:
                detail(f"app: would use {app_name(on[-1])} from the release in place of the compile when its hash matches the app-sha256 line in the tag; else the compile")
            else:
                app = fetch_app(tag, lambda m: (why.append(m), detail(m)))
                pre = ["--prebuilt", app] if app else []
                if SMOKE_TAG and not app:       # a smoke run exists to prove the prebuilt path; no silent compile
                    raise SystemExit("the release's prebuilt app was not used (it would have been built from source): " + (why[-1] if why else "no reason logged"))
    detail("1. first build through the updater (compile, smoke, headless start)")
    t0 = time.time()
    if DRY:
        detail(f"$ python3 -I {CODE}/updater.py --force --no-watch --quick")
    else:
        r = subprocess.run(["/usr/bin/python3", "-I", os.path.join(CODE, "updater.py"), "--force", "--no-watch", "--quick"] + pre, env=dict(os.environ, JEB_HOME=HOME, JEB_MOD=MOD, JEB_APP_DIR=APP_DIR), **({} if VERBOSE else {"capture_output": True, "text": True}))
        if app:
            shutil.rmtree(os.path.dirname(os.path.dirname(app)), ignore_errors=True)
        if r.returncode != 0 or not os.path.isdir(APP):
            tail = open(os.path.join(HOME, "update.log")).read().splitlines()[-6:] if os.path.exists(os.path.join(HOME, "update.log")) else []
            if not tail and not VERBOSE:
                tail = (r.stdout + r.stderr).strip().splitlines()[-6:]
            if back:
                g = git("checkout", "--detach", back)
                tail.append(f"back on the cloned commit {back[:12]}" if g.returncode == 0 else f"COULD NOT go back to {back[:12]}: {g.stderr.strip()[:200]}")
            raise SystemExit("a gate failed; nothing installed.\n" + "\n".join(tail))
