    fs, store_of = fixtures()
    f = next((x for x in fs if x["name"] == name), None)
    if f is None:
        say(f"screenshot: no fixture {name!r} (`jebctl screenshot --list`)")
        return 1
    exe = os.path.abspath(os.environ.get("JEB_BIN") or EXE)
    if not os.access(exe, os.X_OK):
        say(f"screenshot: no binary at {exe}")
        return 1
    dest = os.path.join(os.path.abspath(out or "."), name + ".png")
    say(f"render fixture {name} with {exe} to {dest}")
    if DRY:
        return 0
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = tempfile.mkdtemp(prefix="jeb-shot-")
    try:
        store = os.path.join(tmp, "store.json")
        json.dump(store_of(f)[0], open(store, "w"))
        env = dict(os.environ, JEB_BENCH="0.01", JEB_BENCH_FREEZE="1", JEB_BENCH_SCALE="1", JEB_BENCH_PNG=dest, JEB_STORE_PATH=store, JEB_HOME=tmp,
                   JEB_HEARTBEAT_DIR=os.path.join(tmp, "heartbeat"), JEB_MOD=MOD, JEB_NOW=str(f["now"]), JEB_PLACE=f["place"], **f["env"])
