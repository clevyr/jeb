def screenshot_live():
    procs = running()
    if len(procs) != 1:
        say(f"screenshot: need exactly one running JebDesktop, found {len(procs)}")
        return 1
    pid, _, path = procs[0]
    if beat_files().get(pid, (0, False))[1]:
        say(f"screenshot: pid {pid} is still waiting to take over; try again in a moment")
        return 1
    try:
        has = b"screenshot-last" in open(path, "rb").read()
    except OSError:
        has = False
    if not has:  # an older build has no SIGUSR2 handler, and the signal would end it
        say(f"screenshot: pid {pid} runs a build without screenshots (not signalled); it will after the next update")
        return 1
    last = os.path.join(HOME, "screenshot-last")
    say(f"signal pid {pid} (SIGUSR2) and wait up to 10 s for {last}")
    if DRY:
        return 0
    t0 = time.time()
    os.kill(pid, signal.SIGUSR2)
    while time.time() - t0 < 10:
        try:
            if os.path.getmtime(last) > t0:
                say(open(last).read().strip())
                return 0
        except OSError:
            pass
        time.sleep(0.1)
    say("screenshot: no answer within 10 s (see the app's log for `signal: screenshot failed`)")
    return 1


def screenshot_fixture(name, out, hour):
