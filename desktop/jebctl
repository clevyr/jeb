def release_line():
    m = mode()
    on = release_tags("--points-at", "HEAD")
    cur = on[-1] if on else ("branch " + (git("branch", "--show-current").stdout.strip() or "?") if git("symbolic-ref", "-q", "HEAD").returncode == 0 else "no release tag (detached)")
    rs = load_rstate()
    last = rs.get("last")
    head = f"mode: {m}; clone at {cur}"
    if m == "dev":
        return head + " (local src edits ship through the gates; no release agent)"
    chk = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(rs["checked"])) if rs.get("checked") else "never"
    return head + f"; signers {'pinned' if os.path.isfile(SIGNERS) else 'NOT pinned (no updates)'}; last release check {chk}" + (f", last result {last['result']} {last['tag']}" if last else "") + (f"; failed tags: {', '.join(rs['failed'])}" if rs.get("failed") else "")


