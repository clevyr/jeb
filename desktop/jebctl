#!/usr/bin/python3 -I
"""jebctl: install, supervise and update the desktop (phase 6). Exactly one JebDesktop at all times.

  status                  process, stamp, heartbeat age, last update result, versions
  migrate                 move the state folder from ~/.claude/jeb-desktop to ~/Library/Application Support/Jeb
                          (install, follow and the updater do this on their own; the old path stays as a link)
  doctor                  read-only health check: one line per check (ok / FIX with the fix), exit 1 on a problem
                          (JEB_NO_LAUNCHCTL=1 skips the launchctl queries: `skipped (sandbox)`)
  install [--mode dev|release] [--repin] [--add-path] [--no-agents] [--dry-run] [--verbose]
                          one short line per step (--verbose: every command and detail). First build through
                          the updater's compile, smoke and start gates (refuses if one fails; updates and
                          releases keep all gates), the
                          LaunchAgents, hand over from a run-live.sh instance, then bootstrap. Mode is
                          stored in JEB_HOME/install-mode (default: the stored one, else dev).
                          dev: the update agent ships local src edits through the gates.
                          release: no update agent; com.jeb.desktop.release runs `follow` every 6 h.
                          Release mode pins the signers: desktop/release-signers (ssh allowed_signers
                          format, in the repo) is copied to JEB_HOME/release-signers (0600) when that file
                          does not exist yet (trust on first install), from the cloned checkout before any
                          tag is looked at. Then tags are fetched and the clone moves to the newest verified
                          tag (signed by a pinned signer, commit on origin's default branch); with no signer or
                          no verified tag it stays on the cloned commit. --repin replaces the pin (key rotation).
                          The release's prebuilt app is used in place of the compile when it checks out
                          (see follow); every gate still runs.
                          Last, `jebctl` is linked into ~/.local/bin (JEB_BIN_DIR). When that folder is not on
                          PATH: --add-path adds it to the shell profile (zsh ~/.zprofile, bash ~/.bash_profile,
                          else ~/.profile; JEB_PROFILE; backup first); without it a terminal asks, else the
                          line to add is printed. A different file already at that path is left alone.
                          --no-agents (sandbox only, used by ./release smoke): everything above up to the install-mode file and
                          the plists in JEB_HOME/launchd, but no hand-over, no copy into LaunchAgents, no launchctl,
                          no wait for the desktop, no jebctl link (each prints `skipped (--no-agents)`). Refused
                          unless HOME differs from the account's real home and the app, LaunchAgents and state
                          folders are under HOME. JEB_CLONE (honoured only with --no-agents, and by `doctor` when
                          JEB_NO_LAUNCHCTL=1) runs on that clone instead of this script's: its mod, updater and
                          release-signers are used, this script's install logic. JEB_SMOKE_TAG selects that tag
                          instead of the newest verified one (it must verify; a pre-release vX.Y.Z-rc.N tag needs
                          JEB_ALLOW_RC=1), and with it the release's prebuilt app is mandatory: no prebuilt, no
                          compile, the install fails with the reason.
  uninstall [--purge] [--dry-run] [--verbose]
                          one short line per step (--verbose: every command and detail). Bootout, remove the
                          plists and the app; versions and logs stay unless --purge (removes everything in JEB_HOME);
                          also the ~/.local/bin/jebctl link (only if it points here) and the PATH lines install added
  follow [--gates-only] [--dry-run]
                          release mode: fetch tags, then take the newest unseen v* tag that is signed by a
                          pinned signer (JEB_HOME/release-signers; none pinned: nothing happens) and whose
                          commit is on origin's default branch; any other candidate is recorded as failed
                          and the next older one is tried. The commit is pinned by SHA: git archive into
                          JEB_HOME/staging/<tag>/, the updater's gates against the staged src and mod,
                          only on a pass check the SHA out here and install the build, watch it, roll back
                          (checkout of the previous SHA and bundle) on failure. Skips if the clone is dirty
                          or not on a v* tag. --gates-only stops after the gates. Log: JEB_HOME/release.log
                          The release's app (JebDesktop-<tag>-macos.zip, a universal binary) is downloaded with
                          gh and used in place of the compile only when its SHA-256 equals the app-sha256 line
                          in the signed tag message and it holds this Mac's architecture; anything else (no
                          line, no gh, no asset, a mismatch) builds from source as before. The gates run on it.
  release [--bump auto|patch|minor|major] [--parity] [--dry-run]
                          owner side: the clone is clean and on the default branch, a signing key is
                          configured (user.signingkey), then `claude plugin validate mod`, `claude plugin
                          test mod`, a universal release build (and the parity gate with --parity on that
                          same binary), then a local signed tag v<version> whose message carries the SHA-256
                          of the app zip (JebDesktop-<tag>-macos.zip, written to .git/jeb-release-<tag>/ for
                          ./release to attach). The version comes from the tags, as release-please does: no tag yet is
                          1.0.0; else the last tag raised by --bump (default auto: the level from the
                          Conventional Commits since it; refuses when none is releasable). Only once every
                          check has passed is it written to mod/.claude-plugin/plugin.json and committed
                          ("chore(release): v<version>") before tagging. Release notes from the same commits go
                          to .git/jeb-release-notes-<tag>.md. Prints the push command; never pushes
  rollback                put the newest saved version back (the running app hands over by itself)
  screenshot [--dry-run]  save what the running app draws (SIGUSR2; one PNG per screen into ~/Pictures/Jeb, or
                          JEB_SHOT_DIR) and print the paths (from JEB_HOME/screenshot-last). Needs exactly one
                          running JebDesktop whose build has it; waits up to 10 s
  screenshot --fixture NAME [--out DIR] [--hour H]
                          headless, never touches the running app: the parity fixture NAME rendered by the
                          installed binary (JEB_BIN overrides) with the bench, to <DIR>/NAME.png (default: the
                          current directory); --hour fixes the hour of day. screenshot --list: the fixture names
  pause-updates | resume-updates
  start | quit            quit writes the marker the watchdog honours; start clears it
  update-now              the updater without the 60 s debounce (still gated)
  retry-update            the updater with --force: build the current src again even if that build was
                          rejected or updates are paused, through every gate; ships only if all pass
  plists                  (re)write the LaunchAgent plists into launchd/ only
  perf [--days N] [--stamp S]
                          the watchdog's telemetry (telemetry/*.csv, a row per ~30 s): per stamp and class
                          (calm, passing, covered, ...) the samples, median and p95 CPU %, max RSS and
                          footprint, flagged OVER past the targets (median CPU: calm 0.5, passing 4,
                          covered 0.1; RSS 60 MB; footprint 120 MB). Default: the last day, all stamps

JEB_HOME (state root), JEB_SRC (the app source, default src/ beside this script), JEB_APP_DIR (default
~/Applications), JEB_LAUNCHAGENTS (default ~/Library/LaunchAgents), JEB_BIN_DIR (default ~/.local/bin), JEB_PROFILE and
JEB_BACKUPS override the defaults, mostly for tests.
The mod path rendered into the plists (JEB_MOD) is mod/ beside desktop/, from this script's own location.
"""
import fcntl, glob, hashlib, importlib.util, json, os, plistlib, pwd, re, shutil, signal, subprocess, sys, tarfile, time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import jebhome

HOME = jebhome.resolve()
APP_DIR = os.environ.get("JEB_APP_DIR") or os.path.expanduser("~/Applications")
AGENTS = os.environ.get("JEB_LAUNCHAGENTS") or os.path.expanduser("~/Library/LaunchAgents")
APP = os.path.join(APP_DIR, "JebDesktop.app")
EXE = os.path.join(APP, "Contents", "MacOS", "JebDesktop")
CODE = os.path.dirname(os.path.realpath(__file__))      # realpath: `jebctl` may run through the ~/.local/bin link
CLONE = os.path.dirname(CODE)
MOD = os.path.join(CLONE, "mod")
SRC = os.environ.get("JEB_SRC") or os.path.join(CODE, "src")
# Sandbox only (./release smoke): --no-agents, no LaunchAgent, launchctl or PATH step; JEB_CLONE then names the clone to run on
NO_AGENTS = "--no-agents" in sys.argv[1:]
SMOKE_TAG = (os.environ.get("JEB_SMOKE_TAG") or None) if NO_AGENTS else None
if os.environ.get("JEB_CLONE") and (NO_AGENTS or (sys.argv[1:2] == ["doctor"] and os.environ.get("JEB_NO_LAUNCHCTL") == "1")):
    CLONE = os.path.realpath(os.environ["JEB_CLONE"])
    CODE = os.path.join(CLONE, "desktop")
    MOD = os.path.join(CLONE, "mod")
    SRC = os.environ.get("JEB_SRC") or os.path.join(CODE, "src")
ALL_LABELS = ("com.jeb.desktop", "com.jeb.desktop.watchdog", "com.jeb.desktop.update", "com.jeb.desktop.release")
VERSIONS = MODE_FILE = RELEASE_STATE = RELEASE_LOG = SIGNERS = None


def set_home(home):
    """(Re)derive the paths that hang off the state folder; called at import and after a migration."""
    global HOME, VERSIONS, MODE_FILE, RELEASE_STATE, RELEASE_LOG, SIGNERS
    HOME = home
    VERSIONS = os.path.join(HOME, "versions")
    MODE_FILE = os.path.join(HOME, "install-mode")
    RELEASE_STATE = os.path.join(HOME, "release-state.json")
    RELEASE_LOG = os.path.join(HOME, "release.log")
    SIGNERS = os.path.join(HOME, "release-signers")         # pinned at install; follow trusts no other key


set_home(HOME)
REPO_SIGNERS = os.path.join(CODE, "release-signers")        # shipped in the repo (ssh allowed_signers format)
TAG_RE = re.compile(r"v(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)")    # SemVer releases; pre-release tags are never followed
PLUGIN_JSON = os.path.join(MOD, ".claude-plugin", "plugin.json")   # the release writes its "version"; tags are the source
SMOKE_TAG_RE = re.compile(TAG_RE.pattern + r"(-rc\.(0|[1-9]\d*))?")     # smoke only: a pre-release tag needs JEB_ALLOW_RC=1
INITIAL_VERSION = "1.0.0"                                          # the first release, as release-please starts
UID = os.getuid()
DRY = False
VERBOSE = True      # main() turns it off for install/uninstall unless --verbose; every other command keeps its output
OPEN = False        # a step line ("  app ... ") is waiting for its result
PATH = "/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin"


def say(*a):
    global OPEN
    if OPEN:
        print(flush=True); OPEN = False
    print(*a, flush=True)


def detail(*a):
    """Today's full output: shown only with --verbose (install/uninstall); say() is for what always shows."""
    if VERBOSE:
        say(*a)


def lead(label):
    """Default install/uninstall: open one step line, closed by fin() (or by whatever say() prints meanwhile)."""
    global OPEN
    if not VERBOSE:
        print(f"  {label} ...", end=" ", flush=True); OPEN = True


def fin(text):
    global OPEN
    if not VERBOSE:
        print(text, flush=True); OPEN = False


def line(label, text):
    if not VERBOSE:
        say(f"  {label} ... {text}")


def sh(cmd, check=False, cwd=None, env=None):
    detail("$ " + " ".join(cmd))
    if DRY:
        return 0
    r = subprocess.run(cmd, capture_output=True, text=True, cwd=cwd, env=env)
    if (r.stdout.strip() or r.stderr.strip()) and (VERBOSE or (check and r.returncode != 0)):
        say((r.stdout + r.stderr).strip())
    if check and r.returncode != 0:
        raise SystemExit(f"failed: {' '.join(cmd)}")
    return r.returncode


def step(label, cmd, cwd=None, env=None, tty=False):
    """One release step on one line; its output is shown only when it fails (tty: let it talk to the terminal)."""
    if DRY:
        say(f"  {label}: skipped (dry run)")
        return
    if tty:
        say(f"  {label} ...")
    else:
        print(f"  {label} ...", end=" ", flush=True)
    t = time.time()
    r = subprocess.run(cmd, cwd=cwd, env=env, **({} if tty else {"capture_output": True, "text": True}))
    if r.returncode != 0:
        if not tty:
            say("failed")
            say("\n".join((r.stdout + r.stderr).strip().splitlines()[-30:]))
        raise SystemExit(f"{label} failed")
    if not tty:
        say(f"ok ({time.time() - t:.0f}s)")


def mode():
    try:
        m = open(MODE_FILE).read().strip()
    except OSError:
        return "dev"
    return m if m in ("dev", "release") else "dev"


def labels_for(m):
    """dev ships local src edits (update agent); release follows tags (release agent), never local edits."""
    return tuple(l for l in ALL_LABELS if l != ("com.jeb.desktop.release" if m == "dev" else "com.jeb.desktop.update"))


def git(*a, **kw):
    try:
        return subprocess.run(["git", "-C", CLONE] + list(a), capture_output=True, text=True, **kw)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(["git"] + list(a), 124, "", f"git {a[0] if a else ''} timed out")


def tag_key(t):
    m = TAG_RE.fullmatch(t)
    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None


def release_tags(*args):
    """Sorted oldest first: the v* release tags (of `git tag --list`, or --points-at HEAD with args)."""
    out = git("tag", "--list", "v*", *args).stdout.split()
    return sorted((t for t in out if tag_key(t)), key=tag_key)


def head_tags():
    """The release tags at HEAD; a smoke run (which may name a pre-release tag) asks for its own tag only."""
    if SMOKE_TAG:
        r = git("rev-parse", "--verify", "-q", "refs/tags/" + SMOKE_TAG + "^{commit}")
        return [SMOKE_TAG] if r.returncode == 0 and r.stdout.strip() == git("rev-parse", "HEAD").stdout.strip() else []
    return release_tags("--points-at", "HEAD")


def load_updater():
    spec = importlib.util.spec_from_file_location("jeb_updater", os.path.join(CODE, "updater.py"))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def ours(path):
    """The installed app's executable, or a binary under JEB_SRC (the dev build): the only JebDesktops signalled."""
    p, src = os.path.realpath(path), os.path.realpath(SRC)
    return p == os.path.realpath(EXE) or p.startswith(src + os.sep)


def running():
    """[(pid, start_epoch, path)] of JebDesktop processes (ours, owned by this uid), oldest first."""
    out = []
    ps = subprocess.run(["ps", "-axo", "pid=,uid=,lstart=,comm="], capture_output=True, text=True).stdout
    for l in ps.splitlines():
        m = re.match(r"\s*(\d+)\s+(\d+)\s+(\w{3} \w{3}\s+\d+ [\d:]{8} \d{4})\s+(.*)$", l)
        if m and int(m.group(2)) == UID and os.path.basename(m.group(4)) == "JebDesktop" and ours(m.group(4)):
            out.append((int(m.group(1)), time.mktime(time.strptime(re.sub(r"\s+", " ", m.group(3)), "%a %b %d %H:%M:%S %Y")), m.group(4)))
    return sorted(out, key=lambda p: (p[1], p[0]))


def terminate_all():
    for pid, _, _ in running():
        try:
            os.kill(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass


def beat_files():
    d = os.path.join(HOME, "heartbeat")
    out = {}
    for n in (os.listdir(d) if os.path.isdir(d) else []):
        if n.isdigit():
            try:
                j = json.load(open(os.path.join(d, n)))
                out[int(n)] = (j.get("stamp"), bool(j.get("waiting")), time.time() - os.path.getmtime(os.path.join(d, n)))
            except (OSError, ValueError):
                pass
    return out


def write_quit_marker():
    os.makedirs(HOME, mode=0o700, exist_ok=True)
    fd = os.open(os.path.join(HOME, "quit"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.write(fd, b"jebctl\n"); os.close(fd)


# ---- plists ----

def plists(m):
    py = ["/usr/bin/python3", "-I"]
    env = {"PATH": PATH, "JEB_MOD": MOD, "JEB_SRC": SRC}
    out = {
        "com.jeb.desktop": {
            "Label": "com.jeb.desktop",
            "ProgramArguments": [EXE],
            "EnvironmentVariables": dict(env, JEB_START="launchd"),
            "RunAtLoad": True,
            "KeepAlive": {"SuccessfulExit": False},
            "ThrottleInterval": 10,
            "ProcessType": "Interactive",
            "LimitLoadToSessionType": "Aqua",
            "StandardOutPath": os.path.join(HOME, "run.log"),
            "StandardErrorPath": os.path.join(HOME, "run.log"),
        },
        "com.jeb.desktop.watchdog": {
            "Label": "com.jeb.desktop.watchdog",
            "ProgramArguments": py + [os.path.join(CODE, "watchdog.py")],
            "EnvironmentVariables": env,
            "StartInterval": 30,        # no RunAtLoad: at login the agent's own RunAtLoad start goes first
            "ProcessType": "Background",
            "LimitLoadToSessionType": "Aqua",
            "StandardErrorPath": os.path.join(HOME, "watchdog.err"),
        },
        "com.jeb.desktop.update": {
            "Label": "com.jeb.desktop.update",
            "ProgramArguments": py + [os.path.join(CODE, "updater.py")],
            "EnvironmentVariables": env,
            "WatchPaths": [SRC],
            "StartInterval": 300,       # a net for in-place edits, which do not always wake a WatchPaths job
            "ThrottleInterval": 30,
            "LowPriorityIO": True,
            "Nice": 10,
            "ProcessType": "Background",
            "LimitLoadToSessionType": "Aqua",
            "StandardErrorPath": os.path.join(HOME, "update.err"),
        },
        "com.jeb.desktop.release": {
            "Label": "com.jeb.desktop.release",
            "ProgramArguments": py + [os.path.join(CODE, "jebctl"), "follow"],
            "EnvironmentVariables": env,
            "RunAtLoad": True,
            "StartInterval": 21600,     # every 6 h
            "Nice": 10,
            "ProcessType": "Background",
            "LimitLoadToSessionType": "Aqua",
            "StandardErrorPath": os.path.join(HOME, "release.err"),
        },
    }
    return {l: d for l, d in out.items() if l in labels_for(m)}


def write_plists(dest, m):
    if not DRY:
        os.makedirs(dest, exist_ok=True)
    for label, d in plists(m).items():
        p = os.path.join(dest, label + ".plist")
        detail(f"plist {label}: JEB_MOD={d['EnvironmentVariables']['JEB_MOD']} JEB_SRC={d['EnvironmentVariables']['JEB_SRC']}")
        if DRY:
            continue
        with open(p, "wb") as f:
            plistlib.dump(d, f)
        os.chmod(p, 0o644)
        detail("wrote " + p)


# ---- telemetry (written by watchdog.py) ----

CPU_TARGETS = {"calm": 0.5, "passing": 4.0, "covered": 0.1}
RSS_TARGET, FP_TARGET = 60.0, 120.0


def perf_rows(seconds, stamp=None):
    """[{epoch, stamp, cpu, rss, fp, class}] of the telemetry rows from the last ."""
    d = os.path.join(HOME, "telemetry")
    since = time.time() - seconds
    out = []
    for n in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        if not re.fullmatch(r"\d{4}-\d\d-\d\d\.csv", n):
            continue
        try:
            lines = open(os.path.join(d, n)).read().splitlines()[1:]
        except OSError:
            continue
        for l in lines:
            f = l.split(",")
            try:
                r = {"epoch": int(f[0]), "stamp": f[1], "cpu": float(f[4]), "rss": float(f[5]), "fp": float(f[6]) if f[6] else None, "class": f[8]}
            except (ValueError, IndexError):
                continue
            if r["epoch"] >= since and (stamp is None or r["stamp"] == stamp):
                out.append(r)
    return out


def percentile(xs, p):
    xs = sorted(xs)
    return xs[min(len(xs) - 1, int(p / 100 * len(xs)))]


def perf_stats(rows):
    cpu = [r["cpu"] for r in rows]
    fps = [r["fp"] for r in rows if r["fp"] is not None]
    return {"n": len(rows), "median": percentile(cpu, 50), "p95": percentile(cpu, 95), "rss": max(r["rss"] for r in rows), "fp": max(fps) if fps else None}


def perf_over(cls, st):
    over = []
    if cls in CPU_TARGETS and st["median"] > CPU_TARGETS[cls]: over.append("CPU")
    if st["rss"] > RSS_TARGET: over.append("RSS")
    if st["fp"] is not None and st["fp"] > FP_TARGET: over.append("footprint")
    return over


def cmd_perf(args):
    days, stamp = 1.0, None
    try:
        if "--days" in args: days = float(args[args.index("--days") + 1])
        if "--stamp" in args: stamp = args[args.index("--stamp") + 1]
    except (IndexError, ValueError):
        raise SystemExit("usage: jebctl perf [--days N] [--stamp S]")
    rows = perf_rows(days * 86400, stamp)
    if not rows:
        say("no telemetry samples in range"); return
    say(f"{'stamp':<16} {'class':<8} {'n':>5} {'cpu med %':>10} {'cpu p95 %':>10} {'max rss MB':>11} {'max fp MB':>10}  flags")
    for st in sorted({r["stamp"] for r in rows}):
        for cls in sorted({r["class"] for r in rows if r["stamp"] == st}):
            s = perf_stats([r for r in rows if r["stamp"] == st and r["class"] == cls])
            over = perf_over(cls, s)
            say(f"{st:<16} {cls:<8} {s['n']:>5} {s['median']:>10.2f} {s['p95']:>10.2f} {s['rss']:>11.1f} {'-' if s['fp'] is None else format(s['fp'], '.1f'):>10}  {'OVER ' + '/'.join(over) if over else 'ok'}")


def perf_line():
    rows = perf_rows(3600)
    if not rows:
        return "perf (last hour): no samples"
    calm = [r["cpu"] for r in rows if r["class"] == "calm"]
    over = []
    for c in sorted({r["class"] for r in rows}):
        o = perf_over(c, perf_stats([r for r in rows if r["class"] == c]))
        if o:
            over.append(f"{c} {'/'.join(o)}")
    head = f"calm median {percentile(calm, 50):.2f} % cpu" if calm else "no calm samples"
    return f"perf (last hour): {head}, max rss {max(r['rss'] for r in rows):.0f} MB" + (f", over target: {', '.join(over)}" if over else "")


# ---- commands ----

def cmd_status():
    procs = running()
    beats = beat_files()
    say(f"installed app: {APP if os.path.isdir(APP) else 'none'}" + (f" (stamp {load_updater().bundle_stamp(APP)})" if os.path.isdir(APP) else ""))
    say(f"running: {len(procs)}")
    for pid, start, path in procs:
        b = beats.get(pid)
        say(f"  pid {pid} up {int(time.time() - start)} s  " + (f"stamp {b[0]}{' (waiting to take over)' if b[1] else ''}, heartbeat {b[2]:.1f} s old" if b else "no heartbeat (not started by the install)"))
    say("quit marker: " + ("yes (stays quit until login or `jebctl start`)" if os.path.exists(os.path.join(HOME, "quit")) else "no"))
    say(perf_line())
    say("updates: " + ("paused" if os.path.exists(os.path.join(HOME, "updates-paused")) else "on"))
    try:
        st = json.load(open(os.path.join(HOME, "updater-state.json")))
        last = st.get("last")
        if last:
            say(f"last update: {last['result']} {last.get('stamp')} at {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(last['at']))}: {last.get('why', '')[:300]}")
        say(f"rejected builds: {len(st.get('rejected', []))}")
    except (OSError, ValueError):
        say("last update: none")
    vs = sorted((d for d in os.listdir(VERSIONS) if d.endswith('.app')), reverse=True) if os.path.isdir(VERSIONS) else []
    say("saved versions: " + (", ".join(v[:-4] for v in vs) or "none"))
    say("agents installed: " + ", ".join(f"{l.split('.')[-1]}={'yes' if os.path.exists(os.path.join(AGENTS, l + '.plist')) else 'no'}" for l in labels_for(mode())))
    say(release_line())


def fixtures():
    """The parity fixtures (src/tools/parity.py): (list of fixture dicts, store_of)."""
    os.environ["JEB_MOD"] = MOD
    spec = importlib.util.spec_from_file_location("parity", os.path.join(SRC, "tools", "parity.py"))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
