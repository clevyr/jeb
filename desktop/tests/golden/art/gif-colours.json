{
 "about": {
  "what": "Per animated sprite, each frame that save_gif() writes (identical consecutive frames are merged): how many colours Pillow's quantize(colors=63, MEDIANCUT, no dither) saw, and whether the GIF frame decodes back to the scaled source frame exactly.",
  "made_by": "scratchpad/gif-colours.py (throwaway, not in the repo) against mod/art/src at the capture commit; see desktop/tests/golden/README.md",
  "pillow": "11.3.0",
  "python": "3.9.6",
  "scale": 4,
  "opaque_colours": "distinct RGB among pixels with alpha >= 128 in the x4 frame (the colours a Swift exact-palette GIF encoder must carry)",
  "colours_seen_by_quantizer": "distinct RGB in big.convert('RGB'): opaque_colours plus (0,0,0) when the frame has transparent pixels, which save_gif() hands to the quantizer and then covers with index 63",
  "exact": "every opaque source pixel decodes to the same RGB with alpha 255 and every transparent one to alpha 0 (Pillow decode of the built GIF)",
  "transparent_rgb_in_file": "the RGB the file's transparent index carries (Pillow's RGBA conversion keeps it; ImageIO zeroes it)",
  "alphas": "listed only when a frame has alpha values other than 0/255",
  "limit": "63 colours (index 63 is the transparency slot); over_limit lists sprite[frame] with opaque_colours > 63 or exact == false",
  "max_opaque_colours": 26,
  "over_limit": []
 },
