# macOS
.DS_Store

# Private or local-only notes
*private*
.env
.env.*

# Python
__pycache__/
*.pyc

# Logs and runtime files
*.log
*.err
*.pid
desktop/launchd/

# Claude Code regenerates the mod's engine types when it loads the mod
mod/.claude-plugin/types/

# Art previews rendered by mod/art/src/build.py; the app reads hooks/pixel-art.ts
mod/art/out/
# Desktop build output and local binaries
desktop/src/JebDesktop
desktop/src/JebDesktop.*
!desktop/src/JebDesktop.*.swift
desktop/src/watch
desktop/src/wl
desktop/src/.build/
*.app/

# Desktop scratch, bench and generated output
desktop/src/runs/
desktop/src/meas/
desktop/src/test/
desktop/src/modcopy/
desktop/src/fixtures/out/

# Generated by tools/status.py
desktop/src/parity-status.md

# Hostile-gate scratch copies
creative/tools/cases/

# Compiled jebctl (built by desktop/cli/build.sh)
desktop/cli/jebctl
desktop/cli/jebctl.*

# The dev jebctl, the Swift port before the cutover (built by desktop/cli/next/build.sh)
desktop/cli/next/jebctl
desktop/cli/next/jebctl.*

# Compiled desktop tools (built from the .swift sources beside them)
desktop/src/tools/png2raw
desktop/src/tools/detect
desktop/src/tools/raw2png
desktop/src/tools/pixcheck
desktop/src/tools/latency
desktop/src/tools/vis
desktop/src/tools/up
desktop/src/tools/wins
desktop/src/tools/awake
desktop/src/tools/carx/carx
desktop/src/tools/carx/carx2
desktop/src/tools/carx/carx3
desktop/src/tools/carx/carx4

# Editors and IDEs
.idea/
.vscode/
.fleet/
.history/
*.swp
*.swo
*~

# Local tool state
.claude/settings.local.json
.venv/
venv/
node_modules/
Thumbs.db

# Keys and certificates: never commit these (desktop/release-signers holds public keys only)
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
*_signing
*_signing.pub

# jebctl unit-test runner (built by desktop/cli/tests/run.sh)
desktop/cli/jebctl-tests

# the gates (built by desktop/gates/build.sh)
desktop/gates/jebgates
# the release tool (built by dev/release/build.sh)
dev/release/release
dev/release/release.tmp

# Compiled jebart, the art tool (built by art/build.sh), and its unit-test runner (built by art/tests/run.sh)
art/jebart
art/jebart.*
art/jebart-tests
