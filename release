#!/usr/bin/python3
"""./release [patch|minor|major] [--dry-run] | ./release setup [--dry-run] | ./release smoke [TAG] [--dry-run]: cut a Jeb release from this clone (owner side, local, no CI), or smoke-test a published one.

  ./release setup         one-time signing setup. When this clone has no SSH signing key configured, makes
                          ~/.ssh/jeb_signing (ed25519; ssh-keygen asks for a passphrase) unless it exists and
                          points this clone's git at it (gpg.format ssh, user.signingkey = the private key, so
                          signing needs no ssh-agent; git asks for the passphrase once per release). Then creates
                          desktop/release-signers (ssh allowed_signers format) from git's user.email and that
                          public key when it does not exist; else shows its fingerprints and whether the
                          configured key is in it. Commit and push the file before the first release: installs
                          pin it on first install.
  ./release               the usual way. Picks the bump from the Conventional Commits since the last tag, as
                          release-please does (`!` or a BREAKING CHANGE footer: major, feat: minor, fix/perf/revert:
                          patch; nothing releasable: refuses), writes release notes from them, then runs
                          `desktop/jebctl release --parity --bump auto`. The first release (no tag yet) is
                          1.0.0. The version always comes from the tags; plugin.json only records it.
  ./release patch|minor|major
                          the same with the bump forced. A new version is written to plugin.json and
                          committed (chore(release): v<version>) only after every check passes.
                          Both run jebctl's checks (clean tree on the default branch, mod checks, universal
                          release build, parity gate) before anything is written, then the signed tag
                          v<version>, whose message carries the SHA-256 of the app zip. On success they ask
                          once, then push <base> and <tag> and publish the GitHub release with those notes and
                          the zip (`gh release create <tag> --verify-tag --notes-file ... <zip>`), only on y.
                          Installs use that zip only when it matches the hash in the signed tag. Without a
                          terminal they print those commands instead.
  ./release smoke [TAG]   sandboxed end-to-end check of a published release; never touches the real install. TAG
                          defaults to the newest v* tag on origin (a vX.Y.Z-rc.N tag only when it is the newest or
                          named). Under <git dir>/jeb-smoke/<TAG>/ (an earlier one is moved to old-<time>), with a
                          fake HOME, it clones origin for real (your gh and git config are passed through, so the
                          download path is genuinely exercised) and installs with this tree's `jebctl install
                          --mode release --no-agents` run on that clone (JEB_CLONE): no LaunchAgent, launchctl or
                          PATH change anywhere. So it tests the tag's app, mod, updater and gates with the current
                          tree's install logic; the tag's own ./install is not run (older tags lack --no-agents).
                          A: fresh install must use the release's prebuilt app (a build from source fails the
                          smoke), pass codesign, point JebMod at the clone and use the new state folder.
                          B: an existing install in the old state folder (~/.claude/jeb-desktop) must migrate to
                          the new one, leave a link, and have its plists rewritten. Then `jebctl doctor` runs
                          read-only (JEB_NO_LAUNCHCTL=1) against A and its output is shown. Exit 1 on any failure.
                          JEB_SMOKE_ORIGIN overrides the origin URL (tests).
  --dry-run               change nothing: no file, tag or push (smoke: prints the plan).
"""
import json, os, plistlib, pwd, re, shutil, signal, subprocess, sys, time

CLONE = os.path.dirname(os.path.abspath(__file__))
CODE = os.path.join(CLONE, "desktop")
SIGNERS = os.path.join(CODE, "release-signers")


def say(*a):
    print(*a, flush=True)


def fail(msg):
    raise SystemExit("release: " + msg)


def git(*a):
    return subprocess.run(["git", "-C", CLONE] + list(a), capture_output=True, text=True)


def cfg(key):
    return git("config", "--get", key).stdout.strip()


def public_key():
    """(email, 'ssh-... base64') from git config; exits with the config commands to run when something is missing."""
    email, key, fmt = cfg("user.email"), cfg("user.signingkey"), cfg("gpg.format")
    if fmt != "ssh" or not key or not email:
        fail("signing is not set up for SSH. Run (with your own key and email):\n"
             "  git config gpg.format ssh\n"
             "  git config user.signingkey ~/.ssh/id_ed25519.pub\n"
             "  git config user.email you@example.com")
    if key.startswith("key::"):
        text = key[5:]
    else:
        path = os.path.expanduser(key)
        if not path.endswith(".pub") and os.path.exists(path + ".pub"):
            path += ".pub"
        try:
            text = open(path).read()
        except OSError:
            fail(f"cannot read the public key {path} named by user.signingkey")
    f = text.split()
    if len(f) < 2 or not f[0].startswith(("ssh-", "ecdsa-", "sk-")):
        fail("user.signingkey is not an SSH public key (a .pub file, a private key with a .pub beside it, or key::ssh-...)")
    return email, f[0] + " " + f[1]


def fingerprint(line):
    r = subprocess.run(["ssh-keygen", "-lf", "-"], input=line, capture_output=True, text=True)
    return r.stdout.strip() or "unreadable"


KEY = os.path.expanduser("~/.ssh/jeb_signing")


def configure(dry):
    """Make ~/.ssh/jeb_signing when missing and point this clone's git at it, unless signing is already set up."""
    if cfg("gpg.format") == "ssh" and cfg("user.signingkey"):
        return
    if not cfg("user.email"):
        fail("git has no user.email; run: git config --global user.email you@example.com")
    if not os.path.exists(KEY):
        say(f"{'would create' if dry else 'creating'} the signing key {KEY} (pick a passphrase and keep it, and back the key up)")
        if not dry:
            os.makedirs(os.path.dirname(KEY), mode=0o700, exist_ok=True)
            if subprocess.run(["ssh-keygen", "-t", "ed25519", "-C", cfg("user.email"), "-f", KEY]).returncode != 0:
                fail("ssh-keygen failed; nothing configured")
    for key, value in (("gpg.format", "ssh"), ("user.signingkey", KEY)):
        say(f"$ git config {key} {value}")
        if not dry and git("config", key, value).returncode != 0:
            fail(f"could not set {key}")


def setup(dry):
    configure(dry)
    if dry and not (cfg("gpg.format") == "ssh" and cfg("user.signingkey")):
        say("would then write desktop/release-signers from that key")
        return 0
    email, key = public_key()
    if os.path.exists(SIGNERS):
        lines = [l for l in open(SIGNERS).read().splitlines() if l.strip() and not l.startswith("#")]
        say(f"{SIGNERS} exists:")
        for l in lines:
            say("  " + fingerprint(" ".join(l.split()[-2:])))
        say("configured key is " + ("in it" if any(key in l for l in lines) else "NOT in it (a release signed with it will not verify; see `jebctl install --repin`)"))
        return 0
    line = f'{email} namespaces="git" {key}'
    say(f"{'would write' if dry else 'writing'} {SIGNERS}:\n  {line}\n  {fingerprint(key)}")
    if not dry:
        fd = os.open(SIGNERS, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        with os.fdopen(fd, "w") as f:
            f.write(line + "\n")
        os.chmod(SIGNERS, 0o644)
    say("Commit and push desktop/release-signers before the first release; installs pin it on first install.")
    return 0


def no_private_keys():
    """Refuse when any tracked file holds a private key (release-signers is public keys only)."""
    hits = git("grep", "-l", "-I", "-E", "-e", "-----BEGIN [A-Z ]*PRIVATE KEY-----").stdout.split()
    if hits:
        fail("a tracked file holds a private key; remove it from git before releasing: " + ", ".join(hits))


def release(dry, bump):
    no_private_keys()
    cmd = ["/usr/bin/python3", "-I", os.path.join(CODE, "jebctl"), "release", "--parity", "--bump", bump] + (["--dry-run"] if dry else [])
    # jebctl gets the Ctrl-C and says how far it got; this side just waits for it
    old = signal.signal(signal.SIGINT, lambda *a: None)
    try:
        rc = subprocess.run(cmd, env=dict(os.environ, JEB_RELEASE_WRAPPED="1")).returncode
    finally:
        signal.signal(signal.SIGINT, old)
    if rc != 0 or dry:
        return rc
    tags = git("tag", "--list", "v*", "--points-at", "HEAD").stdout.split()
    if not tags:
        fail("no release tag at HEAD after the release; nothing to push")
    tag, base = max(tags, key=lambda t: [int(x) if x.isdigit() else -1 for x in t[1:].split(".")]), git("branch", "--show-current").stdout.strip()
    notes = os.path.join(CLONE, git("rev-parse", "--git-path", f"jeb-release-notes-{tag}.md").stdout.strip())
    zp = os.path.join(CLONE, git("rev-parse", "--git-path", f"jeb-release-{tag}").stdout.strip(), f"JebDesktop-{tag}-macos.zip")
    publish = ["gh", "release", "create", tag, "--verify-tag", "--title", tag] + (["--notes-file", notes] if os.path.isfile(notes) else ["--generate-notes"]) + ([zp] if os.path.isfile(zp) else [])
    push = f"git push origin {base} {tag}\n  " + " ".join(publish)
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        say("no terminal; not pushing. To publish, run:\n  " + push)
        return 0
    if input(f"Push {base} and {tag} to origin and publish the GitHub release? [y/N] ").strip().lower() != "y":
        say("not pushed. To publish, run:\n  " + push)
        return 0
    rc = subprocess.run(["git", "-C", CLONE, "push", "origin", base, tag]).returncode
    if rc != 0:
        return rc
    if not shutil.which("gh"):
        say("pushed, but gh is not installed. To publish the GitHub release, run:\n  " + " ".join(publish))
        return 1
    rc = subprocess.run(publish, cwd=CLONE).returncode
    if rc != 0:
        say("pushed, but the GitHub release was not created. Installs still follow the tag. To retry, run:\n  " + " ".join(publish))
    return rc


# ---- smoke ----

SMOKE_TAG_RE = re.compile(r"v(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-rc\.(0|[1-9]\d*))?")    # pre-release tags are for smoke only; installs never follow them
JEBCTL = os.path.join(CODE, "jebctl")


def smoke_key(t):
    m = SMOKE_TAG_RE.fullmatch(t)
    return (int(m.group(1)), int(m.group(2)), int(m.group(3)), 0, int(m.group(4))) if m and m.group(4) else (int(m.group(1)), int(m.group(2)), int(m.group(3)), 1, 0)


def remote_tags(origin):
    """Release tags on origin (SemVer, optionally -rc.N), oldest first; exits when origin cannot be read."""
    r = subprocess.run(["git", "ls-remote", "--tags", "--refs", origin, "refs/tags/v*"], capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        fail(f"cannot list the tags of {origin}: {r.stderr.strip()[:200]}")
    tags = [l.split("refs/tags/", 1)[1] for l in r.stdout.splitlines() if "refs/tags/" in l]
    return sorted((t for t in tags if SMOKE_TAG_RE.fullmatch(t)), key=smoke_key)


def smoke_env(home, tag, extra=None):
    """Every child's environment: the owner's PATH and auth (gh, git config) but a fake HOME and no JEB_* from outside."""
    real = pwd.getpwuid(os.getuid()).pw_dir
    env = {k: v for k, v in os.environ.items() if not k.startswith("JEB_")}
    env.update(HOME=home, JEB_APP_DIR=os.path.join(home, "Applications"), JEB_LAUNCHAGENTS=os.path.join(home, "Library", "LaunchAgents"),
               JEB_SETTINGS=os.path.join(home, ".claude", "settings.json"), JEB_BACKUPS=os.path.join(home, ".claude", "backups", "jeb"),
               JEB_STORE_DIR=os.path.join(home, ".claude", "plugins", "store"), JEB_BIN_DIR=os.path.join(home, ".local", "bin"),
               JEB_PROFILE=os.path.join(home, ".zprofile"))
    env.setdefault("GH_CONFIG_DIR", os.path.join(real, ".config", "gh"))
    if "GIT_CONFIG_GLOBAL" not in env and os.path.isfile(os.path.join(real, ".gitconfig")):
        env["GIT_CONFIG_GLOBAL"] = os.path.join(real, ".gitconfig")
    if "-rc." in tag:
        env["JEB_ALLOW_RC"] = "1"
    env.update(extra or {})
    return env


def smoke_case(name, label, sandbox, home, tag, origin, seed=None):
    """One case: clone origin, install with --no-agents, check. Returns (ok, text)."""
    t0 = time.time()
    clone = os.path.join(sandbox, "clone-" + name.lower())
    state = os.path.join(home, "Library", "Application Support", "Jeb")
    old = os.path.join(home, ".claude", "jeb-desktop")
    env = smoke_env(home, tag, {"JEB_CLONE": clone, "JEB_SMOKE_TAG": tag})
    os.makedirs(os.path.join(home, "Library"))
    # gh keeps its login in the keychain, found under $HOME/Library/Keychains: link the real one so no token goes into env
    os.symlink(os.path.join(pwd.getpwuid(os.getuid()).pw_dir, "Library", "Keychains"), os.path.join(home, "Library", "Keychains"))
    if seed:
        seed(old)
    def bad(why):
        return False, f"FAIL: {why}"
    r = subprocess.run(["git", "clone", "-q", origin, clone], env=env, capture_output=True, text=True, timeout=900)
    if r.returncode != 0:
        return bad("git clone failed: " + (r.stderr.strip().splitlines() or ["?"])[-1][:200])
    r = subprocess.run(["/usr/bin/python3", "-I", JEBCTL, "install", "--mode", "release", "--no-agents"], env=env, cwd=sandbox, capture_output=True, text=True, timeout=1800)
    out = (r.stdout + r.stderr).strip()
    open(os.path.join(sandbox, f"install-{name.lower()}.log"), "w").write(out + "\n")
    if r.returncode != 0:
        return bad("install exit %d: %s" % (r.returncode, " | ".join(out.splitlines()[-3:])[:400]))
    app = os.path.join(home, "Applications", "JebDesktop.app")
    if not os.path.isdir(app):
        return bad(f"{app} was not installed")
    if subprocess.run(["codesign", "--verify", app], capture_output=True).returncode != 0:
        return bad("codesign --verify failed on the installed app")
    try:
        jm = plistlib.load(open(os.path.join(app, "Contents", "Info.plist"), "rb")).get("JebMod")
    except (OSError, ValueError):
        jm = None
    if not isinstance(jm, str) or os.path.realpath(jm) != os.path.realpath(os.path.join(clone, "mod")):
        return bad(f"Info.plist JebMod is {jm!r}, not the clone's mod")
    try:
        ulog = open(os.path.join(state, "update.log")).read()
    except OSError:
        return bad(f"no update.log in {state}")
    if "using the prebuilt binary" not in ulog or f"(prebuilt {tag})" not in out:
        why = [l for l in out.splitlines() if l.startswith("app:")]
        return bad("the app was built from source, not the release's prebuilt" + (": " + why[-1] if why else ""))
    head = subprocess.run(["git", "-C", clone, "rev-parse", "HEAD", f"refs/tags/{tag}^{{commit}}"], capture_output=True, text=True).stdout.split()
    if len(head) != 2 or head[0] != head[1]:
        return bad(f"the clone is not at {tag}")
    if not os.path.isdir(state) or os.path.islink(state):
        return bad(f"state folder {state} is missing")
    if name == "A":
        if os.path.lexists(old):
            return bad(f"{old} exists on a fresh install")
    else:
        if not os.path.islink(old) or os.path.realpath(old) != os.path.realpath(state):
            return bad(f"{old} is not a link to the new state folder")
        for n in ("install-mode", "release-state.json", os.path.join("launchd", "com.jeb.desktop.plist"), os.path.join("launchd", "com.jeb.desktop.update.plist")):
            if not os.path.exists(os.path.join(state, n)):
                return bad(f"{n} did not survive the move to {state}")
        ld = os.path.join(state, "launchd")
        stale = [n for n in sorted(os.listdir(ld)) if ".claude/jeb-desktop" in open(os.path.join(ld, n), errors="replace").read()]
        if stale:
            return bad("plists still name the old state folder: " + ", ".join(stale))
    return True, f"ok (prebuilt {tag}, {time.time() - t0:.0f}s)"


def seed_old_layout(old):
    """A minimal release-mode install as the state folder was laid out before it moved."""
    os.makedirs(os.path.join(old, "launchd"), mode=0o700)
    open(os.path.join(old, "install-mode"), "w").write("release\n")
    json.dump({"failed": [], "checked": int(time.time()) - 3600, "last": None}, open(os.path.join(old, "release-state.json"), "w"))
    for label in ("com.jeb.desktop", "com.jeb.desktop.update"):     # the update one is not rewritten by the install, so only the migration can fix it
        with open(os.path.join(old, "launchd", label + ".plist"), "wb") as f:
            plistlib.dump({"Label": label, "ProgramArguments": ["/usr/bin/true"], "StandardOutPath": os.path.join(old, "run.log"),
                           "StandardErrorPath": os.path.join(old, "run.err"), "EnvironmentVariables": {"JEB_HOME": old}}, f)


def smoke_plugdirs(home, clone, tag):
    """The ./install settings step against the sandbox settings, so plugdirs is covered too."""
    sys.path.insert(0, CODE)
    import plugdirs
    saved = dict(os.environ)
    try:
        os.environ.update(smoke_env(home, tag))
        plugdirs.edit(os.path.join(clone, "mod"), False, False, lambda *a: None)
        return plugdirs.settings_path()
    finally:
        os.environ.clear(); os.environ.update(saved)


def smoke(tag, dry):
    origin = os.environ.get("JEB_SMOKE_ORIGIN") or git("remote", "get-url", "origin").stdout.strip()
    if not origin:
        fail("this clone has no origin")
    if tag:
        if not SMOKE_TAG_RE.fullmatch(tag):
            fail(f"{tag} is not a release tag (vX.Y.Z or vX.Y.Z-rc.N)")
    else:
        tags = remote_tags(origin)
        if not tags:
            fail(f"no v* release tag on {origin}")
        tag = tags[-1]
    root = os.path.join(CLONE, git("rev-parse", "--git-path", "jeb-smoke").stdout.strip())
    sandbox = os.path.join(root, tag)
    say(f"smoke {tag} from {origin}\n  sandbox {sandbox} (fake HOME inside; an earlier one is moved to {os.path.join(root, 'old-<time>')})\n"
        f"  A fresh install: git clone, jebctl install --mode release --no-agents; B existing install in the old state folder; then jebctl doctor (JEB_NO_LAUNCHCTL=1)")
    if dry:
        say("dry run: nothing was created.")
        return 0
    os.makedirs(root, exist_ok=True)
    if os.path.lexists(sandbox):
        aside = os.path.join(root, f"old-{time.strftime('%Y%m%d-%H%M%S')}-{tag}")
        os.rename(sandbox, aside)
        say(f"  moved the previous sandbox to {aside}")
    os.makedirs(sandbox)
    results = []
    for name, label, home, seed in (("A", "fresh install", "home", None), ("B", "existing install, old layout", "home-b", seed_old_layout)):
        try:
            ok, text = smoke_case(name, label, sandbox, os.path.join(sandbox, home), tag, origin, seed)
        except (OSError, subprocess.SubprocessError) as e:
            ok, text = False, f"FAIL: {type(e).__name__}: {e}"
        say(f"smoke {name} {label}: {text}")
        results.append(ok)
    if results[0]:
        home, clone = os.path.join(sandbox, "home"), os.path.join(sandbox, "clone-a")
        try:
            say(f"smoke plugin settings: ok ({smoke_plugdirs(home, clone, tag)})")
        except (SystemExit, OSError, ImportError) as e:
            say(f"smoke plugin settings: FAIL: {e}"); results.append(False)
        r = subprocess.run(["/usr/bin/python3", "-I", JEBCTL, "doctor"], env=smoke_env(home, tag, {"JEB_CLONE": clone, "JEB_NO_LAUNCHCTL": "1"}), cwd=sandbox, capture_output=True, text=True, timeout=300)
        lines = (r.stdout + r.stderr).strip().splitlines()
        say("smoke doctor (agents are not loaded in a sandbox; those FIX lines are expected):\n" + "\n".join("  " + l for l in lines))
        crit = [l for l in lines if l.startswith("FIX") and re.search(r"app bundle|mod folder|signers|state folder", l)]
        if crit:
            say("smoke doctor: FAIL: " + "; ".join(c[:120] for c in crit)); results.append(False)
    say(f"sandbox: {sandbox}\n" + ("smoke passed" if all(results) else "smoke FAILED"))
    return 0 if all(results) else 1


def main(argv):
    dry = "--dry-run" in argv
    rest = [a for a in argv if a != "--dry-run"]
    if rest[:1] == ["smoke"] and len(rest) <= 2:
        return smoke(rest[1] if len(rest) == 2 else None, dry)
    if rest not in ([], ["setup"], ["patch"], ["minor"], ["major"]):
        say(__doc__); return 2
    return setup(dry) if rest == ["setup"] else release(dry, rest[0] if rest else "auto")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit("release: stopped")
