#!/bin/sh
# ./release: the owner's release tool. Builds dev/release/release when it is missing or older than its sources
# (dev/release/*.swift, the desktop/cli files it compiles, dev/release/build.sh), then runs it with the given arguments.
set -e
cd "$(dirname "$0")"
BIN=dev/release/release
stale=0
if [ ! -x "$BIN" ]; then
  stale=1
else
  for s in dev/release/*.swift dev/release/build.sh desktop/cli/Json.swift desktop/cli/Env.swift desktop/cli/Home.swift \
           desktop/cli/State.swift desktop/cli/Signers.swift desktop/cli/Tags.swift desktop/cli/Fetch.swift desktop/cli/Style.swift; do
    [ "$s" -nt "$BIN" ] && stale=1
  done
fi
[ "$stale" = 0 ] || sh dev/release/build.sh
exec "$BIN" "$@"
