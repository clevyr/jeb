#!/usr/bin/python3
"""./release [patch|minor|major] [--dry-run] | ./release setup [--dry-run] | ./release smoke [TAG] [--dry-run]: cut a Jeb release from this clone (owner side, local, no CI), or smoke-test a published one.

  ./release setup         one-time signing setup. When this clone has no SSH signing key configured, makes
                          ~/.ssh/jeb_signing (ed25519; ssh-keygen asks for a passphrase) unless it exists and
                          points this clone's git at it (gpg.format ssh, user.signingkey = the private key; a
                          release asks for its passphrase once, first, and holds it in a private ssh-agent
                          that ends with the run). Keys carry no email; the principal is `jeb-release`. Then
                          creates desktop/release-signers (ssh allowed_signers format) from that public key
                          when it does not exist; when it exists it is never overwritten: setup shows its
                          fingerprints, whether the configured key is in it, and the line to add when not.
                          Commit and push the file before the first release: installs pin it on first install
                          and adopt it from newer signed releases.
  ./release               the usual way. Picks the bump from the Conventional Commits since the last tag, as
                          release-please does (`!` or a BREAKING CHANGE footer: major, feat: minor, fix/perf/revert:
                          patch; nothing releasable: refuses), writes release notes from them, then runs
                          `desktop/jebctl release --parity --bump auto`. The first release (no tag yet) is
                          1.0.0. The version always comes from the tags; plugin.json only records it.
  ./release patch|minor|major
                          the same with the bump forced. A new version is written to plugin.json and
                          committed (chore(release): v<version>) only after every check passes.
                          Both run jebctl's checks (clean tree on the default branch, mod checks, universal
                          release build, parity gate) before anything is written, then the signed tag
                          v<version>, whose message carries the SHA-256 of the app zip. On success they ask
                          once, then push <base> and <tag> and publish the GitHub release with those notes and the assets
                          (`gh release create <tag> --verify-tag --notes-file ... <assets>`), only on y; it refuses when the app zip
                          is missing. Assets: Jeb-<tag>-macos-arm64.zip and -x86_64.zip (the bundles users install: tree,
                          prebuilt app, pinned Python), Jeb-<tag>-manifest.json and its .sig (signed with the tag's key in the
                          `jeb-release` namespace), jebctl-macos (the universal native jebctl, also inside every bundle as
                          desktop/bin/jebctl; its name, size and SHA-256 are in the manifest under "jebctl"; a new user's first
                          copy is a curl of github.com/clevyr/jeb/releases/latest/download/jebctl-macos), and the older JebDesktop-<tag>-macos.zip (JebDesktop plus the universal detect and
                          png2raw; installs from the git clone use it when it matches the hash in the signed tag; kept during the
                          transition). Without a terminal they print those commands instead.
  ./release bundle --tag vX.Y.Z --out DIR [--ref REF] [--from-tree] [--app DIR] [--key K] [--signers F]
                          builds the release bundles without releasing: Jeb-<tag>-macos-arm64.zip and -x86_64.zip (the tracked tree
                          from `git archive REF` (default HEAD), or with --from-tree the working tree's files; the prebuilt app and the native
                          jebctl from --app (default .git/jeb-release-<tag>/stage; JebDesktop, detect, png2raw and jebctl); python-build-standalone, pinned and pruned; bundle.json), then
                          Jeb-<tag>-manifest.json signed with --key (default user.signingkey) in the `jeb-release` namespace and verified
                          against the bundle's own desktop/release-signers (--signers replaces that file, for tests with a throwaway key).
  ./release smoke [TAG]   sandboxed end-to-end check of a published release; never touches the real install. TAG defaults to the
                          newest published release. Under <git dir>/jeb-smoke/<TAG>/ (an earlier one is moved to old-<time>), with a
                          fake HOME, it downloads the manifest, its signature and the release's jebctl-macos over HTTPS (JEB_RELEASE_BASE
                          overrides where releases are read; it is passed into the sandbox), verifies them against
                          desktop/release-signers and runs that `jebctl-macos install --no-agents`, which downloads this Mac's zip, unpacks
                          it into <home>/.jeb/versions/<TAG> and runs the bundle's own install (no LaunchAgent, launchctl or PATH change
                          anywhere; a tag older than v1.5.0 is refused: its jebctl-macos installs with gh). It checks
                          the prebuilt app was used, codesign, that JebMod and the settings entry are <home>/.jeb/current/mod, that
                          current resolves and that versions/ holds one folder. Then `jebctl follow --dry-run` (the Python HTTPS path) and
                          `jebctl doctor` run read-only (JEB_NO_LAUNCHCTL=1) and the doctor's output is shown. When the manifest lists jebctl it also downloads jebctl-macos and
                          checks its SHA-256 against the manifest and that `--version` names the tag. Exit 1 on any failure.
  --dry-run               change nothing: no file, tag or push (smoke: prints the plan).
"""
import glob, hashlib, json, os, plistlib, pwd, re, shutil, signal, subprocess, sys, tempfile, time

CLONE = os.path.dirname(os.path.realpath(__file__))
CODE = os.path.join(CLONE, "desktop")
SIGNERS = os.path.join(CODE, "release-signers")
REPO = "clevyr/jeb"


def say(*a):
    print(*a, flush=True)


def fail(msg):
    raise SystemExit("release: " + msg)


def git(*a):
    return subprocess.run(["git", "-C", CLONE] + list(a), capture_output=True, text=True)


def cfg(key):
    return git("config", "--get", key).stdout.strip()


def public_key():
    """'ssh-... base64' from git config; exits with the config commands to run when something is missing."""
    key, fmt = cfg("user.signingkey"), cfg("gpg.format")
    if fmt != "ssh" or not key:
        fail("signing is not set up for SSH. Run (with your own key):\n"
             "  git config gpg.format ssh\n"
             "  git config user.signingkey ~/.ssh/jeb_signing.pub")
    if key.startswith("key::"):
        text = key[5:]
    else:
        path = os.path.expanduser(key)
        if not path.endswith(".pub") and os.path.exists(path + ".pub"):
            path += ".pub"
        try:
            text = open(path).read()
        except OSError:
            fail(f"cannot read the public key {path} named by user.signingkey")
    f = text.split()
    if len(f) < 2 or not f[0].startswith(("ssh-", "ecdsa-", "sk-")):
        fail("user.signingkey is not an SSH public key (a .pub file, a private key with a .pub beside it, or key::ssh-...)")
    return f[0] + " " + f[1]


def fingerprint(line):
    r = subprocess.run(["ssh-keygen", "-lf", "-"], input=line, capture_output=True, text=True)
    return r.stdout.strip() or "unreadable"


KEY = os.path.expanduser("~/.ssh/jeb_signing")


def configure(dry):
    """Make ~/.ssh/jeb_signing when missing and point this clone's git at it, unless signing is already set up."""
    if cfg("gpg.format") == "ssh" and cfg("user.signingkey"):
        return
    if not os.path.exists(KEY):
        say(f"{'would create' if dry else 'creating'} the signing key {KEY} (pick a passphrase and keep it, and back the key up)")
        if not dry:
            os.makedirs(os.path.dirname(KEY), mode=0o700, exist_ok=True)
            if subprocess.run(["ssh-keygen", "-t", "ed25519", "-C", "jeb-release", "-f", KEY]).returncode != 0:
                fail("ssh-keygen failed; nothing configured")
    for key, value in (("gpg.format", "ssh"), ("user.signingkey", KEY)):
        say(f"$ git config {key} {value}")
        if not dry and git("config", key, value).returncode != 0:
            fail(f"could not set {key}")


def setup(dry):
    configure(dry)
    if dry and not (cfg("gpg.format") == "ssh" and cfg("user.signingkey")):
        say("would then write desktop/release-signers from that key")
        return 0
    key = public_key()
    if os.path.exists(SIGNERS):
        lines = [l for l in open(SIGNERS).read().splitlines() if l.strip() and not l.startswith("#")]
        say(f"{SIGNERS} exists:")
        for l in lines:
            say("  " + fingerprint(" ".join(l.split()[-2:])))
        line = f'jeb-release namespaces="git,jeb-release" {key}'
        if any(key in l for l in lines):
            say("configured key is in it")
        else:
            say("configured key is NOT in it (a release signed with it will not verify). Add this line, keeping the others:\n  " + line)
        return 0
    line = f'jeb-release namespaces="git,jeb-release" {key}'
    say(f"{'would write' if dry else 'writing'} {SIGNERS}:\n  {line}\n  {fingerprint(key)}")
    if not dry:
        fd = os.open(SIGNERS, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        with os.fdopen(fd, "w") as f:
            f.write(line + "\n")
        os.chmod(SIGNERS, 0o644)
    say("Commit and push desktop/release-signers before the first release; installs pin it on first install and adopt it from newer signed releases.")
    return 0


def no_private_keys():
    """Refuse when any tracked file holds a private key (release-signers is public keys only)."""
    hits = git("grep", "-l", "-I", "-E", "-e", "-----BEGIN [A-Z ]*PRIVATE KEY-----").stdout.split()
    if hits:
        fail("a tracked file holds a private key; remove it from git before releasing: " + ", ".join(hits))


def unlock_key():
    """Ask for the signing key's passphrase now, before the checks and builds: a private ssh-agent for this run holds the
    key, and git (the tag) and ssh-keygen -Y sign (the manifest) sign through it. The key expires after 4 hours in case the
    agent outlives a killed run. Returns the agent's pid."""
    key = signing_key()
    r = subprocess.run(["ssh-agent", "-s"], capture_output=True, text=True)
    env = dict(re.findall(r"(SSH_AUTH_SOCK|SSH_AGENT_PID)=([^;]+);", r.stdout))
    if r.returncode != 0 or len(env) != 2:
        fail("could not start ssh-agent to hold the signing key")
    os.environ.update(env)
    say(f"unlocking the signing key {key}")
    if subprocess.run(["ssh-add", "-t", "4h", key]).returncode != 0:
        os.kill(int(env["SSH_AGENT_PID"]), signal.SIGTERM)
        fail("the signing key was not unlocked; nothing was done")
    return int(env["SSH_AGENT_PID"])


def check_notices(root=CLONE):
    """Fail unless THIRD-PARTY-NOTICES.md names the pinned python-build-standalone tag and CPython version (the bundles ship that Python)."""
    path = os.path.join(root, "THIRD-PARTY-NOTICES.md")
    want = f"python-build-standalone: {PBS_TAG} (CPython {PBS_PY.split('+')[0]})"
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except OSError:
        lines = None
    if lines is None or want not in (l.strip() for l in lines):
        fail(f"THIRD-PARTY-NOTICES.md is missing or does not carry the line '{want}'; regenerate the notices from the new python-build-standalone release's full archive (python/PYTHON.json and python/licenses/) and update that line")


def release(dry, bump):
    no_private_keys()
    check_notices()
    agent = None if dry else unlock_key()
    try:
        return release_run(dry, bump)
    finally:
        if agent:
            os.kill(agent, signal.SIGTERM)


def release_run(dry, bump):
    cmd = ["/usr/bin/python3", "-I", os.path.join(CODE, "jebctl"), "release", "--parity", "--bump", bump] + (["--dry-run"] if dry else [])
    # jebctl gets the Ctrl-C and says how far it got; this side just waits for it
    old = signal.signal(signal.SIGINT, lambda *a: None)
    try:
        rc = subprocess.run(cmd, env=dict(os.environ, JEB_RELEASE_WRAPPED="1")).returncode
    finally:
        signal.signal(signal.SIGINT, old)
    if rc != 0 or dry:
        return rc
    tags = git("tag", "--list", "v*", "--points-at", "HEAD").stdout.split()
    if not tags:
        fail("no release tag at HEAD after the release; nothing to push")
    tag, base = max(tags, key=lambda t: [int(x) if x.isdigit() else -1 for x in t[1:].split(".")]), git("branch", "--show-current").stdout.strip()
    notes = os.path.join(CLONE, git("rev-parse", "--git-path", f"jeb-release-notes-{tag}.md").stdout.strip())
    zp = os.path.join(CLONE, git("rev-parse", "--git-path", f"jeb-release-{tag}").stdout.strip(), f"JebDesktop-{tag}-macos.zip")
    if not os.path.isfile(zp):
        fail(f"the app zip {zp} is missing, so no release is published (installs never compile); remove the local tag and run ./release again")
    adir = os.path.dirname(zp)
    try:
        extra = make_bundles(tag, "HEAD", os.path.join(adir, "stage"), os.path.join(adir, "bundles"), signing_key())
    except SystemExit as e:
        fail(f"{e}\nthe signed tag {tag} exists locally but nothing was pushed or published; remove it (git tag -d {tag}) and run ./release again, or fix the problem and run ./release bundle --tag {tag} --out <dir>")
    publish = ["gh", "release", "create", tag, "--verify-tag", "--title", tag] + (["--notes-file", notes] if os.path.isfile(notes) else ["--generate-notes"]) + [zp] + extra
    push = f"git push origin {base} {tag}\n  " + " ".join(publish)
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        say("no terminal; not pushing. To publish, run:\n  " + push)
        return 0
    if input(f"Push {base} and {tag} to origin and publish the GitHub release? [y/N] ").strip().lower() != "y":
        say("not pushed. To publish, run:\n  " + push)
        return 0
    rc = subprocess.run(["git", "-C", CLONE, "push", "origin", base, tag]).returncode
    if rc != 0:
        return rc
    if not shutil.which("gh"):
        say("pushed, but gh is not installed. To publish the GitHub release, run:\n  " + " ".join(publish))
        return 1
    rc = subprocess.run(publish, cwd=CLONE).returncode
    if rc != 0:
        say("pushed, but the GitHub release was not created. Installs still follow the tag. To retry, run:\n  " + " ".join(publish))
    return rc


# ---- bundles: Jeb-<tag>-macos-<arch>.zip (the tree, the prebuilt app, a pruned Python) and the signed manifest ----

# THIRD-PARTY-NOTICES.md reproduces this build's licences: regenerate it from the new release's full archive whenever the tag or CPython version
# changes (check_notices fails the release until its python-build-standalone line matches).
# python-build-standalone, pinned: a release at least two weeks old, install_only_stripped, CPython 3.12. Bump the tag, the filenames
# and the hashes together (the hashes come from the release's SHA256SUMS).
PBS_TAG = "20261013"
PBS_PY = "3.12.15+" + PBS_TAG
PBS = {
    "arm64": ("cpython-3.12.15+20261013-aarch64-apple-darwin-install_only_stripped.tar.gz",
              "9866e11cf2ae9caa1e671383786f248859a52dd8bfb702fb4c0dc2c65f1d36de"),
    "x86_64": ("cpython-3.12.15+20261013-x86_64-apple-darwin-install_only_stripped.tar.gz",
               "d09998f85752b646873a8a6bc7eea442a0d251b1c8d2413aa8ea06ef131c3335"),
}
PBS_CACHE = os.path.expanduser("~/Library/Caches/jeb-release")
TREE = ("install", "uninstall", "LICENSE", "THIRD-PARTY-NOTICES.md", "desktop", "mod", ".claude-plugin", ".claude/skills")       # what a bundle copies from the repo, beside app/ and python/ (the skills: the doctor guide the README points at; .claude-plugin: the marketplace Claude Code installs the mod from)
PRUNE = ("lib/python3.*/test", "lib/python3.*/idlelib", "lib/python3.*/tkinter", "lib/python3.*/turtledemo", "lib/python3.*/ensurepip",
         "lib/python3.*/site-packages/pip*", "lib/python3.*/lib-dynload/_tkinter*", "lib/tcl*", "lib/tk*", "lib/itcl*", "lib/thread*",
         "include", "share", "lib/pkgconfig", "lib/libtcl*", "lib/libtk*")


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def rosetta():
    return subprocess.run(["/usr/bin/arch", "-x86_64", "/usr/bin/true"], capture_output=True).returncode == 0


def local_imports():
    """Top-level module names that jebctl, updater, watchdog, parity, day, jebhome and plugdirs import, minus Jeb's own modules."""
    import ast
    files = [os.path.join(CODE, n) for n in ("jebctl", "updater.py", "watchdog.py", "jebhome.py", "plugdirs.py")] + \
            [os.path.join(CODE, "src", "tools", n) for n in ("parity.py", "day.py")]
    own = {os.path.splitext(n)[0] for d in (CODE, os.path.join(CODE, "src", "tools")) for n in os.listdir(d)}
    names = set()
    for f in files:
        for node in ast.walk(ast.parse(open(f).read())):
            if isinstance(node, ast.Import):
                names.update(a.name.split(".")[0] for a in node.names)
            elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
                names.add(node.module.split(".")[0])
    return sorted(names - own)


def fetch_python(arch, dest):
    """Unpack the pinned, pruned python-build-standalone for arch into dest/python (cached in ~/Library/Caches/jeb-release). Checks the
    download's SHA-256, never modifies a Mach-O (so upstream signatures stay valid), verifies every Mach-O's
    signature (an unsigned x86_64 one is noted, not refused) and imports every stdlib module Jeb's scripts use. Returns a warning string when the import test could not run, else None."""
    import tarfile
    import fnmatch
    name, want = PBS[arch]
    os.makedirs(PBS_CACHE, exist_ok=True)
    tgz = os.path.join(PBS_CACHE, name)
    if not (os.path.isfile(tgz) and sha256_of(tgz) == want):
        url = f"https://github.com/astral-sh/python-build-standalone/releases/download/{PBS_TAG}/" + name.replace("+", "%2B")
        say(f"  downloading {name}")
        if subprocess.run(["curl", "-fsSL", "--retry", "3", "-o", tgz + ".part", url]).returncode != 0:
            fail(f"could not download {url}")
        os.replace(tgz + ".part", tgz)
    if sha256_of(tgz) != want:
        os.unlink(tgz)
        fail(f"{name} does not match the pinned SHA-256; discarded")
    with tarfile.open(tgz) as t:
        if hasattr(tarfile, "data_filter"):
            t.extractall(dest, filter="data")
        else:
            for m in t.getmembers():       # no data filter before 3.9.17: refuse anything that leaves dest
                if m.name.startswith("/") or ".." in m.name.split("/") or (m.issym() and (m.linkname.startswith("/") or ".." in m.linkname.split("/"))):
                    fail(f"{name} holds an unsafe path: {m.name}")
            t.extractall(dest)
    py = os.path.join(dest, "python")
    if not os.path.isfile(os.path.join(py, "bin", "python3")):
        fail(f"{name} has no python/bin/python3")
    for pat in PRUNE:
        for p in glob.glob(os.path.join(py, pat)):
            shutil.rmtree(p) if os.path.isdir(p) and not os.path.islink(p) else os.unlink(p)
    sys.path.insert(0, CODE)
    import jebhome
    bad, unsigned = [], 0
    for dirpath, dirs, names in os.walk(py):
        for n in names:
            p = os.path.join(dirpath, n)
            if os.path.islink(p) or not os.path.isfile(p):
                continue
            if not jebhome.macho_archs(p):
                continue
            r = subprocess.run(["codesign", "--verify", p], capture_output=True, text=True)
            if r.returncode == 0:
                continue
            if arch == "x86_64" and "not signed at all" in r.stderr:
                unsigned += 1       # python-build-standalone does not sign its Intel builds; Intel and Rosetta run unsigned code
            else:
                bad.append(os.path.relpath(p, py))
    if bad:
        fail(f"{arch} Python: codesign --verify failed for {', '.join(bad[:5])}{' ...' if len(bad) > 5 else ''}")
    if unsigned:
        say(f"  note: {unsigned} x86_64 Mach-O files are unsigned upstream (none has an invalid signature)")
    if arch == "x86_64" and not rosetta():
        return "Rosetta is missing: the x86_64 Python was not import-tested"
    pre = ["/usr/bin/arch", "-x86_64"] if arch == "x86_64" else []
    mods = local_imports()
    r = subprocess.run(pre + [os.path.join(py, "bin", "python3"), "-I", "-c", "import importlib\nfor m in %r: importlib.import_module(m)" % mods], capture_output=True, text=True)
    if r.returncode != 0:
        fail(f"{arch} Python cannot import what Jeb needs ({', '.join(mods)}): {(r.stderr.strip().splitlines() or ['?'])[-1]}")
    return None


def put_tree(ref, dest, from_tree):
    """The repo files a bundle carries, at dest: `git archive ref ...` (a release), or the working tree's tracked and unignored files."""
    os.makedirs(dest)
    if from_tree:
        files = git("ls-files", "-co", "--exclude-standard", "--", *TREE).stdout.split("\n")
        for f in sorted(x for x in files if x and os.path.isfile(os.path.join(CLONE, x))):
            os.makedirs(os.path.join(dest, os.path.dirname(f)), exist_ok=True)
            shutil.copy2(os.path.join(CLONE, f), os.path.join(dest, f), follow_symlinks=False)
        return
    p = subprocess.run(["git", "-C", CLONE, "archive", ref, "--"] + list(TREE), stdout=subprocess.PIPE)
    if p.returncode != 0:
        fail(f"git archive {ref} failed")
    if subprocess.run(["tar", "-x", "-C", dest], input=p.stdout).returncode != 0:
        fail("could not unpack the git archive")


def verify_manifest(manifest, sig, signers):
    """True when sig signs manifest for `jeb-release` by a key in signers."""
    r = subprocess.run(["ssh-keygen", "-Y", "find-principals", "-s", sig, "-f", signers], capture_output=True, text=True)
    for who in r.stdout.split():
        with open(manifest, "rb") as f:
            if subprocess.run(["ssh-keygen", "-Y", "verify", "-f", signers, "-I", who, "-n", "jeb-release", "-s", sig], stdin=f, capture_output=True).returncode == 0:
                return True
    return False


def make_bundles(tag, ref, app_dir, out, key, signers=None, from_tree=False):
    """Build Jeb-<tag>-macos-{arm64,x86_64}.zip plus the signed manifest and jebctl-macos in out; returns the paths to upload (manifest, signature, zips, jebctl).
    app_dir holds JebDesktop, detect, png2raw and the universal jebctl, which each bundle carries as desktop/bin/jebctl.
    signers overrides the bundle's desktop/release-signers (tests: a throwaway key). Self-verifies the signature against the bundle's
    own release-signers, the file an install pins."""
    version = tag.lstrip("v")
    commit = git("rev-parse", ref if not from_tree else "HEAD").stdout.strip() or "0" * 40
    os.makedirs(out, exist_ok=True)
    work = tempfile.mkdtemp(prefix="jeb-bundle-")
    bundles, warns = {}, []
    try:
        for arch in ("arm64", "x86_64"):
            say(f"bundle {arch}:")
            root = os.path.join(work, arch)
            put_tree(ref, root, from_tree)
            if signers:
                shutil.copyfile(signers, os.path.join(root, "desktop", "release-signers"))
            shutil.copytree(app_dir, os.path.join(root, "app"), symlinks=True)
            if not os.path.isfile(os.path.join(root, "app", "jebctl")):
                fail(f"the app folder {app_dir} has no jebctl (the native build from desktop/cli); no bundle")
            os.replace(os.path.join(root, "app", "jebctl"), os.path.join(root, "desktop", "bin", "jebctl"))     # replaces the sh launcher; the git tree keeps it for clones
            w = fetch_python(arch, root)
            if w:
                warns.append(w)
            with open(os.path.join(root, "bundle.json"), "w") as f:
                json.dump({"schema": 1, "repo": REPO, "tag": tag, "version": version, "commit": commit, "arch": arch, "python": PBS_PY}, f, indent=2)
                f.write("\n")
            for need in ("install", "desktop/jebctl", "desktop/bin/jebctl", "desktop/updater.py", "mod", ".claude-plugin/marketplace.json", "app/JebDesktop", "app/detect", "app/png2raw"):
                if not os.path.exists(os.path.join(root, need)):
                    fail(f"the {arch} bundle lacks {need}")
            name = f"Jeb-{tag}-macos-{arch}.zip"
            zp = os.path.join(out, name)
            if os.path.exists(zp):
                os.unlink(zp)
            if subprocess.run(["ditto", "-c", "-k", "--norsrc", "--noextattr", root, zp]).returncode != 0:
                fail(f"ditto could not make {name}")
            bundles[arch] = {"name": name, "sha256": sha256_of(zp), "size": os.path.getsize(zp)}
            say(f"  {name}: {bundles[arch]['size'] // 1024 // 1024} MB, sha256 {bundles[arch]['sha256'][:16]}")
        ctl = os.path.join(out, "jebctl-macos")
        shutil.copyfile(os.path.join(app_dir, "jebctl"), ctl)
        os.chmod(ctl, 0o755)
        if subprocess.run(["codesign", "--verify", ctl], capture_output=True).returncode != 0:
            fail("the staged jebctl fails codesign --verify")
        jebctl = {"name": "jebctl-macos", "sha256": sha256_of(ctl), "size": os.path.getsize(ctl)}
        say(f"  jebctl-macos: {jebctl['size'] // 1024} KB, sha256 {jebctl['sha256'][:16]}")
        man = os.path.join(out, f"Jeb-{tag}-manifest.json")
        with open(man, "w") as f:
            json.dump({"schema": 1, "repo": REPO, "tag": tag, "version": version, "commit": commit,
                       "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "python": PBS_PY, "bundles": bundles, "jebctl": jebctl}, f, indent=2)
            f.write("\n")
        sig = man + ".sig"
        if os.path.exists(sig):
            os.unlink(sig)
        if subprocess.run(["ssh-keygen", "-Y", "sign", "-f", key, "-n", "jeb-release", man]).returncode != 0:
            fail("ssh-keygen could not sign the manifest")
        pinned = os.path.join(work, "arm64", "desktop", "release-signers")
        if not verify_manifest(man, sig, pinned):
            fail("the manifest signature does not verify against the bundle's own desktop/release-signers (namespace jeb-release); "
                 "is the signing key listed there with namespaces including jeb-release? (./release setup shows it)")
        say(f"manifest signed and verified against the bundle's release-signers: {man}")
    finally:
        shutil.rmtree(work, ignore_errors=True)
    for w in warns:
        say("warning: " + w)
    return [man, sig] + [os.path.join(out, b["name"]) for b in bundles.values()] + [ctl]


def signing_key():
    """The private key git signs tags with (ssh-keygen -Y sign needs the private file, not the .pub)."""
    k = os.path.expanduser(cfg("user.signingkey"))
    if not k or k.startswith("key::"):
        fail("user.signingkey must name a private key file to sign the manifest; run ./release setup")
    return k[:-4] if k.endswith(".pub") and os.path.exists(k[:-4]) else k


def bundle_cmd(argv):
    """./release bundle --tag vX.Y.Z --out DIR [--ref REF] [--from-tree] [--app DIR] [--key K] [--signers F]"""
    opts, i, from_tree = {}, 0, False
    while i < len(argv):
        a = argv[i]
        if a == "--from-tree":
            from_tree = True
            i += 1
        elif a in ("--tag", "--out", "--ref", "--app", "--key", "--signers") and i + 1 < len(argv):
            opts[a[2:]] = argv[i + 1]
            i += 2
        else:
            say(__doc__); return 2
    if "tag" not in opts or "out" not in opts or not re.fullmatch(r"v\d+\.\d+\.\d+", opts["tag"]):
        say(__doc__); return 2
    app = opts.get("app") or os.path.join(CLONE, git("rev-parse", "--git-path", f"jeb-release-{opts['tag']}").stdout.strip(), "stage")
    if not os.path.isdir(app):
        fail(f"{app} is not a folder (the app folder holds JebDesktop, detect, png2raw and jebctl)")
    paths = make_bundles(opts["tag"], opts.get("ref", "HEAD"), app, opts["out"], opts.get("key") or signing_key(), opts.get("signers"), from_tree)
    say("made:\n" + "\n".join("  " + p for p in paths))
    return 0


# ---- smoke ----
SMOKE_TAG_RE = re.compile(r"v(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)")     # installs only follow SemVer releases
SMOKE_MIN = (1, 5, 0)      # the first release whose jebctl-macos installs without gh
JEBCTL = os.path.join(CODE, "jebctl")


def host_arch():
    r = subprocess.run(["/usr/sbin/sysctl", "-n", "hw.optional.arm64"], capture_output=True, text=True)
    return "arm64" if r.stdout.strip() == "1" else "x86_64"


def smoke_base():
    """Where releases are read: $JEB_RELEASE_BASE, else github.com/<origin's repo>/releases."""
    sys.path.insert(0, CODE)
    import jebhome
    m = re.search(r"github\.com[:/]([^/\s]+/[^/\s]+?)(?:\.git)?/?$", git("remote", "get-url", "origin").stdout.strip())
    return jebhome.release_base(m.group(1) if m else REPO)


def smoke_env(home, extra=None):
    """Every child's environment: the owner's PATH but a fake HOME, no JEB_* from outside (but JEB_RELEASE_BASE) and no launchctl."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("JEB_") and k != "CLAUDE_CODE_PLUGIN_DIRS"}
    env.update(HOME=home, CLAUDE_CONFIG_DIR=os.path.join(home, ".claude"), JEB_APP_DIR=os.path.join(home, "Applications"), JEB_LAUNCHAGENTS=os.path.join(home, "Library", "LaunchAgents"),
               JEB_SETTINGS=os.path.join(home, ".claude", "settings.json"), JEB_BACKUPS=os.path.join(home, ".claude", "backups", "jeb"),
               JEB_STORE_DIR=os.path.join(home, ".claude", "plugins", "store"), JEB_BIN_DIR=os.path.join(home, ".local", "bin"),
               JEB_PROFILE=os.path.join(home, ".zprofile"), JEB_NO_LAUNCHCTL="1")
    if os.environ.get("JEB_RELEASE_BASE"):
        env["JEB_RELEASE_BASE"] = os.environ["JEB_RELEASE_BASE"]
    env.update(extra or {})
    return env


def newest_tag(base):
    import jebhome
    try:
        return jebhome.latest_tag(base)
    except jebhome.FetchError as e:
        fail(f"could not read the newest release of {base}: {e}")


def smoke_jebctl(dl, tag, base, want):
    """Download the release's jebctl-macos: its SHA-256 and size equal the signed manifest's. Returns (path, why)."""
    import jebhome
    p = os.path.join(dl, "jebctl-macos")
    try:
        jebhome.fetch(f"{base}/download/{tag}/jebctl-macos", p, limit=want["size"] if isinstance(want.get("size"), int) else 0)
    except jebhome.FetchError as e:
        return None, f"jebctl-macos download failed: {e}"
    if want.get("sha256") != sha256_of(p) or want.get("size") != os.path.getsize(p):
        return None, "jebctl-macos does not match the signed manifest"
    os.chmod(p, 0o755)
    return p, ""


def smoke_case(sandbox, home, tag, base, pinned):
    """Download the release the way a new user's Claude does (its jebctl-macos, checked against the signed manifest), run that
    `install --no-agents`, check. pinned: the tag was named, so the binary is told it (else it finds the newest itself). Returns (ok, text)."""
    import jebhome
    t0 = time.time()
    arch = host_arch()
    state = os.path.join(home, "Library", "Application Support", "Jeb")
    env = smoke_env(home, {"JEB_RELEASE_TAG": tag} if pinned else {})
    def bad(why):
        return False, f"FAIL: {why}"
    os.makedirs(os.path.join(home, "Library"))
    dl = os.path.join(sandbox, "download")
    os.makedirs(dl)
    man = f"Jeb-{tag}-manifest.json"
    try:
        for n in (man, man + ".sig"):
            jebhome.fetch(f"{base}/download/{tag}/{n}", os.path.join(dl, n), limit=64 << 10)
    except jebhome.FetchError as e:
        return bad(f"download failed: {e}")
    if not verify_manifest(os.path.join(dl, man), os.path.join(dl, man + ".sig"), SIGNERS):
        return bad("the manifest signature does not verify against desktop/release-signers (jeb-release)")
    doc = json.load(open(os.path.join(dl, man)))
    if doc.get("tag") != tag or not isinstance(doc.get("jebctl"), dict):
        return bad("the signed manifest names another tag or lists no jebctl")
    ctl, why = smoke_jebctl(dl, tag, base, doc["jebctl"])
    if not ctl:
        return bad(why)
    v = subprocess.run([ctl, "--version"], env=env, capture_output=True, text=True, timeout=30)
    if v.returncode != 0 or tag not in v.stdout:
        return bad(f"jebctl-macos --version said {v.stdout.strip()!r}, not {tag}")
    ver = os.path.join(home, ".jeb", "versions", tag)
    r = subprocess.run([ctl, "install", "--no-agents"], env=env, cwd=sandbox, capture_output=True, text=True, timeout=1800)
    out = (r.stdout + r.stderr).strip()
    open(os.path.join(sandbox, "install.log"), "w").write(out + "\n")
    if r.returncode != 0:
        return bad("install exit %d: %s" % (r.returncode, " | ".join(out.splitlines()[-3:])[:400]))
    app = os.path.join(home, "Applications", "JebDesktop.app")
    if not os.path.isdir(app):
        return bad(f"{app} was not installed")
    if subprocess.run(["codesign", "--verify", app], capture_output=True).returncode != 0:
        return bad("codesign --verify failed on the installed app")
    cur = os.path.join(home, ".jeb", "current")
    if not os.path.islink(cur) or os.path.realpath(cur) != os.path.realpath(ver):
        return bad(f"{cur} does not point at {ver}")
    try:
        jm = plistlib.load(open(os.path.join(app, "Contents", "Info.plist"), "rb")).get("JebMod")
    except (OSError, ValueError):
        jm = None
    if jm != os.path.join(cur, "mod"):
        return bad(f"Info.plist JebMod is {jm!r}, not {os.path.join(cur, 'mod')}")
    try:
        ulog = open(os.path.join(state, "update.log")).read()
    except OSError:
        return bad(f"no update.log in {state}")
    if "using the prebuilt binary" not in ulog:
        return bad("the app was not the release's prebuilt one")
    try:
        settings = json.load(open(os.path.join(home, ".claude", "settings.json")))
    except (OSError, ValueError):
        settings = {}
    if any(os.sep + ".jeb" + os.sep in e for e in (settings.get("env", {}).get("CLAUDE_CODE_PLUGIN_DIRS") or "").split(os.pathsep)):
        return bad("settings.json still lists a ~/.jeb entry in CLAUDE_CODE_PLUGIN_DIRS")
    try:
        listed = json.loads(subprocess.run(["claude", "plugin", "list", "--json"], env=env, capture_output=True, text=True, timeout=120).stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        listed = []
    plug = next((p for p in listed if isinstance(p, dict) and p.get("id") == "jeb@jeb"), None)
    if not plug or not os.path.realpath(plug.get("installPath", "")).startswith(os.path.realpath(home)):
        return bad("`claude plugin list` does not show jeb@jeb installed under the sandbox")
    left = [n for n in os.listdir(os.path.dirname(ver))]
    if left != [tag]:
        return bad("versions/ holds " + ", ".join(left))
    return True, f"ok (prebuilt {tag}, {arch}, {time.time() - t0:.0f}s)"


def smoke(tag, dry):
    base = smoke_base()
    pinned = bool(tag)
    if not tag:
        tag = "<newest published>" if dry else newest_tag(base)
    elif not SMOKE_TAG_RE.fullmatch(tag):
        fail(f"{tag} is not a release tag (vX.Y.Z)")
    if SMOKE_TAG_RE.fullmatch(tag) and tuple(int(x) for x in tag[1:].split(".")) < SMOKE_MIN:
        fail(f"{tag} is older than v{'.'.join(map(str, SMOKE_MIN))}: their jebctl-macos installs with gh")
    root = os.path.join(CLONE, git("rev-parse", "--git-path", "jeb-smoke").stdout.strip())
    sandbox = os.path.join(root, tag)
    say(f"smoke {tag} from {base}\n  sandbox {sandbox} (fake HOME inside; an earlier one is moved to {os.path.join(root, 'old-<time>')})\n"
        f"  HTTPS download of the manifest, signature and jebctl-macos, verify, then jebctl-macos install --no-agents (it downloads this Mac's zip,\n"
        f"  unpacks into <home>/.jeb/versions/<tag> and runs the bundle's own install); then jebctl follow --dry-run and jebctl doctor (JEB_NO_LAUNCHCTL=1)")
    if dry:
        say("dry run: nothing was created.")
        return 0
    os.makedirs(root, exist_ok=True)
    if os.path.lexists(sandbox):
        aside = os.path.join(root, f"old-{time.strftime('%Y%m%d-%H%M%S')}-{tag}")
        os.rename(sandbox, aside)
        say(f"  moved the previous sandbox to {aside}")
    os.makedirs(sandbox)
    home = os.path.join(sandbox, "home")
    try:
        ok, text = smoke_case(sandbox, home, tag, base, pinned)
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        ok, text = False, f"FAIL: {type(e).__name__}: {e}"
    say(f"smoke fresh install: {text}")
    results = [ok]
    if ok:
        py = os.path.join(home, ".jeb", "current", "python", "bin", "python3")
        ctl = [py, "-I", os.path.join(home, ".jeb", "current", "desktop", "jebctl")]
        r = subprocess.run(ctl + ["follow", "--no-agents", "--dry-run"], env=smoke_env(home), cwd=sandbox, capture_output=True, text=True, timeout=300)
        text = (r.stdout + r.stderr).strip()
        say("smoke follow --dry-run: " + (text.splitlines() or ["(no output)"])[-1][:200])
        if r.returncode != 0 or "could not reach" in text or not re.search(r"is current|would download", text):
            say("smoke follow --dry-run: FAIL"); results.append(False)
        r = subprocess.run(ctl + ["doctor"], env=smoke_env(home), cwd=sandbox, capture_output=True, text=True, timeout=300)
        lines = (r.stdout + r.stderr).strip().splitlines()
        say("smoke doctor (agents are not loaded in a sandbox; those FIX lines are expected):\n" + "\n".join("  " + l for l in lines))
        crit = [l for l in lines if l.startswith("FIX") and re.search(r"app bundle|mod folder|signers|state folder|bundle|Python|version", l)]
        if crit:
            say("smoke doctor: FAIL: " + "; ".join(c[:120] for c in crit)); results.append(False)
    say(f"sandbox: {sandbox}\n" + ("smoke passed" if all(results) else "smoke FAILED"))
    return 0 if all(results) else 1


def main(argv):
    dry = "--dry-run" in argv
    rest = [a for a in argv if a != "--dry-run"]
    if rest[:1] == ["bundle"]:
        return bundle_cmd(rest[1:])
    if rest[:1] == ["smoke"] and len(rest) <= 2:
        return smoke(rest[1] if len(rest) == 2 else None, dry)
    if rest not in ([], ["setup"], ["patch"], ["minor"], ["major"]):
        say(__doc__); return 2
    return setup(dry) if rest == ["setup"] else release(dry, rest[0] if rest else "auto")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print()
        sys.exit("release: stopped")
