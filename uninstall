#!/usr/bin/python3
"""./uninstall [--purge] [--purge-farm] [--remove-files] [--dry-run] [--verbose]: remove Jeb's install (the files stay unless --remove-files).

  jebctl uninstall: stops and removes the LaunchAgents (including the release agent) and the app. --purge also
                    deletes everything in the desktop's folder (JEB_HOME: versions, logs, state; passed through).
  jebctl link:      ~/.local/bin/jebctl is removed when it points at this clone, and the two PATH lines `./install` added to
                    the shell profile (backup first).
  settings.json:    this install's mod/ entry (and an old clone's, in a bundle) is removed from CLAUDE_CODE_PLUGIN_DIRS (backup first).
  --purge-farm      also removes the farm file(s) ~/.claude/plugins/store/jeb_inline-*.json, after a backup.
                    Default: the farm is kept.
  --remove-files    last step (--remove-clone is the old name): deletes ~/.jeb entirely (the installed bundle, its Python, the
                    tools folder with gh), and an old git clone of Jeb when release-state names one and it has no local changes.
                    A git clone layout deletes only the standard clone ~/.jeb/repo (any other location is refused) and ~/.jeb/bin.
                    Default: the files stay.
  --verbose         every command and detail; by default one short line per step.
Env overrides (tests): JEB_HOME, JEB_APP_DIR, JEB_LAUNCHAGENTS, JEB_SETTINGS, JEB_BACKUPS, JEB_STORE_DIR, JEB_BIN_DIR, JEB_PROFILE, JEB_TOOLS_DIR, JEB_NO_LAUNCHCTL.
"""
import glob, json, os, shutil, subprocess, sys, time

CLONE = os.path.dirname(os.path.realpath(__file__))
BUNDLED = os.path.isfile(os.path.join(CLONE, "bundle.json"))        # unpacked release bundle, not a git clone
MOD = os.path.join(CLONE, "mod")
sys.path.insert(0, os.path.join(CLONE, "desktop"))
import jebhome, plugdirs

jebhome.pin_python()
if BUNDLED:
    MOD = os.path.join(jebhome.current_dir(), "mod")       # settings.json only ever names the stable path


def say(*a):
    print(*a, flush=True)


def main(argv):
    dry = "--dry-run" in argv
    purge = "--purge" in argv
    farm = "--purge-farm" in argv
    rmclone = "--remove-clone" in argv or "--remove-files" in argv
    verbose = "--verbose" in argv
    if [a for a in argv if a not in ("--dry-run", "--purge", "--purge-farm", "--remove-clone", "--remove-files", "--verbose")]:
        say(__doc__); return 2
    say(f"Jeb uninstall{' (dry run)' if dry else ''} from {CLONE}" if verbose else f"Uninstalling Jeb{' (dry run)' if dry else ''}")
    cmd = [sys.executable, "-I", os.path.join(CLONE, "desktop", "jebctl"), "uninstall"] + (["--purge"] if purge else []) + (["--dry-run"] if dry else []) + (["--verbose"] if verbose else [])
    if verbose:
        say("$ " + " ".join(cmd))
    rc = subprocess.run(cmd).returncode
    if rc != 0:
        say(f"the desktop part failed (exit {rc}); settings.json and the farm were left alone")
        return rc
    legacy = legacy_state()
    act = plugdirs.edit(MOD, True, dry, say if verbose else lambda *a: None)
    for old in (legacy.get("legacy_clone"), legacy.get("legacy_mod")):
        if BUNDLED and old:
            plugdirs.edit(old if old.endswith("/mod") else os.path.join(old, "mod"), True, dry, say if verbose else lambda *a: None)
    if not verbose:
        say("  plugin setting ... " + ("not set" if act == "absent" else "would remove" if dry else "removed"))
    store = os.environ.get("JEB_STORE_DIR") or os.path.expanduser("~/.claude/plugins/store")
    files = sorted(glob.glob(os.path.join(store, "jeb_inline-*.json")))
    if farm:
        for f in files:
            if verbose:
                say(f"farm {f}: back up, then remove")
            if not dry:
                os.makedirs(plugdirs.backup_dir(), mode=0o700, exist_ok=True)
                dest = os.path.join(plugdirs.backup_dir(), os.path.basename(f)[:-5] + "." + time.strftime("%Y%m%d-%H%M%S") + ".json")
                shutil.copy2(f, dest)
                if verbose:
                    say("  backup: " + dest)
                os.unlink(f)
        if not files:
            say("no farm file found" if verbose else "  farm ... none found")
        elif not verbose:
            say("  farm ... " + ("would remove (backup first)" if dry else "removed (backed up first)"))
    elif verbose:
        say(f"farm kept ({len(files)} file(s) in {store}); --purge-farm removes it")
    else:
        say(f"  farm ... kept ({len(files)} file(s)); --purge-farm removes it")
    if rmclone:
        remove_clone(dry, verbose, legacy)
    else:
        say(f"the files at {CLONE} were not removed")
    return rc


def legacy_state():
    """release-state.json, read before the desktop part runs (--purge deletes it)."""
    try:
        return json.load(open(os.path.join(jebhome.resolve(), "release-state.json")))
    except (OSError, ValueError):
        return {}


def clean_git_clone(path):
    """True when path is a git clone with no local changes (so deleting it loses nothing)."""
    r = subprocess.run(["git", "-C", path, "status", "--porcelain"], capture_output=True, text=True)
    return os.path.isdir(os.path.join(path, ".git")) and r.returncode == 0 and not r.stdout.strip()


def remove_clone(dry, verbose, legacy=None):
    """Last step. Bundle layout: ~/.jeb goes entirely (this script lives in it, but Python has read it all by now), plus an old git
    clone from release-state when it is clean. Clone layout: the standard clone ~/.jeb/repo and ~/.jeb/bin, then ~/.jeb if empty."""
    jd = jebhome.jeb_dir()
    if BUNDLED:
        old = (legacy or {}).get("legacy_clone")
        if old and os.path.isdir(old):
            if os.path.realpath(old) == os.path.realpath(jd) or os.path.islink(old):
                pass
            elif clean_git_clone(old):
                say("  old clone ... " + ("would remove " if dry else "removed ") + old)
                if not dry:
                    shutil.rmtree(old, ignore_errors=True)
            else:
                say(f"  old clone ... kept: {old} has local changes or is not a git clone")
        say("  files ... " + ("would remove " if dry else "removed ") + jd)
        if not dry:
            shutil.rmtree(jd, ignore_errors=True)
        return
    std = os.path.join(jd, "repo")
    if os.path.islink(CLONE) or not (os.path.exists(std) and os.path.samefile(CLONE, std)):
        say(f"  clone ... not removed: {CLONE} is not the standard place {std}")
    else:
        say("  clone ... " + ("would remove " if dry else "removed ") + CLONE)
        if not dry:
            shutil.rmtree(CLONE, ignore_errors=True)
    tools = jebhome.tools_dir()
    if os.path.isdir(tools):
        say("  tools ... " + ("would remove " if dry else "removed ") + tools)
        if not dry:
            shutil.rmtree(tools, ignore_errors=True)
    if not dry:
        try:
            os.rmdir(jd)
        except OSError:
            pass


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
