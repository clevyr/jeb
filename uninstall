#!/bin/sh
# The repo-root uninstall (v1.7.0 onwards). In a release bundle it runs the bundle's own jebctl; in a source checkout there is
# no jebctl to run.
here=$(dirname "$0")
if [ -x "$here/desktop/bin/jebctl" ]; then
  exec "$here/desktop/bin/jebctl" uninstall "$@"
fi
echo "uninstall: this is a source checkout, not a release bundle; run ~/.jeb/bin/jebctl uninstall to remove an installed Jeb" >&2
exit 1
